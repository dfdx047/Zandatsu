<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher: a cor vem toda do Compose; o tema so cuida da janela. -->
    <style name="Theme.SwordMan" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/df_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/df_orange</item>
        <item name="colorAccent">@color/df_yellow</item>
    </style>

    <!-- Jogo e editor de controles: ecra inteiro, fundo preto. -->
    <style name="Theme.SwordMan.Game" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Editor de controles: AppCompat (idioma por app) em ecra inteiro. -->
    <style name="Theme.SwordMan.Editor" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
