# Versoes fixadas do Zandatsu (Metal Gear Rising: Revengeance, Xbox 360).

# SDK: o mesmo do Dragon Burst. Fork do ReXGlue do Burst Limit Recompiled
# (iExplosiveRage/rexglue-sdk, branch burstlimit, base ReXGlue v0.10.0), com os
# patches Android de patches/ (0000-0098: os do Dragon Burst, que ja incluem os do
# Dragon Fury refeitos sobre este SDK). Os do MGR comecam no 0100.
SDK_REPO=https://github.com/iExplosiveRage/rexglue-sdk.git
SDK_COMMIT=465f9ef502f96c3652b85daa223608920faf451a

# default.xex do disco "Metal Gear Rising - Revengeance (USA, Europe)" (Redump),
# Title ID 4B4E080A, Media ID 6CC18291, versao 0.0.0.4.
XEX_SHA1=2dffd4d46e727d4a64c331d54251c4d9a0a26edf

# Pacote Android (a pasta do jogo no aparelho e /sdcard/Android/data/<pacote>/files).
APP_ID=com.dfdx047.zandatsu
