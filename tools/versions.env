# Versoes fixadas do ProjectSwordMan (Metal Gear Rising: Revengeance, Xbox 360).
# Os patches de patches/ sao escritos contra o SDK abaixo, com o overlay de sdk/overlay.

# ReXGlue SDK oficial (rexglue/rexglue-sdk), tag v0.10.0.
SDK_REPO=https://github.com/rexglue/rexglue-sdk.git
SDK_TAG=v0.10.0
SDK_COMMIT=f5337cdc947ff6d4c4196737e2c807a48f2a1fc2

# Overlay do SDK (sdk/overlay): copia de patches/rexglue-sdk do projeto
# novapowers0/DBZ-Budokai-3-HD-Collection (licenca MIT, sdk/overlay-LICENSE),
# no commit abaixo. Os patches 0001-0048 sao os do DBZ3-Android (Dragon Fury).
OVERLAY_REPO=https://github.com/novapowers0/DBZ-Budokai-3-HD-Collection.git
OVERLAY_COMMIT=a0ceaeb15aa203a6446dbc312dfab934d2bc977a

# default.xex do disco "Metal Gear Rising - Revengeance (USA, Europe)" (Redump),
# Title ID 4B4E080A, Media ID 6CC18291, versao 0.0.0.4.
XEX_SHA1=2dffd4d46e727d4a64c331d54251c4d9a0a26edf

# Pacote Android (a pasta do jogo no aparelho e /sdcard/Android/data/<pacote>/files).
APP_ID=com.dfdx047.swordman
