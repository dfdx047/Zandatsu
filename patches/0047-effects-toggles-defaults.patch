@@ -4324,6 +4330,40 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       return true;
     }
   }
+  // DBZ3-Android: efeitos de pos-processamento do jogo que podem ser desligados (opcoes do
+  // launcher, para aparelhos fracos). Com render targets diretos o render target do ecra ja
+  // tem a cena antes de cada efeito, por isso saltar o draw do efeito deixa a imagem sem ele:
+  // - profundidade de campo: PS 4DFCBC49057E5721 (desfoque dependente da profundidade, opaco);
+  // - FXAA: PS F5F4D761A981B87D (opaco);
+  // - brilho (bloom): cadeia 320x184 -> 80x48 (PS 555EBAAEF8F61839, PS CB0605B416DF85B8 em
+  //   render targets de pitch 320) e a composicao aditiva da textura pequena no ecra (PS
+  //   6E57A6E305D5D69B com mistura nao opaca e textura de largura <= 160).
+  if (pixel_shader && REXCVAR_GET(dbz3_rt_direct) &&
+      (!REXCVAR_GET(dbz3_fx_dof) || !REXCVAR_GET(dbz3_fx_fxaa) || !REXCVAR_GET(dbz3_fx_bloom))) {
+    const uint64_t fx_ps = pixel_shader->ucode_data_hash();
+    const bool fx_opaque = (regs[XE_GPU_REG_RB_BLENDCONTROL0] & 0x1FFF1FFF) == 0x00010001;
+    bool fx_skip = false;
+    if (!REXCVAR_GET(dbz3_fx_dof) && fx_ps == UINT64_C(0x4DFCBC49057E5721) && fx_opaque) {
+      fx_skip = true;
+    } else if (!REXCVAR_GET(dbz3_fx_fxaa) && fx_ps == UINT64_C(0xF5F4D761A981B87D) && fx_opaque) {
+      fx_skip = true;
+    } else if (!REXCVAR_GET(dbz3_fx_bloom)) {
+      const uint32_t fx_pitch = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+      if (fx_ps == UINT64_C(0x555EBAAEF8F61839) ||
+          (fx_ps == UINT64_C(0xCB0605B416DF85B8) && fx_pitch == 320)) {
+        fx_skip = true;
+      } else if (fx_ps == UINT64_C(0x6E57A6E305D5D69B) && !fx_opaque &&
+                 !pixel_shader->texture_bindings().empty()) {
+        const xenos::xe_gpu_texture_fetch_t fetch =
+            regs.GetTextureFetch(pixel_shader->texture_bindings()[0].fetch_constant);
+        fx_skip = fetch.type == xenos::FetchConstantType::kTexture &&
+                  uint32_t(fetch.size_2d.width) + 1 <= 160;
+      }
+    }
+    if (fx_skip) {
+      return true;
+    }
+  }
   // DBZ3-Android (dbz3_skip_depth_restore): depois de cada passe de 512x512 (silhueta do
   // lutador, pitch 560, que no EDRAM real escreve por cima da zona da profundidade) o jogo
   // repoe a profundidade desenhando a copia dela como COR na base da profundidade
