+// ---------------------------------------------------------------------------
+// Dragon Burst: render nativo, passo 4 (dbz3_render_into_texture).
+// O pos-processamento do BL e uma cadeia de "quad de ecra inteiro -> resolve para uma
+// textura -> o quad seguinte le essa textura". O resolve custa um fim de passe e uma copia
+// de 3,7 MB (no Mali ~0,8 ms cada, ~17 por frame). Aqui aprende-se, por assinatura do quad
+// que abre o passe (shaders, alvo, scissor), para que textura o passe acaba resolvido; com 3
+// frames iguais, o passe seguinte com essa assinatura desenha direto nessa textura e o
+// resolve e saltado. Se algo nao bater (outro resolve, a textura amostrada no proprio passe,
+// outro alvo antes do resolve, o fim do frame), desiste-se e a assinatura fica banida.
+// ---------------------------------------------------------------------------
+namespace dbz3_rit {
+struct Prediction {
+  uint32_t dest = 0;
+  uint32_t endian = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t hits = 0;
+  bool banned = false;
+};
+std::unordered_map<uint64_t, Prediction> g_table;
+// Passe normal em curso (para aprender).
+uint64_t g_pass_sig = 0;
+uint32_t g_pass_base = 0;
+uint32_t g_pass_pitch = 0;
+// Passe a desenhar na textura.
+bool g_active = false;
+uint64_t g_sig = 0;
+const void* g_fb = nullptr;
+void* g_tex = nullptr;
+uint32_t g_dest = 0;
+VkImageView g_view = VK_NULL_HANDLE;
+uint32_t g_base = 0;
+uint32_t g_pitch = 0;
+// Render target que ficou sem a imagem de um passe desenhado na textura.
+uint64_t g_stale_sig = 0;
+const void* g_stale_fb = nullptr;
+uint32_t g_stale_base = 0;
+uint32_t g_stale_pitch = 0;
+uint64_t g_stale_bans = 0;
+uint64_t g_ok = 0;
+uint64_t g_abort = 0;
+
+void BanStale(const char* why) {
+  auto it = g_table.find(g_stale_sig);
+  if (it != g_table.end()) it->second.banned = true;
+  if ((g_stale_bans++ % 64) == 0) {
+    REXGPU_WARN("dbz3: render nativo: o render target ainda era preciso depois do passe {:016X} "
+                "({}); fica banido",
+                g_stale_sig, why);
+  }
+  g_stale_sig = 0;
+  g_stale_fb = nullptr;
+}
+constexpr uint32_t kHitsNeeded = 3;
+
+bool Matches(const draw_util::ResolveInfo& ri, uint32_t& width, uint32_t& height) {
+  if (ri.IsCopyingDepth() || ri.IsClearingDepth() || ri.IsClearingColor() ||
+      !ri.copy_dest_extent_length) {
+    return false;
+  }
+  const draw_util::ResolveEdramInfo& src = ri.color_edram_info;
+  if (src.msaa_samples != xenos::MsaaSamples::k1X ||
+      xenos::ColorRenderTargetFormat(src.format) != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      uint32_t(ri.copy_dest_info.copy_dest_format) != uint32_t(xenos::ColorFormat::k_8_8_8_8) ||
+      ri.copy_dest_info.copy_dest_exp_bias != 0 || ri.copy_dest_info.copy_dest_swap != 0 ||
+      ri.coordinate_info.edram_offset_x_div_8 != 0 || ri.coordinate_info.edram_offset_y_div_8 != 0 ||
+      ri.copy_dest_coordinate_info.offset_x_div_8 != 0 ||
+      ri.copy_dest_coordinate_info.offset_y_div_8 != 0) {
+    return false;
+  }
+  width = uint32_t(ri.coordinate_info.width_div_8) * 8;
+  height = ri.height_div_8 * 8;
+  return width >= 8 && height >= 8 &&
+         uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32 == ((width + 31) & ~31u);
+}
+
+void End(VulkanTextureCache& texture_cache) {
+  texture_cache.Dbz3EndAttachmentWrite(g_tex);
+  g_active = false;
+  g_tex = nullptr;
+  g_fb = nullptr;
+  g_view = VK_NULL_HANDLE;
+}
+
+bool Resolve(VulkanRenderTargetCache& cache, const draw_util::ResolveInfo& ri,
+             VulkanTextureCache& texture_cache) {
+  uint32_t width = 0, height = 0;
+  const bool matches = Matches(ri, width, height);
+  if (!g_active && g_stale_sig && !ri.IsCopyingDepth() &&
+      ri.color_edram_info.base_tiles == g_stale_base &&
+      ri.color_edram_info.pitch_tiles == g_stale_pitch) {
+    BanStale("resolvido outra vez");
+  }
+  if (g_active) {
+    if (matches && (ri.copy_dest_base & 0x1FFFFFFF) == g_dest) {
+      // O passe ja desenhou na textura: fecha-o, marca a memoria e a textura.
+      cache.Dbz3RitFinish(texture_cache, ri);
+      return true;
+    }
+    cache.Dbz3RitAbort(texture_cache, "outro resolve");
+    return false;
+  }
+  // Aprender: o passe atual (aberto por um quad a cobrir o scissor) acaba aqui.
+  if (g_pass_sig && matches && ri.color_edram_info.base_tiles == g_pass_base &&
+      ri.color_edram_info.pitch_tiles == g_pass_pitch &&
+      !dbz3_capture::WantsResolveReadback()) {
+    Prediction& p = g_table[g_pass_sig];
+    const uint32_t dest = ri.copy_dest_base & 0x1FFFFFFF;
+    const uint32_t endian = uint32_t(ri.copy_dest_info.copy_dest_endian);
+    if (p.dest == dest && p.endian == endian && p.width == width && p.height == height) {
+      ++p.hits;
+    } else {
+      p.dest = dest;
+      p.endian = endian;
+      p.width = width;
+      p.height = height;
+      p.hits = 1;
+    }
+  }
+  g_pass_sig = 0;
+  return false;
+}
+}  // namespace dbz3_rit
+
+void VulkanRenderTargetCache::Dbz3RitNormalPassStart(const void* framebuffer,
+                                                     bool full_overwrite) {
+  using namespace dbz3_rit;
+  if (!g_stale_sig || g_stale_fb != framebuffer) return;
+  if (full_overwrite) {
+    g_stale_sig = 0;  // sobrescrito: o conteudo antigo ja nao interessa
+    g_stale_fb = nullptr;
+  } else {
+    BanStale("passe que o carrega");
+  }
+}
+
+void VulkanRenderTargetCache::Dbz3RitPassStart(uint64_t signature, uint32_t color_base_tiles,
+                                               uint32_t pitch_tiles) {
+  dbz3_rit::g_pass_sig = signature;
+  dbz3_rit::g_pass_base = color_base_tiles;
+  dbz3_rit::g_pass_pitch = pitch_tiles;
+}
+
+bool VulkanRenderTargetCache::Dbz3RitActive() const { return dbz3_rit::g_active; }
+
+VkImageView VulkanRenderTargetCache::Dbz3RitContinue(const void* framebuffer) const {
+  return dbz3_rit::g_active && dbz3_rit::g_fb == framebuffer ? dbz3_rit::g_view : VK_NULL_HANDLE;
+}
+
+VkImageView VulkanRenderTargetCache::Dbz3RitBegin(VulkanTextureCache& texture_cache,
+                                                  uint64_t signature, const void* framebuffer,
+                                                  uint32_t area_right, uint32_t area_bottom,
+                                                  const uint32_t* sampled, uint32_t sampled_count,
+                                                  uint32_t color_base_tiles, uint32_t pitch_tiles) {
+  using namespace dbz3_rit;
+  if (g_active || !signature || IsDrawResolutionScaled() ||
+      rex::cvar::GetFlagByName("dbz3_render_into_texture") != "true" ||
+      dbz3_capture::WantsResolveReadback()) {
+    return VK_NULL_HANDLE;
+  }
+  auto it = g_table.find(signature);
+  if (it == g_table.end() || it->second.banned || it->second.hits < kHitsNeeded) {
+    return VK_NULL_HANDLE;
+  }
+  const Prediction& p = it->second;
+  if (area_right > p.width || area_bottom > p.height) {
+    return VK_NULL_HANDLE;
+  }
+  for (uint32_t i = 0; i < sampled_count; ++i) {
+    if (sampled[i] == p.dest) {
+      it->second.banned = true;  // o quad le o proprio destino
+      return VK_NULL_HANDLE;
+    }
+  }
+  void* found[4];
+  const uint32_t n = texture_cache.Dbz3FindResolveTextures(
+      p.dest, p.width, p.height, xenos::TextureFormat::k_8_8_8_8, false, xenos::Endian(p.endian),
+      found, 4);
+  if (n != 1 || !texture_cache.Dbz3TextureIsRenderable(found[0])) {
+    return VK_NULL_HANDLE;
+  }
+  VkImageView view = texture_cache.Dbz3GetStorageView(found[0]);
+  if (view == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+  texture_cache.Dbz3BeginAttachmentWrite(found[0]);
+  g_active = true;
+  g_sig = signature;
+  g_fb = framebuffer;
+  g_tex = found[0];
+  g_dest = p.dest;
+  g_view = view;
+  g_pass_sig = 0;
+  g_base = color_base_tiles;
+  g_pitch = pitch_tiles;
+  return view;
+}
+
+void VulkanRenderTargetCache::Dbz3RitFinish(VulkanTextureCache& texture_cache,
+                                            const draw_util::ResolveInfo& ri) {
+  using namespace dbz3_rit;
+  command_processor_.EndRenderPass();
+  texture_cache.MarkRangeAsResolved(ri.copy_dest_extent_start, ri.copy_dest_extent_length);
+  g_stale_sig = g_sig;
+  g_stale_fb = g_fb;
+  g_stale_base = g_base;
+  g_stale_pitch = g_pitch;
+  End(texture_cache);
+  // O render target nao tem esta imagem: nada de "resolve repetido" a partir dele.
+  dbz3_resolve_dedupe::g_dirty = true;
+  if ((g_ok++ % 6000) == 0) {
+    REXGPU_INFO("dbz3: render nativo: passes desenhados direto na textura: {} ({} desistencias, "
+                "{} assinaturas)",
+                g_ok, g_abort, g_table.size());
+  }
+}
+
+void VulkanRenderTargetCache::Dbz3RitAbort(VulkanTextureCache& texture_cache, const char* why) {
+  using namespace dbz3_rit;
+  if (!g_active) return;
+  command_processor_.EndRenderPass();
+  auto it = g_table.find(g_sig);
+  if (it != g_table.end()) it->second.banned = true;
+  if ((g_abort++ % 64) == 0) {
+    REXGPU_WARN("dbz3: render nativo: desenho direto na textura {:08X} abandonado ({}); "
+                "assinatura {:016X} banida",
+                g_dest, why, g_sig);
+  }
+  End(texture_cache);
+}
+
+void VulkanRenderTargetCache::Dbz3RitOnSample(VulkanTextureCache& texture_cache,
+                                              uint32_t address) {
+  using namespace dbz3_rit;
+  if (g_active) {
+    if (address == g_dest) Dbz3RitAbort(texture_cache, "a textura e lida no proprio passe");
+    return;
+  }
+  // A aprender: um draw do passe le o destino previsto -> nunca desenhar direto.
+  if (g_pass_sig) {
+    auto it = g_table.find(g_pass_sig);
+    if (it != g_table.end() && it->second.dest == address) it->second.banned = true;
+  }
+}
+
 }  // namespace rex::graphics::vulkan
