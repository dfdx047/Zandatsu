+// DBZ3-Android (dbz3_rt_direct): das transferencias entre imagens do host so ficam as que
+// levam o conteudo de uma "limpeza" feita com outra contagem de amostras sobre os mesmos
+// tiles (o Budokai 3 limpa cor e profundidade com 2 draws de ecra inteiro a 4x MSAA e pitch
+// 640, que cobrem exatamente o EDRAM do passe 1x a 1280). As outras (passe de 512x512,
+// brilho, e sobretudo as restauracoes profundidade <-> cor de ecra inteiro, duas por
+// lutador) nao fazem falta: o jogo restaura cor e profundidade ele proprio.
+bool RenderTargetCache::Dbz3DirectAllowsTransfer(RenderTargetKey source, RenderTargetKey dest) {
+  if (!REXCVAR_GET(dbz3_rt_direct)) {
+    return true;
+  }
+  return source.base_tiles == dest.base_tiles &&
+         source.pitch_tiles_at_32bpp == dest.pitch_tiles_at_32bpp &&
+         source.is_depth == dest.is_depth && source.resource_format == dest.resource_format &&
+         source.msaa_samples != dest.msaa_samples;
+}
