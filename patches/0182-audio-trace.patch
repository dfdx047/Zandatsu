+// Project SwordMan (0182): audio_trace (desligada por defeito). Cada open/atributos/leitura de um ficheiro de som
+// (caminho com "sound", .bnk/.wem/.pck/.wsp/.wai, e os .cpk) vai para o log: caminho pedido, caminho real, resultado
+// (NAO ENCONTRADO em destaque) e se as maiusculas/minusculas do pedido diferem das do disco (a procura ignora-as).
+// Nos .cpk a leitura diz que ficheiro de dentro foi lido (o TOC do CPK e lido no primeiro open).
+namespace {
+
+struct TraceCpkEntry {
+  uint64_t offset = 0, size = 0;
+  std::string name;
+};
+
+struct TraceFile {
+  std::string path;
+  std::shared_ptr<const std::vector<TraceCpkEntry>> toc;  // por offset; vazio se nao for CPK
+};
+
+std::mutex g_trace_mutex;
+std::unordered_map<uint32_t, TraceFile> g_trace_files;  // por handle
+std::unordered_map<std::string, std::shared_ptr<const std::vector<TraceCpkEntry>>> g_trace_tocs;
+
+bool TraceSoundPath(std::string_view path) {
+  const std::string lower = SwordmanLower(path);
+  auto ends = [&](const char* ext) {
+    const size_t n = std::strlen(ext);
+    return lower.size() >= n && lower.compare(lower.size() - n, n, ext) == 0;
+  };
+  return lower.find("sound") != std::string::npos || ends(".bnk") || ends(".wem") || ends(".pck") ||
+         ends(".wsp") || ends(".wai") || ends(".cpk");
+}
+
+// Tabela @UTF da CRI (big-endian; encriptada por XOR em alguns CPK). Devolve as linhas como texto/numeros.
+struct UtfRow {
+  std::unordered_map<std::string, uint64_t> num;
+  std::unordered_map<std::string, std::string> str;
+};
+
+bool ParseUtf(std::vector<uint8_t> b, std::vector<UtfRow>& rows) {
+  if (b.size() < 0x20) return false;
+  if (std::memcmp(b.data(), "@UTF", 4) != 0) {
+    uint32_t m = 0x655f;
+    for (auto& c : b) {
+      c ^= uint8_t(m);
+      m = (m * 0x4115) & 0xffff;
+    }
+    if (std::memcmp(b.data(), "@UTF", 4) != 0) return false;
+  }
+  auto u16 = [&](size_t o) { return o + 2 <= b.size() ? uint32_t(b[o] << 8 | b[o + 1]) : 0u; };
+  auto u32 = [&](size_t o) { return o + 4 <= b.size() ? (u16(o) << 16) | u16(o + 2) : 0u; };
+  auto u64 = [&](size_t o) { return (uint64_t(u32(o)) << 32) | u32(o + 4); };
+  const size_t rows_off = u16(0xa) + 8, str_off = u32(0xc) + 8;
+  const uint32_t ncol = u16(0x18), rowlen = u16(0x1a), nrows = u32(0x1c);
+  auto str = [&](uint32_t o) {
+    std::string out;
+    for (size_t i = str_off + o; i < b.size() && b[i]; ++i) out += char(b[i]);
+    return out;
+  };
+  struct Col {
+    std::string name;
+    uint8_t storage, type;
+    size_t const_pos;
+  };
+  std::vector<Col> cols;
+  size_t p = 0x20;
+  static const uint8_t kSize[] = {1, 1, 2, 2, 4, 4, 8, 8, 4, 8, 4, 8};
+  for (uint32_t i = 0; i < ncol; ++i) {
+    if (p + 5 > b.size()) return false;
+    Col c{str(u32(p + 1)), uint8_t(b[p] & 0xf0), uint8_t(b[p] & 0x0f), 0};
+    p += 5;
+    if (c.type > 0xb) return false;
+    if (c.storage == 0x30) {
+      c.const_pos = p;
+      p += kSize[c.type];
+    }
+    cols.push_back(c);
+  }
+  auto value = [&](const Col& c, size_t at, UtfRow& row) {
+    switch (c.type) {
+      case 0: case 1: row.num[c.name] = at < b.size() ? b[at] : 0; break;
+      case 2: case 3: row.num[c.name] = u16(at); break;
+      case 4: case 5: case 8: row.num[c.name] = u32(at); break;
+      case 6: case 7: case 9: row.num[c.name] = u64(at); break;
+      case 0xa: row.str[c.name] = str(u32(at)); break;
+      default: break;
+    }
+  };
+  for (uint32_t r = 0; r < nrows; ++r) {
+    UtfRow row;
+    size_t q = rows_off + size_t(r) * rowlen;
+    for (const auto& c : cols) {
+      if (c.storage == 0x50) {
+        value(c, q, row);
+        q += kSize[c.type];
+      } else if (c.storage == 0x30) {
+        value(c, c.const_pos, row);
+      }
+    }
+    rows.push_back(std::move(row));
+  }
+  return true;
+}
+
+std::shared_ptr<const std::vector<TraceCpkEntry>> ReadCpkToc(rex::filesystem::File* file) {
+  auto read = [&](uint64_t off, size_t n, std::vector<uint8_t>& out) {
+    out.resize(n);
+    size_t got = 0;
+    return file->ReadSync(std::span<uint8_t>(out.data(), n), size_t(off), &got) == X_STATUS_SUCCESS && got == n;
+  };
+  auto out = std::make_shared<std::vector<TraceCpkEntry>>();
+  std::vector<uint8_t> h, t;
+  auto le64 = [](const uint8_t* d) {
+    uint64_t v = 0;
+    for (int i = 7; i >= 0; --i) v = (v << 8) | d[i];
+    return v;
+  };
+  if (!read(0, 16, h) || std::memcmp(h.data(), "CPK ", 4) != 0) return out;
+  const uint64_t hsize = le64(h.data() + 8);
+  std::vector<UtfRow> hdr;
+  if (hsize > (1u << 20) || !read(16, size_t(hsize), t) || !ParseUtf(t, hdr) || hdr.empty()) return out;
+  const uint64_t toc = hdr[0].num["TocOffset"], content = hdr[0].num["ContentOffset"];
+  if (!toc || !read(toc, 16, h) || std::memcmp(h.data(), "TOC ", 4) != 0) return out;
+  const uint64_t tsize = le64(h.data() + 8);
+  std::vector<UtfRow> rows;
+  if (tsize > (64u << 20) || !read(toc + 16, size_t(tsize), t) || !ParseUtf(t, rows)) return out;
+  const uint64_t base = content ? std::min(toc, content) : toc;
+  for (auto& r : rows) {
+    std::string dir = r.str["DirName"];
+    out->push_back({base + r.num["FileOffset"], r.num["FileSize"], (dir.empty() ? "" : dir + "/") + r.str["FileName"]});
+  }
+  std::sort(out->begin(), out->end(), [](const auto& a, const auto& b) { return a.offset < b.offset; });
+  return out;
+}
+
+const char* TraceStatus(uint32_t status) {
+  switch (status) {
+    case X_STATUS_SUCCESS: return "ok";
+    case X_STATUS_OBJECT_NAME_NOT_FOUND: return "NAO ENCONTRADO (nome)";
+    case 0xC000003Au: return "NAO ENCONTRADO (pasta)";  // STATUS_OBJECT_PATH_NOT_FOUND
+    case X_STATUS_NO_SUCH_FILE: return "NAO ENCONTRADO";
+    case X_STATUS_END_OF_FILE: return "fim do ficheiro";
+    case X_STATUS_PENDING: return "pendente";
+    default: return "erro";
+  }
+}
+
+// O nome do pedido difere do do disco so nas maiusculas/minusculas?
+bool TraceCaseDiffers(std::string_view requested, const std::string& real) {
+  const size_t a = requested.find_last_of("\\/"), b = real.find_last_of("\\/");
+  const std::string_view rq = a == std::string_view::npos ? requested : requested.substr(a + 1);
+  const std::string_view rl = b == std::string::npos ? std::string_view(real) : std::string_view(real).substr(b + 1);
+  return rq != rl && SwordmanLower(rq) == SwordmanLower(rl);
+}
+
+void TraceOpen(const char* call, const std::string& requested, X_STATUS result, rex::filesystem::File* vfs_file,
+               uint32_t handle) {
+  if (!REXCVAR_GET(audio_trace)) return;
+  std::lock_guard<std::mutex> lock(g_trace_mutex);
+  if (!TraceSoundPath(requested)) {
+    if (XSUCCEEDED(result)) g_trace_files.erase(handle);  // o handle pode ter sido de um ficheiro de som
+    return;
+  }
+  auto& c = rex::audio::stats::Get();
+  c.trace_opens++;
+  if (XFAILED(result)) {
+    c.trace_not_found++;
+    REXKRNL_WARN("[audio-trace] {} '{}' -> {} ({:#x})", call, requested, TraceStatus(result), uint32_t(result));
+    return;
+  }
+  const std::string real = vfs_file && vfs_file->entry() ? vfs_file->entry()->absolute_path() : std::string();
+  const bool case_diff = vfs_file && vfs_file->entry() && TraceCaseDiffers(requested, vfs_file->entry()->name());
+  if (case_diff) c.trace_case_diff++;
+  TraceFile tf{requested, nullptr};
+  if (SwordmanLower(requested).ends_with(".cpk") && vfs_file) {
+    auto& toc = g_trace_tocs[real];
+    if (!toc) toc = ReadCpkToc(vfs_file);
+    tf.toc = toc;
+  }
+  REXKRNL_INFO("[audio-trace] {} '{}' -> ok, real '{}'{}{}", call, requested, real,
+               case_diff ? ", MAIUSCULAS/MINUSCULAS DIFERENTES" : "",
+               tf.toc ? fmt::format(", CPK com {} ficheiros", tf.toc->size()) : std::string());
+  if (handle) g_trace_files[handle] = std::move(tf);
+}
+
+void TraceRead(uint32_t handle, uint64_t offset, uint32_t length, X_STATUS result, uint32_t bytes, bool async) {
+  if (!REXCVAR_GET(audio_trace)) return;
+  std::string path, inner;
+  {
+    std::lock_guard<std::mutex> lock(g_trace_mutex);
+    auto it = g_trace_files.find(handle);
+    if (it == g_trace_files.end()) return;
+    path = it->second.path;
+    if (const auto& toc = it->second.toc) {
+      auto e = std::upper_bound(toc->begin(), toc->end(), offset,
+                                [](uint64_t o, const TraceCpkEntry& x) { return o < x.offset; });
+      if (e != toc->begin() && offset < std::prev(e)->offset + std::prev(e)->size) {
+        --e;
+        inner = fmt::format(" [{} +{}]", e->name, offset - e->offset);
+      } else {
+        inner = " [fora dos ficheiros do CPK]";
+      }
+    }
+  }
+  auto& c = rex::audio::stats::Get();
+  c.trace_reads++;
+  c.trace_read_bytes += bytes;
+  if (async) c.trace_reads_async++;
+  const bool failed = XFAILED(result) && result != X_STATUS_END_OF_FILE;
+  if (failed || bytes < length) c.trace_read_errors += failed ? 1 : 0;
+  if (failed || (bytes < length && result != X_STATUS_PENDING)) {
+    REXKRNL_WARN("[audio-trace] leitura '{}'{} offset {} pediu {} B -> {} ({:#x}), {} B lidos", path, inner, offset,
+                 length, TraceStatus(result), uint32_t(result), bytes);
+  } else {
+    REXKRNL_INFO("[audio-trace] leitura '{}'{} offset {} {} B -> {} B{}", path, inner, offset, length, bytes,
+                 async ? " (assincrona: concluida na hora, evento/APC sinalizados)" : "");
+  }
+}
