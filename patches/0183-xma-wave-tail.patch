+// SwordMan (0183): the start-padding realignment holds each decoded frame's tail until the next frame arrives, so
+// the last frame of a wave never left the carry and every wave came out one frame (512 samples) short. Wwise counts
+// the samples of each XMA voice and only ends the voice at the wave's full length: short by a frame, the voice waited
+// forever for data, kept its XMA context, and once ~165 contexts were held no new sound effect could play (enemy
+// sounds, combo hits). When the input runs dry, emit the tail as the final frame with the missing head silent.
+void XmaContext::FlushCarry(const XMA_CONTEXT_DATA* data) {
+  if (!carry_valid_ || current_frame_remaining_subframes_ > 0) {
+    return;
+  }
+  const size_t pad_bytes = kDecoderStartPadding * kBytesPerSample << data->is_stereo;
+  const size_t carry_bytes = (kBytesPerFrameChannel << data->is_stereo) - pad_bytes;
+  std::memcpy(raw_frame_.data(), carry_frame_.data(), carry_bytes);
+  std::memset(raw_frame_.data() + carry_bytes, 0, pad_bytes);
+  current_frame_remaining_subframes_ = 4 << data->is_stereo;
+  loop_frame_output_limit_ = pending_output_limit_;
+  current_frame_remaining_subframes_ -= std::min(pending_start_skip_, current_frame_remaining_subframes_);
+  carry_valid_ = false;
+  pending_output_limit_ = 0;
+  pending_start_skip_ = 0;
+  stats::Get().xma_carry_flushes.fetch_add(1, std::memory_order_relaxed);
+}
+
 void XmaContext::Decode(XMA_CONTEXT_DATA* data) {
   SCOPE_profile_cpu_f("apu");
 
   if (!data->IsAnyInputBufferValid()) {
+    FlushCarry(data);  // SwordMan (0183)
     return;
   }
 
