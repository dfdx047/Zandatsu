+// Project SwordMan (0166): pular os videos das logos. Cada abertura de um ficheiro de video
+// (caminho com "movie") fica no log ("[movie] open ..."), e os que tiverem um dos textos de
+// swordman_skip_movies no nome passam a "nao existe" (open e atributos): o jogo segue para o
+// proximo video ou para o menu sem esperar.
+REXCVAR_DEFINE_STRING(swordman_skip_movies, "", "Kernel",
+                      "Project SwordMan: videos que o jogo nao encontra (textos do nome do "
+                      "ficheiro, separados por virgula, sem distinguir maiusculas)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+static std::string SwordmanLower(std::string_view s) {
+  std::string out(s);
+  std::transform(out.begin(), out.end(), out.begin(),
+                 [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return out;
+}
+
+// true = este video fica escondido do jogo.
+static bool SwordmanMovieSkipped(std::string_view path, const char* call) {
+  std::string lower = SwordmanLower(path);
+  if (lower.find("movie") == std::string::npos) {
+    return false;
+  }
+  std::string list = SwordmanLower(REXCVAR_GET(swordman_skip_movies));
+  bool skipped = false;
+  size_t start = 0;
+  while (start <= list.size()) {
+    size_t comma = list.find(',', start);
+    if (comma == std::string::npos) comma = list.size();
+    std::string item = list.substr(start, comma - start);
+    item.erase(0, item.find_first_not_of(" \t"));
+    item.erase(item.find_last_not_of(" \t") + 1);
+    if (!item.empty() && lower.find(item) != std::string::npos) {
+      skipped = true;
+      break;
+    }
+    start = comma + 1;
+  }
+  REXKRNL_INFO("[movie] {} {}{}", call, path, skipped ? " -> saltado" : "");
+  return skipped;
+}
