+// 0117: o frame repetido mexe nos registos da GPU (constantes, fetch, estado) e nos shaders
+// ativos; ao repetir a meio de um frame real (dentro de um WAIT_REG_MEM, 0106) o resto desse frame
+// seguia com o estado do frame repetido - "Failed in backend" e, no Turnip, VK_ERROR_DEVICE_LOST
+// ao descongelar. Guarda tudo antes e repoe depois (pelos WriteRegister, para as caches do backend
+// verem as mudancas; os registos com efeitos colaterais voltam direto).
+void CommandProcessor::SwordManSaveState(SwordManState& st) {
+  st.regs.assign(register_file_->values, register_file_->values + RegisterFile::kRegisterCount);
+  st.vs = active_vertex_shader_;
+  st.ps = active_pixel_shader_;
+}
+
+void CommandProcessor::SwordManRestoreState(const SwordManState& st) {
+  if (st.regs.size() != RegisterFile::kRegisterCount) return;
+  uint32_t* values = register_file_->values;
+  for (uint32_t i = 0; i < RegisterFile::kRegisterCount; ++i) {
+    if (values[i] == st.regs[i]) continue;
+    const bool raw = (i >= XE_GPU_REG_SCRATCH_REG0 && i <= XE_GPU_REG_SCRATCH_REG7) ||
+                     i == XE_GPU_REG_COHER_STATUS_HOST || i == XE_GPU_REG_DC_LUT_RW_INDEX ||
+                     i == XE_GPU_REG_DC_LUT_SEQ_COLOR || i == XE_GPU_REG_DC_LUT_PWL_DATA ||
+                     i == XE_GPU_REG_DC_LUT_30_COLOR;
+    if (raw) {
+      const_cast<volatile uint32_t&>(values[i]) = st.regs[i];
+    } else {
+      WriteRegister(i, st.regs[i]);
+    }
+  }
+  active_vertex_shader_ = st.vs;
+  active_pixel_shader_ = st.ps;
+}
