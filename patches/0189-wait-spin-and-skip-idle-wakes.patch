+  // Zandatsu (0189): com mutex_ trancado. Um sinal avanca epoch_ (quem esta em spin ve-o sem o mutex) e so chama o
+  // futex se alguem esta mesmo a dormir no cond_ (o bionic chama-o sempre, mesmo sem ninguem a espera).
+  void WakeAllLocked() {
+    epoch_.fetch_add(1, std::memory_order_release);
+    if (sleepers_) {
+      cond_.notify_all();
+    }
+  }
+  void WakeOneLocked() {
+    epoch_.fetch_add(1, std::memory_order_release);
+    if (sleepers_) {
+      cond_.notify_one();
+    }
+  }
