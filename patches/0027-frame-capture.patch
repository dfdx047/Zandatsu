+#pragma once
+// DBZ3-Android: captura de frames para o renderizador nativo.
+//
+// Grava, para N frames, tudo o que o jogo manda a GPU: registos (em deltas), cada draw
+// (primitiva, indices, shaders), cada resolve, o swap, o microcodigo dos shaders e os
+// bytes da memoria do guest que os draws leem (vertex buffers, index buffers, texturas).
+// Com isto desenha-se offline o mapa de passes do jogo e escreve-se o renderizador
+// nativo sem precisar do aparelho a cada passo.
+//
+// Pedido: ficheiro <REX_APP_DIR>/capture.req (conteudo = numero de frames, por omissao
+// 2). Saida: <REX_APP_DIR>/logs/capture/<timestamp>.dfc. Formato: registos
+// {u32 tipo, u32 tamanho, bytes}:
+//   1 REGS    u32 n, n x {u32 indice, u32 valor}       (so os que mudaram)
+//   2 DRAW    u32 prim, u32 index_count, u32 ib_format, u32 ib_endian, u32 ib_base,
+//             u32 ib_len, u64 vs_hash, u64 ps_hash, u32 draw_index_no_frame
+//   3 COPY    (resolve; os registos ja foram escritos antes)
+//   4 SWAP    u32 frontbuffer, u32 w, u32 h, u32 frame_index
+//   5 SHADER  u32 tipo(0 vs 1 ps), u64 hash, u32 ndwords, dwords (big-endian do guest)
+//   6 MEM     u32 addr_fisico, u32 len, bytes
+//   7 INFO    texto (cabecalho)
+// Tudo corre na thread do command processor.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <string>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+
+namespace rex::graphics::vulkan::dbz3_capture {
+
+enum RecordType : uint32_t {
+  kRegs = 1,
+  kDraw = 2,
+  kCopy = 3,
+  kSwap = 4,
+  kShader = 5,
+  kMem = 6,
+  kInfo = 7,
+};
+
+struct State {
+  FILE* file = nullptr;
+  uint32_t frames_left = 0;
+  uint32_t frame_index = 0;
+  uint32_t draw_index = 0;
+  uint32_t check_counter = 0;
+  std::vector<uint32_t> last_regs;  // snapshot dos registos ja escritos
+  std::unordered_set<uint64_t> shaders;
+  std::vector<std::pair<uint32_t, uint32_t>> mem_ranges;  // (addr, len) ja escritos
+  std::vector<std::pair<uint32_t, uint32_t>> pending;     // par (indice, valor)
+  uint64_t bytes = 0;
+};
+
+inline State g_state;
+
+inline bool Active() { return g_state.file != nullptr; }
+
+inline void WriteRecord(uint32_t type, const void* data, size_t size) {
+  State& st = g_state;
+  uint32_t header[2] = {type, uint32_t(size)};
+  fwrite(header, sizeof(header), 1, st.file);
+  if (size) fwrite(data, 1, size, st.file);
+  st.bytes += sizeof(header) + size;
+}
+
+inline std::string AppDir() {
+  const char* dir = std::getenv("REX_APP_DIR");
+  return dir ? std::string(dir) : std::string(".");
+}
+
+// Regioes de registos que interessam: estado de render (0x2000-0x2FFF) e constantes dos
+// shaders (ALU 0x4000-0x47FF, fetch 0x4800-0x48FF, bool/loop 0x4900-0x4A00).
+inline constexpr std::pair<uint32_t, uint32_t> kRegRanges[] = {{0x2000, 0x3000},
+                                                               {0x4000, 0x4A00}};
+
+inline void WriteRegsDelta(const RegisterFile& regs, bool full) {
+  State& st = g_state;
+  st.pending.clear();
+  for (const auto& range : kRegRanges) {
+    for (uint32_t i = range.first; i < range.second; ++i) {
+      const uint32_t v = regs[i];
+      if (full || st.last_regs[i] != v) {
+        st.pending.emplace_back(i, v);
+        st.last_regs[i] = v;
+      }
+    }
+  }
+  if (st.pending.empty()) return;
+  std::vector<uint32_t> buf;
+  buf.reserve(1 + st.pending.size() * 2);
+  buf.push_back(uint32_t(st.pending.size()));
+  for (const auto& p : st.pending) {
+    buf.push_back(p.first);
+    buf.push_back(p.second);
+  }
+  WriteRecord(kRegs, buf.data(), buf.size() * sizeof(uint32_t));
+}
+
+// Escreve [addr, addr+len) da memoria fisica do guest, uma vez por captura.
+template <typename MemoryT>
+inline void WriteMem(const MemoryT& memory, uint32_t addr, uint32_t len) {
+  State& st = g_state;
+  if (!len) return;
+  constexpr uint32_t kPhysicalSize = 512u * 1024 * 1024;
+  if (addr >= kPhysicalSize) return;
+  if (len > kPhysicalSize - addr) len = kPhysicalSize - addr;
+  for (const auto& r : st.mem_ranges) {
+    if (addr >= r.first && addr + len <= r.first + r.second) return;
+  }
+  st.mem_ranges.emplace_back(addr, len);
+  std::vector<uint8_t> buf(8 + len);
+  std::memcpy(buf.data(), &addr, 4);
+  std::memcpy(buf.data() + 4, &len, 4);
+  std::memcpy(buf.data() + 8, memory.TranslatePhysical(addr), len);
+  WriteRecord(kMem, buf.data(), buf.size());
+}
+
+template <typename ShaderT>
+inline void WriteShader(const ShaderT* shader, uint32_t type) {
+  State& st = g_state;
+  if (!shader) return;
+  const uint64_t hash = shader->ucode_data_hash();
+  if (!st.shaders.insert(hash).second) return;
+  const size_t n = shader->ucode_dword_count();
+  std::vector<uint8_t> buf(4 + 8 + 4 + n * 4);
+  std::memcpy(buf.data(), &type, 4);
+  std::memcpy(buf.data() + 4, &hash, 8);
+  const uint32_t n32 = uint32_t(n);
+  std::memcpy(buf.data() + 12, &n32, 4);
+  std::memcpy(buf.data() + 16, shader->ucode_dwords(), n * 4);
+  WriteRecord(kShader, buf.data(), buf.size());
+}
+
+// Tamanho aproximado de uma textura (base + mips) para a copia da memoria: chega para
+// reconstruir offline; o maximo evita copiar meia memoria por engano.
+inline uint32_t TextureBytes(const xenos::xe_gpu_texture_fetch_t& fetch) {
+  const FormatInfo* info = FormatInfo::Get(uint32_t(fetch.format));
+  uint32_t width = 1, height = 1, depth = 1;
+  switch (fetch.dimension) {
+    case xenos::DataDimension::k1D:
+      width = fetch.size_1d.width + 1;
+      break;
+    case xenos::DataDimension::k2DOrStacked:
+      width = fetch.size_2d.width + 1;
+      height = fetch.size_2d.height + 1;
+      depth = fetch.stacked ? fetch.size_2d.stack_depth + 1 : 1;
+      break;
+    case xenos::DataDimension::k3D:
+      width = fetch.size_3d.width + 1;
+      height = fetch.size_3d.height + 1;
+      depth = fetch.size_3d.depth + 1;
+      break;
+    case xenos::DataDimension::kCube:
+      width = fetch.size_2d.width + 1;
+      height = fetch.size_2d.height + 1;
+      depth = 6;
+      break;
+  }
+  // Tiled: alinhado a 32x32; pitch em pixels >> 5.
+  uint32_t pitch = fetch.pitch ? uint32_t(fetch.pitch) << 5 : ((width + 31) & ~31u);
+  uint32_t rows = (height + 31) & ~31u;
+  uint64_t bytes = uint64_t(pitch) * rows * depth * (info ? info->bits_per_pixel : 32) / 8;
+  bytes = bytes * 3 / 2 + 4096;  // mips
+  if (bytes > 16u * 1024 * 1024) bytes = 16u * 1024 * 1024;
+  return uint32_t(bytes);
+}
+
+template <typename MemoryT>
+inline void WriteDrawMemory(const RegisterFile& regs, const MemoryT& memory) {
+  // Vertex fetch constants: 96 (cada 2 dwords). Texture fetch: 32 (cada 6 dwords), nos
+  // mesmos registos: o tipo diz qual e.
+  for (uint32_t i = 0; i < 32; ++i) {
+    xenos::xe_gpu_texture_fetch_t tf = regs.GetTextureFetch(i);
+    if (tf.type == xenos::FetchConstantType::kTexture) {
+      WriteMem(memory, tf.base_address << 12, TextureBytes(tf));
+      if (tf.mip_address && tf.mip_address != tf.base_address) {
+        WriteMem(memory, tf.mip_address << 12, TextureBytes(tf) / 2);
+      }
+      continue;
+    }
+    for (uint32_t j = 0; j < 3; ++j) {
+      xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(i * 3 + j);
+      if (vf.type == xenos::FetchConstantType::kVertex && vf.size) {
+        WriteMem(memory, vf.address << 2, vf.size << 2);
+      }
+    }
+  }
+}
+
+inline void Begin(uint32_t frames, const RegisterFile& regs) {
+  State& st = g_state;
+  const std::string dir = AppDir() + "/logs/capture";
+  std::string cmd = "mkdir -p '" + dir + "'";
+  (void)std::system(cmd.c_str());
+  char name[64];
+  std::time_t t = std::time(nullptr);
+  std::strftime(name, sizeof(name), "%Y%m%d-%H%M%S.dfc", std::localtime(&t));
+  const std::string path = dir + "/" + name;
+  st.file = std::fopen(path.c_str(), "wb");
+  if (!st.file) {
+    REXLOG_WARN("dbz3: captura: nao consegui criar {}", path);
+    return;
+  }
+  st.frames_left = frames;
+  st.frame_index = 0;
+  st.draw_index = 0;
+  st.bytes = 0;
+  st.shaders.clear();
+  st.mem_ranges.clear();
+  st.last_regs.assign(RegisterFile::kRegisterCount, 0);
+  const char magic[] = "DFC1";
+  fwrite(magic, 4, 1, st.file);
+  const std::string info = "dbz3 capture frames=" + std::to_string(frames);
+  WriteRecord(kInfo, info.data(), info.size());
+  WriteRegsDelta(regs, true);
+  REXLOG_INFO("dbz3: captura de {} frames para {}", frames, path);
+}
+
+inline void End() {
+  State& st = g_state;
+  if (!st.file) return;
+  std::fclose(st.file);
+  st.file = nullptr;
+  REXLOG_INFO("dbz3: captura terminada: {} frames, {} draws, {:.1f} MB", st.frame_index,
+              st.draw_index, double(st.bytes) / 1.0e6);
+}
+
+// No swap: fecha o frame em captura e ve se ha um pedido novo (a cada 30 frames).
+template <typename MemoryT>
+inline void OnSwap(const RegisterFile& regs, const MemoryT& memory, uint32_t frontbuffer,
+                   uint32_t width, uint32_t height) {
+  State& st = g_state;
+  if (st.file) {
+    uint32_t rec[4] = {frontbuffer, width, height, st.frame_index};
+    WriteRecord(kSwap, rec, sizeof(rec));
+    // A imagem apresentada, para comparar offline com o que o renderizador nativo fizer.
+    WriteMem(memory, frontbuffer, width * height * 4);
+    ++st.frame_index;
+    if (--st.frames_left == 0) End();
+    return;
+  }
+  if (++st.check_counter % 30 != 0) return;
+  const std::string req = AppDir() + "/capture.req";
+  FILE* f = std::fopen(req.c_str(), "rb");
+  if (!f) return;
+  char buf[16] = {};
+  size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+  (void)n;
+  std::fclose(f);
+  std::remove(req.c_str());
+  int frames = std::atoi(buf);
+  if (frames <= 0) frames = 2;
+  if (frames > 10) frames = 10;
+  Begin(uint32_t(frames), regs);
+}
+
+template <typename MemoryT, typename ShaderT>
+inline void OnDraw(const RegisterFile& regs, const MemoryT& memory, xenos::PrimitiveType prim,
+                   uint32_t index_count, xenos::IndexFormat ib_format, xenos::Endian ib_endian,
+                   uint32_t ib_base, uint32_t ib_len, const ShaderT* vs, const ShaderT* ps) {
+  State& st = g_state;
+  if (!st.file) return;
+  WriteRegsDelta(regs, false);
+  WriteShader(vs, 0);
+  WriteShader(ps, 1);
+  if (ib_base && ib_len) WriteMem(memory, ib_base, ib_len);
+  WriteDrawMemory(regs, memory);
+  struct {
+    uint32_t prim, index_count, ib_format, ib_endian, ib_base, ib_len;
+    uint64_t vs_hash, ps_hash;
+    uint32_t draw_index;
+  } rec = {uint32_t(prim),
+           index_count,
+           uint32_t(ib_format),
+           uint32_t(ib_endian),
+           ib_base,
+           ib_len,
+           vs ? vs->ucode_data_hash() : 0,
+           ps ? ps->ucode_data_hash() : 0,
+           st.draw_index++};
+  WriteRecord(kDraw, &rec, sizeof(rec));
+}
+
+inline void OnCopy(const RegisterFile& regs) {
+  State& st = g_state;
+  if (!st.file) return;
+  WriteRegsDelta(regs, false);
+  WriteRecord(kCopy, nullptr, 0);
+}
+
+}  // namespace rex::graphics::vulkan::dbz3_capture
