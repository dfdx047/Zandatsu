+std::string TextureCache::Dbz3DescribeTexturesAt(uint32_t base_page) const {
+  std::string out;
+  uint32_t count = 0;
+  for (const auto& [key, texture] : textures_) {
+    if (key.base_page != base_page) {
+      continue;
+    }
+    if (++count > 6) {
+      out += " ...";
+      break;
+    }
+    out += fmt::format(" [{}x{} fmt={} endian={} tiled={} pitch={} mips={} dim={}]",
+                       uint32_t(key.width_minus_1) + 1, uint32_t(key.height_minus_1) + 1,
+                       uint32_t(key.format), uint32_t(key.endianness), uint32_t(key.tiled),
+                       uint32_t(key.pitch) * 32, uint32_t(key.mip_max_level),
+                       uint32_t(key.dimension));
+  }
+  return count ? out : std::string(" (nenhuma)");
+}
