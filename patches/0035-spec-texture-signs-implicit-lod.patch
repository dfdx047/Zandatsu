+// Diagnostico do atalho de cor: motivo + destino, cada combinacao uma vez (ate 32 linhas).
+template <typename Extra>
+bool Dbz3ColorFail(int reason, const draw_util::ResolveInfo& ri, Extra&& extra_fn) {
+  static std::vector<uint64_t> seen;
+  const uint64_t id = (uint64_t(reason) << 32) | ri.copy_dest_base;
+  if (seen.size() < 32 && std::find(seen.begin(), seen.end(), id) == seen.end()) {
+    seen.push_back(id);
+    const std::string extra = extra_fn();
+    REXGPU_INFO(
+        "dbz3: atalho resolve->textura nao aplicado (motivo {}) dest={:08X} {}x{} fmt={} "
+        "endian={} pitch={} rt_fmt={} msaa={} edram_off={},{} dest_off={},{}{}",
+        reason, ri.copy_dest_base, uint32_t(ri.coordinate_info.width_div_8) * 8,
+        ri.height_div_8 * 8, uint32_t(ri.copy_dest_info.copy_dest_format),
+        uint32_t(ri.copy_dest_info.copy_dest_endian),
+        uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32,
+        uint32_t(ri.color_edram_info.format), uint32_t(ri.color_edram_info.msaa_samples),
+        uint32_t(ri.coordinate_info.edram_offset_x_div_8) * 8,
+        uint32_t(ri.coordinate_info.edram_offset_y_div_8) * 8,
+        uint32_t(ri.copy_dest_coordinate_info.offset_x_div_8) * 8,
+        uint32_t(ri.copy_dest_coordinate_info.offset_y_div_8) * 8, extra);
+  }
+  return false;
+}
+bool Dbz3ColorFail(int reason, const draw_util::ResolveInfo& ri) {
+  return Dbz3ColorFail(reason, ri, [] { return std::string(); });
+}
