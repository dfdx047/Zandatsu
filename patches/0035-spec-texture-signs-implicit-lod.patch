+spv::Id SpirvShaderTranslator::Dbz3TextureSignsSpecConstant(uint32_t fetch_constant_index) {
+  spv::Id& id = dbz3_texture_signs_spec_[fetch_constant_index & 31];
+  if (id == spv::NoResult) {
+    // Valor por omissao: os quatro componentes unsigned (TextureSign::kUnsigned = 0).
+    id = builder_->makeUintConstant(0, true);
+    builder_->addDecoration(id, spv::DecorationSpecId,
+                            int(kDbz3TextureSignsSpecIdBase + (fetch_constant_index & 31)));
+    builder_->addName(id, fmt::format("dbz3_texture_signs_{}", fetch_constant_index).c_str());
+  }
+  return id;
+}
