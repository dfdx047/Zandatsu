+// 0115: no Turnip o resolve sem memoria deixa a imagem errada (RP5, varredura 21/10): la a
+// memoria do guest e sempre escrita, salvo swordman_skip_memory_turnip.
+bool VulkanRenderTargetCache::SwordManSkipMemoryAllowed() const {
+  const VkDriverId driver = command_processor_.GetVulkanDevice()->properties().driverID;
+  if (driver != VK_DRIVER_ID_MESA_TURNIP || REXCVAR_GET(swordman_skip_memory_turnip)) {
+    return true;
+  }
+  static bool logged = false;
+  if (!logged) {
+    logged = true;
+    REXGPU_INFO("swordman: Turnip: resolve sem memoria desligado (a memoria e sempre escrita)");
+  }
+  return false;
+}
