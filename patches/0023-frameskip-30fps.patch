 namespace rex::graphics::vulkan {
 
+// DBZ3-Android: "30 FPS" de verdade (dbz3_frameskip). O jogo continua a correr a
+// 60 (a logica segue o vblank do guest), mas so 1 em cada (N+1) frames e desenhado:
+// nos outros, os comandos de estado sao processados e os draws, resolves e queries
+// de oclusao sao ignorados, e nao ha apresentacao. Corta o trabalho da GPU a metade
+// com N=1 sem deixar o jogo em camara lenta em GPUs fracas.
+namespace dbz3_frameskip {
+bool g_skip_frame = false;
+uint32_t g_counter = 0;
+}  // namespace dbz3_frameskip
+
+
 namespace {
 
 // glslang default built-in resource limits.
@@ -654,7 +666,8 @@ void VulkanCommandProcessor::InitializeShaderStorage(const std::filesystem::path
 
 bool VulkanCommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* reader,
                                                                 uint32_t packet, uint32_t count) {
-  if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_query_resources_available_) {
+  if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_query_resources_available_ ||
+      dbz3_frameskip::g_skip_frame) {
     return CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(reader, packet, count);
   }
 
@@ -2612,6 +2625,19 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
   dbz3_gpuprof::Zone<DeferredCommandBuffer> dbz3_zone(deferred_command_buffer_,
                                                       dbz3_gpuprof::kSwap);
 
+  {
+    const bool this_frame_skipped = dbz3_frameskip::g_skip_frame;
+    const std::string skip_text = rex::cvar::GetFlagByName("dbz3_frameskip");
+    const int skip = skip_text.empty() ? 0 : std::clamp(std::atoi(skip_text.c_str()), 0, 3);
+    ++dbz3_frameskip::g_counter;
+    dbz3_frameskip::g_skip_frame = skip > 0 && (dbz3_frameskip::g_counter % uint32_t(skip + 1)) != 0;
+    if (this_frame_skipped) {
+      // Frame nao desenhado: fecha-o sem apresentar (fica a imagem anterior).
+      EndSubmission(true);
+      return;
+    }
+  }
+
   bool skip_present_due_async_placeholder = REXCVAR_GET(async_shader_compilation) &&
                                             REXCVAR_GET(vulkan_async_skip_incomplete_frames) &&
                                             frame_used_async_placeholder_pipeline_;
