+// Zandatsu (renut/0043): plume's Android present (VK_GOOGLE_display_timing), on the render thread just before
+// vkQueuePresentKHR: the time this frame should reach the display, 0 = at once. The previous frame's time plus the
+// frame's refreshes; a frame that cannot make it (less than two refreshes ahead: the GPU is still drawing it) takes
+// the first refresh of the grid two refreshes from now, and the next ones follow it. Half a refresh early, so the
+// compositor's rounding never pushes it to the refresh after.
+extern "C" uint64_t zandatsu_desired_present_ns() {
+  using namespace banjo::display_sync;
+  static const int32_t mode = REXCVAR_GET(swordman_present_timing);
+  if (!mode || !g_running.load(std::memory_order_acquire))
+    return 0;
+  const uint64_t vsync = g_last_vsync.load(std::memory_order_acquire);
+  const uint64_t period = g_period.load(std::memory_order_relaxed);
+  const uint64_t frame = g_frame_ns.load(std::memory_order_relaxed);
+  const uint64_t now = NowNs();
+  // Mode 1: only frames of 30 fps or less (two 60 Hz refreshes or more).
+  if (!vsync || !period || !frame || now > vsync + kGridStaleNs || (mode == 1 && frame < 30'000'000ull)) {
+    g_target_ns = 0;
+    return 0;
+  }
+  static const uint64_t margin_ns = uint64_t(REXCVAR_GET(swordman_present_margin_us)) * 1000;
+  const uint64_t margin = std::max<uint64_t>(1, (margin_ns + period - 1) / period);
+  // The grid's first refresh at or after 'from'.
+  auto grid_at = [&](uint64_t from) { return vsync + (from - vsync + period - 1) / period * period; };
+  uint64_t target = g_target_ns ? g_target_ns + frame : 0;
+  if (!target || target > now + frame + margin * period) {
+    // The grid starts (or the frame rate went up and it slid ahead): 'margin' refreshes from now.
+    if (target)
+      g_reanchored.fetch_add(1, std::memory_order_relaxed);
+    target = grid_at(now + margin * period);
+  } else if (target < now + period) {
+    // Late (the frame cannot make its refresh): at once, and the grid goes on from the refresh it will likely reach.
+    g_reanchored.fetch_add(1, std::memory_order_relaxed);
+    g_target_ns = grid_at(now + period);
+    return 0;
+  }
+  g_target_ns = target;
+  g_timed.fetch_add(1, std::memory_order_relaxed);
+  return target - period / 2;
+}
