+#if defined(__ANDROID__)
+    bool VulkanCommandList::foldClear(uint32_t bit, uint32_t attachment, const VkClearValue &value, const RenderRect *rects,
+                                      uint32_t rectCount) {
+        if (activeRenderPass != VK_NULL_HANDLE || targetFramebuffer == nullptr ||
+            !AndroidClearFold.load(std::memory_order_relaxed)) {
+            return false;
+        }
+        // So o alvo inteiro: um retangulo parcial precisa do resto do conteudo (loadOp LOAD).
+        if (rectCount > 1) {
+            return false;
+        }
+        if (rectCount == 1 && (rects[0].left > 0 || rects[0].top > 0 || rects[0].right < int32_t(targetFramebuffer->width) ||
+                               rects[0].bottom < int32_t(targetFramebuffer->height))) {
+            return false;
+        }
+        pendingClearMask |= bit;
+        pendingClearValues[attachment] = value;
+        return true;
+    }
+#endif
