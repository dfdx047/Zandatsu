+#if defined(__ANDROID__)
+// Zandatsu (renut/0025): "120 FPS (interpolated)" in Renut's final pass, the emulated GPU's dbz3_frame_interpolation
+// (patch 0092, same cvars and the same maths: shaders/host/frame_interp_ps.hlsl). Each new frame of the game (60 a
+// second) is presented twice: first a frame generated halfway between the previous one and it, then itself; FIFO at
+// 120 Hz shows them one vblank apart. The generated frame goes with the frame's own command list (the game's draws,
+// the interpolation passes, its scan-out); the real one with a small list of its own after it (g_interp.lists), so
+// the frame ring keeps its two frames in flight. Only with a display at 100 Hz or more and without the 30 FPS
+// frame skip; anything else (first frame, a size change) presents the frame alone.
+struct InterpPush {
+  float scale[2];  // present_vs
+  float translate[2];
+  uint32_t pass, cur, prev, q_prev, q_cur, s_prev, s_cur, vs, v8, rows, cut, k, quality, mode, full_w, full_h;
+};
+static_assert(sizeof(InterpPush) == 80);
+
+struct InterpTarget {
+  std::unique_ptr<plume::RenderTexture> texture;
+  std::unique_ptr<plume::RenderTextureView> view;
+  std::unique_ptr<plume::RenderFramebuffer> framebuffer;
+  plume::RenderTextureLayout layout = plume::RenderTextureLayout::UNKNOWN;
+  uint32_t slot = kInvalidDescriptor, width = 0, height = 0;
+};
+
+struct FrameInterp {
+  bool built = false, failed = false;
+  std::unique_ptr<plume::RenderPipelineLayout> layout;
+  std::unique_ptr<plume::RenderShader> ps;
+  std::unique_ptr<plume::RenderPipeline> rgba8, rgba16f, r32f, gen;
+  InterpTarget q[2], s[2], hist[2], vs, v8, rows, cut, image;
+  std::unique_ptr<plume::RenderFramebuffer> gen_fb[2];  // image + hist[i]
+  uint32_t width = 0, height = 0, k = 1, index = 0;
+  bool history = false;
+  // The real frame's present after the generated one.
+  std::unique_ptr<plume::RenderCommandList> lists[kFramesInFlight];
+  std::unique_ptr<plume::RenderCommandFence> fences[kFramesInFlight];
+  std::unique_ptr<plume::RenderCommandSemaphore> acquire[kFramesInFlight];
+  bool submitted[kFramesInFlight] = {};
+  uint32_t extra = 0;
+  bool logged = false;
+};
+FrameInterp g_interp;
+
+void WaitInterpListsLocked(VideoState &s) {
+  for (uint32_t i = 0; i < kFramesInFlight; ++i) {
+    if (g_interp.submitted[i]) {
+      render_thread::WaitScope wait;
+      s.queue->waitForCommandFence(g_interp.fences[i].get());
+      g_interp.submitted[i] = false;
+    }
+  }
+}
+
+bool InterpOn() {
+  if (!rex::cvar::Query<bool>("dbz3_frame_interpolation"))
+    return false;
+  const std::string skip = rex::cvar::GetFlagByName("dbz3_frameskip");
+  if (!skip.empty() && std::atoi(skip.c_str()) > 0)
+    return false;
+  return rex::perf::GetDisplayRefreshRate() >= 100.0f;
+}
+
+std::unique_ptr<plume::RenderPipeline> InterpPipeline(VideoState &s, plume::RenderFormat format, uint32_t targets,
+                                                      const char *name) {
+  plume::RenderGraphicsPipelineDesc desc;
+  desc.pipelineLayout = g_interp.layout.get();
+  desc.vertexShader = s.present_vs.get();
+  desc.pixelShader = g_interp.ps.get();
+  desc.primitiveTopology = plume::RenderPrimitiveTopology::TRIANGLE_LIST;
+  desc.cullMode = plume::RenderCullMode::NONE;
+  desc.renderTargetCount = targets;
+  for (uint32_t i = 0; i < targets; ++i) {
+    desc.renderTargetFormat[i] = format;
+    desc.renderTargetBlend[i] = plume::RenderBlendDesc::Copy();
+  }
+  desc.depthTargetFormat = plume::RenderFormat::UNKNOWN;
+  std::unique_ptr<plume::RenderPipeline> pipeline = s.device->createGraphicsPipeline(desc);
+  if (pipeline)
+    pipeline->setName(name);
+  return pipeline;
+}
+
+bool BuildInterp(VideoState &s) {
+  FrameInterp &f = g_interp;
+  if (f.built || f.failed)
+    return f.built;
+  plume::RenderDescriptorSetBuilder textures;  // the bindless tables, as BuildUtilityLayout's
+  textures.begin();
+  textures.addTexture(0, kTextureDescriptorCount);
+  textures.end(true, kTextureDescriptorCount);
+  plume::RenderDescriptorSetBuilder samplers;
+  samplers.begin();
+  samplers.addSampler(0, kSamplerDescriptorCount);
+  samplers.end(true, kSamplerDescriptorCount);
+  plume::RenderPipelineLayoutBuilder layout;
+  layout.begin(false, true);
+  layout.addDescriptorSet(textures);  // set 0 -> t0, space0
+  layout.addDescriptorSet(samplers);  // set 1 -> s0, space1
+  layout.addPushConstant(0, 2, sizeof(InterpPush),
+                         plume::RenderShaderStageFlag::VERTEX | plume::RenderShaderStageFlag::PIXEL);
+  layout.end();
+  f.layout = layout.create(s.device.get());
+  f.ps = CreateHostShader(s.device.get(), RENUT_HOST_SHADER(frame_interp_ps), "frame_interp_ps");
+  if (f.layout && f.ps && s.present_vs) {
+    f.rgba8 = InterpPipeline(s, plume::RenderFormat::R8G8B8A8_UNORM, 1, "renut frame interpolation (rgba8)");
+    f.rgba16f = InterpPipeline(s, plume::RenderFormat::R16G16B16A16_FLOAT, 1, "renut frame interpolation (rgba16f)");
+    f.r32f = InterpPipeline(s, plume::RenderFormat::R32_FLOAT, 1, "renut frame interpolation (r32f)");
+    f.gen = InterpPipeline(s, plume::RenderFormat::R8G8B8A8_UNORM, 2, "renut frame interpolation (generated)");
+  }
+  bool lists = true;
+  for (uint32_t i = 0; i < kFramesInFlight && lists; ++i) {
+    f.lists[i] = s.queue->createCommandList();
+    f.fences[i] = s.device->createCommandFence();
+    f.acquire[i] = s.device->createCommandSemaphore();
+    lists = f.lists[i] && f.fences[i] && f.acquire[i];
+  }
+  f.built = f.rgba8 && f.rgba16f && f.r32f && f.gen && lists;
+  f.failed = !f.built;
+  if (f.failed)
+    RGPU_ERROR("dbz3_frame_interpolation: the pipelines failed to build; 60 FPS");
+  else
+    RGPU_INFO("dbz3_frame_interpolation: pipelines ready");
+  return f.built;
+}
+
+bool MakeInterpTarget(VideoState &s, InterpTarget &t, uint32_t w, uint32_t h, plume::RenderFormat format,
+                      const char *name) {
+  t.framebuffer.reset();
+  t.view.reset();
+  t.texture.reset();
+  t.layout = plume::RenderTextureLayout::UNKNOWN;
+  plume::RenderTextureDesc desc = plume::RenderTextureDesc::Texture2D(w, h, 1, format);
+  desc.flags |= plume::RenderTextureFlag::RENDER_TARGET;
+  t.texture = s.device->createTexture(desc);
+  if (!t.texture)
+    return false;
+  t.texture->setName(name);
+  t.view = t.texture->createTextureView(plume::RenderTextureViewDesc::Texture2D(format));
+  const plume::RenderTexture *attachment = t.texture.get();
+  t.framebuffer = s.device->createFramebuffer(plume::RenderFramebufferDesc(&attachment, 1));
+  if (t.slot == kInvalidDescriptor)
+    t.slot = Video::AllocateTextureSlotLocked();
+  if (!t.view || !t.framebuffer || t.slot == kInvalidDescriptor)
+    return false;
+  Video::SetTextureSlotLocked(t.slot, t.texture.get(), t.view.get());
+  t.width = w;
+  t.height = h;
+  return true;
+}
+
+// The images of a frame size (k = round(width / 1280), as patch 0092's).
+bool EnsureInterpTargets(VideoState &s, uint32_t w, uint32_t h) {
+  FrameInterp &f = g_interp;
+  if (f.width == w && f.height == h)
+    return true;
+  if (f.width) {
+    detail::WaitAllSubmitted(s);  // the frames in flight still read the old ones (a size change)
+    WaitInterpListsLocked(s);
+  }
+  f.width = f.height = 0;
+  f.history = false;
+  const uint32_t k = std::max(1u, uint32_t(std::lround(float(w) / 1280.0f)));
+  const uint32_t qw = (w + 4 * k - 1) / (4 * k), qh = (h + 4 * k - 1) / (4 * k);
+  const uint32_t sw = (qw + 3) / 4, sh = (qh + 3) / 4;
+  const uint32_t bw = (qw + 1) / 2, bh = (qh + 1) / 2;
+  constexpr plume::RenderFormat rgba8 = plume::RenderFormat::R8G8B8A8_UNORM;
+  constexpr plume::RenderFormat rgba16f = plume::RenderFormat::R16G16B16A16_FLOAT;
+  bool ok = MakeInterpTarget(s, f.image, w, h, rgba8, "renut interpolation: generated frame") &&
+            MakeInterpTarget(s, f.vs, sw, sh, rgba16f, "renut interpolation: coarse motion") &&
+            MakeInterpTarget(s, f.v8, bw, bh, rgba16f, "renut interpolation: block motion") &&
+            MakeInterpTarget(s, f.rows, 1, bh, plume::RenderFormat::R32_FLOAT, "renut interpolation: cut rows") &&
+            MakeInterpTarget(s, f.cut, 1, 1, plume::RenderFormat::R32_FLOAT, "renut interpolation: cut");
+  for (uint32_t i = 0; i < 2 && ok; ++i) {
+    ok = MakeInterpTarget(s, f.q[i], qw, qh, rgba8, "renut interpolation: Q") &&
+         MakeInterpTarget(s, f.s[i], sw, sh, rgba8, "renut interpolation: S") &&
+         MakeInterpTarget(s, f.hist[i], w, h, rgba8, "renut interpolation: history");
+    if (ok) {
+      const plume::RenderTexture *attachments[] = {f.image.texture.get(), f.hist[i].texture.get()};
+      f.gen_fb[i] = s.device->createFramebuffer(plume::RenderFramebufferDesc(attachments, 2));
+      ok = f.gen_fb[i] != nullptr;
+    }
+  }
+  if (!ok) {
+    RGPU_ERROR("dbz3_frame_interpolation: images for {}x{} failed; 60 FPS", w, h);
+    f.failed = true;
+    return false;
+  }
+  f.width = w;
+  f.height = h;
+  f.k = k;
+  RGPU_INFO("dbz3_frame_interpolation: {}x{} (k {}, motion blocks {}x{})", w, h, k, bw, bh);
+  return true;
+}
+
+void InterpToLayout(plume::RenderCommandList *cmd, InterpTarget &t, plume::RenderTextureLayout layout) {
+  if (t.layout == layout)
+    return;
+  cmd->barriers(plume::RenderBarrierStage::GRAPHICS, plume::RenderTextureBarrier(t.texture.get(), layout));
+  t.layout = layout;
+}
+
+void InterpPass(VideoState &s, plume::RenderPipeline *pipeline, plume::RenderFramebuffer *framebuffer,
+                std::initializer_list<InterpTarget *> targets, InterpPush push) {
+  plume::RenderCommandList *cmd = s.command_list;
+  for (InterpTarget *t : targets)
+    InterpToLayout(cmd, *t, plume::RenderTextureLayout::COLOR_WRITE);
+  const InterpTarget &first = **targets.begin();
+  cmd->setFramebuffer(framebuffer);
+  cmd->setViewports(plume::RenderViewport(0.0f, 0.0f, float(first.width), float(first.height)));
+  cmd->setScissors(plume::RenderRect(0, 0, int32_t(first.width), int32_t(first.height)));
+  cmd->setGraphicsPipelineLayout(g_interp.layout.get());
+  cmd->setPipeline(pipeline);
+  cmd->setGraphicsDescriptorSet(s.texture_set.get(), 0);
+  cmd->setGraphicsDescriptorSet(s.sampler_set.get(), 1);
+  cmd->setGraphicsPushConstants(0, &push, 0, sizeof(push));
+  cmd->drawInstanced(3, 1, 0, 0);
+  cmd->setFramebuffer(nullptr);
+  for (InterpTarget *t : targets)
+    InterpToLayout(cmd, *t, plume::RenderTextureLayout::SHADER_READ);
+}
+
+// Records the passes for the guest frame into the frame's list; true with the generated frame in out (none for the
+// first frame after a start or a size change: the history is recorded, nothing to present yet).
+bool InterpolateLocked(VideoState &s, const PresentImage &image, PresentImage &out) {
+  FrameInterp &f = g_interp;
+  if (f.failed)
+    return false;
+  if (!image.texture || image.descriptor == kInvalidDescriptor || image.gamma > 0.0f || !InterpOn()) {
+    f.history = false;
+    return false;
+  }
+  const uint32_t w = image.source_width ? image.source_width : image.width;
+  const uint32_t h = image.source_height ? image.source_height : image.height;
+  if (!w || !h || !BuildInterp(s) || !EnsureInterpTargets(s, w, h) || !Video::EnsureCommandListLocked())
+    return false;
+  if (!f.logged) {
+    f.logged = true;
+    RGPU_INFO("dbz3_frame_interpolation: on ({:.0f} Hz display)", rex::perf::GetDisplayRefreshRate());
+  }
+  plume::RenderCommandList *cmd = s.command_list;
+  if (image.layout && *image.layout != plume::RenderTextureLayout::SHADER_READ) {
+    cmd->barriers(plume::RenderBarrierStage::GRAPHICS,
+                  plume::RenderTextureBarrier(image.texture, plume::RenderTextureLayout::SHADER_READ));
+    *image.layout = plume::RenderTextureLayout::SHADER_READ;
+  }
+  const uint32_t i = f.index, p = i ^ 1u;
+  InterpPush push{};
+  push.scale[0] = push.scale[1] = 1.0f;
+  push.cur = image.descriptor;
+  push.prev = f.hist[p].slot;
+  push.q_prev = f.q[p].slot;
+  push.q_cur = f.q[i].slot;
+  push.s_prev = f.s[p].slot;
+  push.s_cur = f.s[i].slot;
+  push.vs = f.vs.slot;
+  push.v8 = f.v8.slot;
+  push.rows = f.rows.slot;
+  push.cut = f.cut.slot;
+  push.k = f.k;
+  push.quality = uint32_t(std::clamp(rex::cvar::Query<int32_t>("dbz3_frame_interpolation_quality"), 0, 2));
+  push.full_w = w;
+  push.full_h = h;
+  const bool generate = f.history;
+  push.mode = generate ? 0u : 1u;
+  push.pass = 0;
+  InterpPass(s, f.rgba8.get(), f.q[i].framebuffer.get(), {&f.q[i]}, push);
+  push.pass = 1;
+  InterpPass(s, f.rgba8.get(), f.s[i].framebuffer.get(), {&f.s[i]}, push);
+  if (generate) {
+    push.pass = 2;
+    InterpPass(s, f.rgba16f.get(), f.vs.framebuffer.get(), {&f.vs}, push);
+    push.pass = 3;
+    InterpPass(s, f.rgba16f.get(), f.v8.framebuffer.get(), {&f.v8}, push);
+    push.pass = 4;
+    InterpPass(s, f.r32f.get(), f.rows.framebuffer.get(), {&f.rows}, push);
+    push.pass = 5;
+    InterpPass(s, f.r32f.get(), f.cut.framebuffer.get(), {&f.cut}, push);
+  }
+  push.pass = 6;
+  InterpPass(s, f.gen.get(), f.gen_fb[i].get(), {&f.image, &f.hist[i]}, push);
+  f.index = p;
+  f.history = true;
+  if (!generate)
+    return false;
+  out = PresentImage{};
+  out.texture = f.image.texture.get();
+  out.layout = &f.image.layout;
+  out.descriptor = f.image.slot;
+  out.width = w;
+  out.height = h;
+  return true;
+}
