+// Zandatsu (renut/0025): "120 FPS (interpolated)" in Renut's final pass. The game renders 60 frames a second; for
+// each new frame the present first shows one generated halfway between the previous frame and the new one, then
+// the new one (FIFO at 120 Hz spaces them by one vblank). Same maths as the emulated GPU's presenter
+// (rexglue-sdk src/ui/shaders/dbz3_frame_interp.comp, patch 0092), as pixel passes over present_vs's triangle
+// instead of compute: one shader, the pass in the push constants (FrameInterp in present.cpp).
+//   0 Q    luma+chroma of the new frame at 1/4k (k = round(width / 1280)), as (Y, U + 0.5, V + 0.5)
+//   1 S    Q at 1/4 (1/16k)
+//   2 VS   coarse motion on S: symmetric search +-3 texels, 3x3 window, then half a texel
+//   3 V8   motion per 8k x 8k block on Q (candidates: the S vector and its 4 neighbours, zero, then +-1 and +-0.5);
+//          .w = 1 for a block without a match (scene cut test)
+//   4 ROWS the unmatched blocks of each row of V8 (1 x rows)
+//   5 CUT  1 when more than half of the blocks are unmatched (1 x 1)
+//   6 GEN  per pixel: unchanged -> the new frame (HUD, still background); scene cut -> the new frame; else the best
+//          of {interpolated vector, block vector, 4 neighbours} by colour error plus a coherence penalty, and on a
+//          mismatch the coherent side or a plain blend. Target 1 = the new frame (the next frame's history).
+//          mode 1: no history (first frame, size change): the new frame in both.
+// Must match InterpPush in present.cpp.
+
+struct InterpPush
+{
+    float2 scale;  // present_vs
+    float2 translate;
+    uint pass;
+    uint cur;      // bindless slots
+    uint prev;
+    uint qPrev;
+    uint qCur;
+    uint sPrev;
+    uint sCur;
+    uint vs;
+    uint v8;
+    uint rows;
+    uint cut;
+    uint k;
+    uint quality;
+    uint mode;
+    uint fullW;    // the frame (the guest texture can be larger)
+    uint fullH;
+};
+
+#ifdef __spirv__
+[[vk::push_constant]] ConstantBuffer<InterpPush> g_Push;
+#else
+ConstantBuffer<InterpPush> g_Push : register(b0, space2);
+#endif
+
+Texture2D<float4> g_Textures[] : register(t0, space0);
+SamplerState g_Samplers[] : register(s0, space1);
+#define LINEAR_CLAMP 0  // kLinearClampSamplerSlot
+
+static const int R_COARSE = 3;
+static const float3 YUV_OFFSET = float3(0.0, 0.5, 0.5);
+static const float LAMBDA_COARSE = 0.002;
+static const float LAMBDA_REFINE = 0.0005;
+static const float T_CUT_BLOCK = 0.15;
+static const float EPS_STATIC = 1.5 / 255.0;
+static const float T_LO = 0.03;
+static const float T_HI = 0.10;
+static const float K_COHERENCE = 0.004;
+static const float COHERENCE_CAP = 32.0;
+static const float COHERENT_PX = 4.0;
+
+struct Sizes
+{
+    int2 full, q, s, b;
+};
+
+Sizes GetSizes()
+{
+    Sizes z;
+    const int k = int(g_Push.k);
+    z.full = int2(g_Push.fullW, g_Push.fullH);
+    z.q = (z.full + 4 * k - 1) / (4 * k);
+    z.s = (z.q + 3) / 4;
+    z.b = (z.q + 1) / 2;
+    return z;
+}
+
+float3 Yuv(float3 rgb)
+{
+    const float y = dot(rgb, float3(0.299, 0.587, 0.114));
+    return float3(y, (rgb.b - y) * 0.5, (rgb.r - y) * 0.5);
+}
+
+float YuvDiff(float3 a, float3 b)
+{
+    const float3 d = abs(a - b);
+    return d.x + d.y + d.z;
+}
+
+// Pixel coordinates (texel centres at i + 0.5) -> linear sample with the clamp sampler. The texture's own size
+// (the guest's can be larger than the frame).
+float3 At(uint slot, float2 p)
+{
+    uint w, h;
+    g_Textures[slot].GetDimensions(w, h);
+    return g_Textures[slot].SampleLevel(g_Samplers[LINEAR_CLAMP], p / float2(w, h), 0.0).rgb;
+}
+
+float4 Fetch(uint slot, int2 i)
+{
+    return g_Textures[slot].Load(int3(i, 0));
+}
+
+// --- 0: Q -------------------------------------------------------------------------------------------------------
+float4 PassQ(int2 q)
+{
+    const int k = int(g_Push.k);
+    const int d = 4 * k;
+    float3 acc = 0.0;
+    for (int b = 0; b < 2 * k; ++b)
+        for (int a = 0; a < 2 * k; ++a)
+            acc += Yuv(At(g_Push.cur, float2(q.x * d + 1 + 2 * a, q.y * d + 1 + 2 * b)));
+    acc /= float(4 * k * k);
+    return float4(acc + YUV_OFFSET, 0.0);
+}
+
+// --- 1: S -------------------------------------------------------------------------------------------------------
+float4 PassS(int2 s, Sizes z)
+{
+    float3 sum = 0.0;
+    for (int y = 0; y < 4; ++y)
+        for (int x = 0; x < 4; ++x)
+            sum += Fetch(g_Push.qCur, min(s * 4 + int2(x, y), z.q - 1)).rgb;
+    return float4(sum / 16.0, 0.0);
+}
+
+// --- 2: VS ------------------------------------------------------------------------------------------------------
+float CoarseCost(float2 c, float2 v)
+{
+    float cost = 0.0;
+    for (int dy = -1; dy <= 1; ++dy)
+        for (int dx = -1; dx <= 1; ++dx)
+        {
+            const float2 o = c + float2(dx, dy);
+            cost += YuvDiff(At(g_Push.sPrev, o - v * 0.5), At(g_Push.sCur, o + v * 0.5));
+        }
+    return cost / 9.0 + LAMBDA_COARSE * (abs(v.x) + abs(v.y));
+}
+
+float4 PassVS(int2 s)
+{
+    const float2 c = float2(s) + 0.5;
+    float best = 1.0e30;
+    float2 bv = 0.0;
+    for (int vy = -R_COARSE; vy <= R_COARSE; ++vy)
+        for (int vx = -R_COARSE; vx <= R_COARSE; ++vx)
+        {
+            const float2 v = float2(vx, vy);
+            const float cost = CoarseCost(c, v);
+            if (cost < best)
+            {
+                best = cost;
+                bv = v;
+            }
+        }
+    const float2 cv = bv;
+    for (int dy = -1; dy <= 1; ++dy)
+        for (int dx = -1; dx <= 1; ++dx)
+        {
+            if (dx == 0 && dy == 0)
+                continue;
+            const float2 v = cv + float2(dx, dy) * 0.5;
+            const float cost = CoarseCost(c, v);
+            if (cost < best)
+            {
+                best = cost;
+                bv = v;
+            }
+        }
+    return float4(bv * float(16 * g_Push.k), best, 0.0);
+}
+
+// --- 3: V8 ------------------------------------------------------------------------------------------------------
+float RefineCost(float2 c, float2 v)
+{
+    float cost = 0.0;
+    for (int oy = 0; oy < 4; ++oy)
+        for (int ox = 0; ox < 4; ++ox)
+        {
+            const float2 o = c + float2(float(ox) - 1.5, float(oy) - 1.5);
+            cost += YuvDiff(At(g_Push.qPrev, o - v * 0.5), At(g_Push.qCur, o + v * 0.5));
+        }
+    return cost / 16.0;
+}
+
+float4 PassV8(int2 b, Sizes z)
+{
+    const float2 c = float2(b) * 2.0 + 1.0;
+    const float q2px = float(4 * g_Push.k);
+    float best = RefineCost(c, 0.0);
+    float best_raw = best;
+    float2 bv = 0.0;
+    const int2 s = b / 2;
+    for (int dy = -1; dy <= 1; ++dy)
+        for (int dx = -1; dx <= 1; ++dx)
+        {
+            if (dx != 0 && dy != 0)
+                continue;
+            const int2 n = clamp(s + int2(dx, dy), 0, z.s - 1);
+            const float2 v = Fetch(g_Push.vs, n).xy / q2px;
+            const float raw = RefineCost(c, v);
+            const float cost = raw + LAMBDA_REFINE * (abs(v.x) + abs(v.y));
+            if (cost < best)
+            {
+                best = cost;
+                best_raw = raw;
+                bv = v;
+            }
+        }
+    for (int step_i = 0; step_i < 2; ++step_i)
+    {
+        const float step = step_i == 0 ? 1.0 : 0.5;
+        const float2 cv = bv;
+        for (int dy = -1; dy <= 1; ++dy)
+            for (int dx = -1; dx <= 1; ++dx)
+            {
+                if (dx == 0 && dy == 0)
+                    continue;
+                const float2 v = cv + float2(dx, dy) * step;
+                const float raw = RefineCost(c, v);
+                const float cost = raw + LAMBDA_REFINE * (abs(v.x) + abs(v.y));
+                if (cost < best)
+                {
+                    best = cost;
+                    best_raw = raw;
+                    bv = v;
+                }
+            }
+    }
+    return float4(bv * q2px, best_raw, best_raw > T_CUT_BLOCK ? 1.0 : 0.0);
+}
+
+// --- 4: ROWS, 5: CUT --------------------------------------------------------------------------------------------
+float4 PassRows(int row, Sizes z)
+{
+    float bad = 0.0;
+    for (int x = 0; x < z.b.x; ++x)
+        bad += Fetch(g_Push.v8, int2(x, row)).w;
+    return float4(bad, 0.0, 0.0, 0.0);
+}
+
+float4 PassCut(Sizes z)
+{
+    float bad = 0.0;
+    for (int y = 0; y < z.b.y; ++y)
+        bad += Fetch(g_Push.rows, int2(0, y)).x;
+    return float4(bad * 2.0 > float(z.b.x * z.b.y) ? 1.0 : 0.0, bad, 0.0, 0.0);
+}
+
+// --- 6: GEN -----------------------------------------------------------------------------------------------------
+float2 BlockVec(float2 p, float bsz, Sizes z)
+{
+    const int2 i = clamp(int2(floor(p / bsz)), 0, z.b - 1);
+    return Fetch(g_Push.v8, i).xy;
+}
+
+float3 Generate(int2 px, float3 c0, Sizes z)
+{
+    const float3 p0 = Fetch(g_Push.prev, px).rgb;
+    const float3 d0 = abs(p0 - c0);
+    const float3 blend0 = 0.5 * (p0 + c0);
+    const bool cut = Fetch(g_Push.cut, int2(0, 0)).x > 0.5;
+    if (max(d0.r, max(d0.g, d0.b)) <= EPS_STATIC || cut)
+        return c0;
+    if (g_Push.quality == 0u)
+        return blend0;
+    const float2 p = float2(px) + 0.5;
+    const float bsz = float(8 * g_Push.k);
+    float2 cands[6];
+    int count = 2;
+    {
+        uint w, h;
+        g_Textures[g_Push.v8].GetDimensions(w, h);
+        cands[0] = g_Textures[g_Push.v8].SampleLevel(g_Samplers[LINEAR_CLAMP], p / bsz / float2(w, h), 0.0).xy;
+    }
+    const int2 ib = clamp(int2(floor(p / bsz)), 0, z.b - 1);
+    cands[1] = Fetch(g_Push.v8, ib).xy;
+    cands[2] = cands[3] = cands[4] = cands[5] = cands[1];
+    if (g_Push.quality >= 2u)
+    {
+        cands[2] = Fetch(g_Push.v8, clamp(ib + int2(-1, 0), 0, z.b - 1)).xy;
+        cands[3] = Fetch(g_Push.v8, clamp(ib + int2(1, 0), 0, z.b - 1)).xy;
+        cands[4] = Fetch(g_Push.v8, clamp(ib + int2(0, -1), 0, z.b - 1)).xy;
+        cands[5] = Fetch(g_Push.v8, clamp(ib + int2(0, 1), 0, z.b - 1)).xy;
+        count = 6;
+    }
+    // The zero vector first, without a coherence penalty.
+    float best_s = (d0.r + d0.g + d0.b) / 3.0;
+    float best_e = best_s;
+    float3 best_p = p0;
+    float3 best_c = c0;
+    bool ok_p = true;
+    bool ok_c = true;
+    for (int i = 0; i < count; ++i)
+    {
+        const float2 v = cands[i];
+        const float2 sp = p - v * 0.5;
+        const float2 sc = p + v * 0.5;
+        const float3 pw = At(g_Push.prev, sp);
+        const float3 cw = At(g_Push.cur, sc);
+        const float3 d = abs(pw - cw);
+        const float e = (d.r + d.g + d.b) / 3.0;
+        const float2 vp = BlockVec(sp, bsz, z) - v;
+        const float2 vc = BlockVec(sc, bsz, z) - v;
+        const float dp = abs(vp.x) + abs(vp.y);
+        const float dc = abs(vc.x) + abs(vc.y);
+        const float score = e + K_COHERENCE * min(dp + dc, COHERENCE_CAP);
+        if (score < best_s)
+        {
+            best_s = score;
+            best_e = e;
+            best_p = pw;
+            best_c = cw;
+            ok_p = dp <= COHERENT_PX;
+            ok_c = dc <= COHERENT_PX;
+        }
+    }
+    const float3 avg = 0.5 * (best_p + best_c);
+    const float3 fallback = ok_p != ok_c ? (ok_c ? best_c : best_p) : blend0;
+    const float w = saturate((best_e - T_LO) / (T_HI - T_LO));
+    return lerp(avg, fallback, w);
+}
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+struct GenOutput
+{
+    float4 gen : SV_Target0;
+    float4 hist : SV_Target1;
+};
+
+GenOutput main(PSInput input)
+{
+    const int2 px = int2(input.position.xy);
+    const Sizes z = GetSizes();
+    GenOutput o;
+    o.hist = 0.0;
+    switch (g_Push.pass)
+    {
+    case 0: o.gen = PassQ(px); break;
+    case 1: o.gen = PassS(px, z); break;
+    case 2: o.gen = PassVS(px); break;
+    case 3: o.gen = PassV8(px, z); break;
+    case 4: o.gen = PassRows(px.y, z); break;
+    case 5: o.gen = PassCut(z); break;
+    default:
+    {
+        const float3 c0 = Fetch(g_Push.cur, px).rgb;
+        o.hist = float4(c0, 1.0);
+        o.gen = float4(g_Push.mode == 0u ? Generate(px, c0, z) : c0, 1.0);
+        break;
+    }
+    }
+    return o;
+}
