+void Rgb565(uint32_t c, uint32_t out[3]) {
+  const uint32_t r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+  out[0] = (r << 3) | (r >> 2);
+  out[1] = (g << 2) | (g >> 4);
+  out[2] = (b << 3) | (b >> 2);
+}
+
+// The 16 colours of a BC1 colour block as RGBA8 words, texel i at out[i].
+void DecodeColorBlock(const uint8_t *block, bool opaque, uint32_t out[16]) {
+  const uint32_t endpoints = Load32(block), indices = Load32(block + 4);
+  const uint32_t c0 = endpoints & 0xFFFF, c1 = endpoints >> 16;
+  uint32_t a[3], b[3], palette[4];
+  Rgb565(c0, a);
+  Rgb565(c1, b);
+  auto pack = [](uint32_t r, uint32_t g, uint32_t bl, uint32_t al) { return r | (g << 8) | (bl << 16) | (al << 24); };
+  palette[0] = pack(a[0], a[1], a[2], 255);
+  palette[1] = pack(b[0], b[1], b[2], 255);
+  if (opaque || c0 > c1) {
+    palette[2] = pack((2 * a[0] + b[0] + 1) / 3, (2 * a[1] + b[1] + 1) / 3, (2 * a[2] + b[2] + 1) / 3, 255);
+    palette[3] = pack((a[0] + 2 * b[0] + 1) / 3, (a[1] + 2 * b[1] + 1) / 3, (a[2] + 2 * b[2] + 1) / 3, 255);
+  } else {
+    palette[2] = pack((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, 255);
+    palette[3] = 0;
+  }
+  for (uint32_t i = 0; i < 16; ++i)
+    out[i] = palette[(indices >> (2 * i)) & 3];
+}
+
+// The 16 values of a BC4 block.
+void DecodeAlphaBlock(const uint8_t *block, uint8_t out[16]) {
+  const uint32_t a0 = block[0], a1 = block[1];
+  uint64_t bits = 0;
+  for (uint32_t i = 0; i < 6; ++i)
+    bits |= uint64_t(block[2 + i]) << (8 * i);
+  for (uint32_t i = 0; i < 16; ++i) {
+    const uint32_t index = uint32_t(bits >> (3 * i)) & 7;
+    uint32_t v;
+    if (index == 0)
+      v = a0;
+    else if (index == 1)
+      v = a1;
+    else if (a0 > a1)
+      v = ((8 - index) * a0 + (index - 1) * a1 + 3) / 7;
+    else if (index == 6)
+      v = 0;
+    else if (index == 7)
+      v = 255;
+    else
+      v = ((6 - index) * a0 + (index - 1) * a1 + 2) / 5;
+    out[i] = uint8_t(v);
+  }
+}
