+// SwordMan (Android): decodes BC1-BC5 blocks (the guest's DXT1, DXT2/3, DXT4/5, DXT5A and DXN) into plain texels
+// for a device without textureCompressionBC (Mali), or where the driver's BC copies are not trusted
+// (swordman_renut_bc_decode). The staging holds the guest blocks already endian-swapped (ReadLevel in
+// render/textures.cpp), in rows of blocks; the output is the decoded_blocks layout (DecodeBlockRow in
+// render/format.cpp): each row of blocks is 4 rows of texels, dstRowPitch bytes apart, then copied into the
+// texture as for any uncompressed format. One thread per block. Both buffers are reached by their device address
+// (the upload ring's), so the pipeline has no descriptor sets.
+// The decode follows the BCn rules of the Vulkan spec (Data Format specification, "S3TC" and "RGTC"); the
+// approach (a compute pass per upload, a thread per block) is the one of Themaister's Granite (MIT) as used by
+// leegao/bcn_layer, rewritten here for the five formats the Xbox 360 has.
+// Must match BcDecodePush in render/textures.cpp.
+
+struct BcDecodePush
+{
+    uint64_t src;          // device address of block (0, 0, 0)
+    uint64_t dst;          // device address of texel (0, 0, 0)
+    uint blocksW;
+    uint blocksH;
+    uint blockCount;       // blocksW * blocksH * depth
+    uint format;           // 1 BC1, 2 BC2, 3 BC3, 4 BC4, 5 BC5
+    uint srcRowPitch;      // bytes between rows of blocks
+    uint srcSlicePitch;
+    uint dstRowPitch;      // bytes between rows of texels
+    uint dstSlicePitch;
+};
+
+[[vk::push_constant]] ConstantBuffer<BcDecodePush> g_Push;
+
+uint Load(uint64_t address) { return vk::RawBufferLoad<uint>(address, 4); }
+void Store(uint64_t address, uint value) { vk::RawBufferStore<uint>(address, value, 4); }
+
+uint3 Rgb565(uint c)
+{
+    const uint r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+    return uint3((r << 3) | (r >> 2), (g << 2) | (g >> 4), (b << 3) | (b >> 2));
+}
+
+// BC1 colour: four RGBA8 palette entries. 'opaque' (BC2/BC3) always uses the four-colour mode.
+void ColorPalette(uint endpoints, bool opaque, out uint4 palette[4])
+{
+    const uint c0 = endpoints & 0xFFFF, c1 = endpoints >> 16;
+    const uint3 a = Rgb565(c0), b = Rgb565(c1);
+    palette[0] = uint4(a, 255);
+    palette[1] = uint4(b, 255);
+    if (opaque || c0 > c1) {
+        palette[2] = uint4((2 * a + b + 1) / 3, 255);
+        palette[3] = uint4((a + 2 * b + 1) / 3, 255);
+    } else {
+        palette[2] = uint4((a + b) / 2, 255);
+        palette[3] = uint4(0, 0, 0, 0);
+    }
+}
+
+// BC4 (and the alpha of BC3, each half of BC5): the 8 values of the block's two endpoints.
+uint AlphaValue(uint a0, uint a1, uint index)
+{
+    if (index == 0) return a0;
+    if (index == 1) return a1;
+    if (a0 > a1) return ((8 - index) * a0 + (index - 1) * a1 + 3) / 7;
+    if (index == 6) return 0;
+    if (index == 7) return 255;
+    return ((6 - index) * a0 + (index - 1) * a1 + 2) / 5;
+}
+
+// The 16 values of a BC4 block (two words), texel i in bits 8i of out[i / 4].
+void DecodeAlpha(uint w0, uint w1, out uint rows[4])
+{
+    const uint a0 = w0 & 0xFF, a1 = (w0 >> 8) & 0xFF;
+    // 48 bits of 3-bit indices from byte 2.
+    const uint lo = (w0 >> 16) | (w1 << 16);  // indices 0-9 (and 2 bits of 10)
+    const uint hi = w1 >> 8;                  // bits 24-47: indices 8-15
+    for (uint y = 0; y < 4; ++y) {
+        uint row = 0;
+        for (uint x = 0; x < 4; ++x) {
+            const uint i = y * 4 + x;
+            const uint index = i < 8 ? (lo >> (3 * i)) & 7 : (hi >> (3 * (i - 8))) & 7;
+            row |= AlphaValue(a0, a1, index) << (8 * x);
+        }
+        rows[y] = row;
+    }
+}
+
+[numthreads(64, 1, 1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+    const uint block = id.x;
+    if (block >= g_Push.blockCount)
+        return;
+    const uint bx = block % g_Push.blocksW;
+    const uint rest = block / g_Push.blocksW;
+    const uint by = rest % g_Push.blocksH;
+    const uint bz = rest / g_Push.blocksH;
+    const uint format = g_Push.format;
+    const uint blockBytes = (format == 1 || format == 4) ? 8 : 16;
+    const uint64_t src = g_Push.src + uint64_t(bz) * g_Push.srcSlicePitch + uint64_t(by) * g_Push.srcRowPitch +
+                         uint64_t(bx) * blockBytes;
+    const uint texelBytes = format == 4 ? 1 : format == 5 ? 2 : 4;
+    const uint64_t dst = g_Push.dst + uint64_t(bz) * g_Push.dstSlicePitch +
+                         uint64_t(by * 4) * g_Push.dstRowPitch + uint64_t(bx) * 4 * texelBytes;
+
+    if (format == 4 || format == 5) {
+        uint r[4], g[4];
+        DecodeAlpha(Load(src), Load(src + 4), r);
+        if (format == 4) {
+            for (uint y = 0; y < 4; ++y)
+                Store(dst + uint64_t(y) * g_Push.dstRowPitch, r[y]);
+            return;
+        }
+        DecodeAlpha(Load(src + 8), Load(src + 12), g);
+        for (uint y = 0; y < 4; ++y) {
+            // Two RG8 texels per word.
+            const uint lo = (r[y] & 0xFF) | ((g[y] & 0xFF) << 8) | (((r[y] >> 8) & 0xFF) << 16) | (((g[y] >> 8) & 0xFF) << 24);
+            const uint hi = ((r[y] >> 16) & 0xFF) | (((g[y] >> 16) & 0xFF) << 8) | ((r[y] >> 24) << 16) | ((g[y] >> 24) << 24);
+            const uint64_t row = dst + uint64_t(y) * g_Push.dstRowPitch;
+            Store(row, lo);
+            Store(row + 4, hi);
+        }
+        return;
+    }
+
+    // BC1 colour block: at 0 for BC1, after the 8 alpha bytes for BC2 and BC3.
+    const uint64_t color = format == 1 ? src : src + 8;
+    uint4 palette[4];
+    ColorPalette(Load(color), format != 1, palette);
+    const uint indices = Load(color + 4);
+    uint alpha[4];
+    if (format == 3) {
+        DecodeAlpha(Load(src), Load(src + 4), alpha);
+    } else if (format == 2) {
+        // 4 bits per texel, a row of four in each 16 bits.
+        const uint w0 = Load(src), w1 = Load(src + 4);
+        for (uint y = 0; y < 4; ++y) {
+            const uint bits = ((y < 2 ? w0 : w1) >> (16 * (y & 1))) & 0xFFFF;
+            uint row = 0;
+            for (uint x = 0; x < 4; ++x)
+                row |= ((bits >> (4 * x)) & 15) * 17 << (8 * x);
+            alpha[y] = row;
+        }
+    }
+    for (uint y = 0; y < 4; ++y) {
+        const uint64_t row = dst + uint64_t(y) * g_Push.dstRowPitch;
+        for (uint x = 0; x < 4; ++x) {
+            const uint4 c = palette[(indices >> (2 * (y * 4 + x))) & 3];
+            const uint a = format == 1 ? c.a : (alpha[y] >> (8 * x)) & 0xFF;
+            Store(row + 4 * x, c.r | (c.g << 8) | (c.b << 16) | (a << 24));
+        }
+    }
+}
