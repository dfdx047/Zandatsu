+void DecodeBcRow(TexelConversion conversion, const uint8_t *src, uint8_t *dst, uint32_t count,
+                 uint32_t dst_row_pitch) {
+  const uint32_t format = BcDecodeFormat(conversion);
+  const uint32_t block_bytes = (format == 1 || format == 4) ? 8 : 16;
+  const uint32_t texel_bytes = format == 4 ? 1 : format == 5 ? 2 : 4;
+  for (uint32_t b = 0; b < count; ++b, src += block_bytes) {
+    uint8_t *out = dst + size_t(b) * 4 * texel_bytes;
+    if (format == 4 || format == 5) {
+      uint8_t r[16], g[16];
+      DecodeAlphaBlock(src, r);
+      if (format == 5)
+        DecodeAlphaBlock(src + 8, g);
+      for (uint32_t i = 0; i < 16; ++i) {
+        uint8_t *texel = out + size_t(i / 4) * dst_row_pitch + (i % 4) * texel_bytes;
+        texel[0] = r[i];
+        if (format == 5)
+          texel[1] = g[i];
+      }
+      continue;
+    }
+    uint32_t color[16];
+    DecodeColorBlock(format == 1 ? src : src + 8, format != 1, color);
