+TextureFormatInfo DecodedBcInfo(const TextureFormatInfo &info) {
+  using F = plume::RenderFormat;
+  if (!info.compressed)
+    return info;
+  TextureFormatInfo out = info;
+  uint32_t texel_bytes = 4;
+  switch (info.host) {
+  case F::BC1_UNORM:
+    out.conversion = TexelConversion::BC1;
+    out.host = F::R8G8B8A8_UNORM;
+    break;
+  case F::BC2_UNORM:
+    out.conversion = TexelConversion::BC2;
+    out.host = F::R8G8B8A8_UNORM;
+    break;
+  case F::BC3_UNORM:
+    out.conversion = TexelConversion::BC3;
+    out.host = F::R8G8B8A8_UNORM;
+    break;
+  case F::BC4_UNORM:
+    out.conversion = TexelConversion::BC4;
+    out.host = F::R8_UNORM;
+    texel_bytes = 1;
+    break;
+  case F::BC5_UNORM:
+    out.conversion = TexelConversion::BC5;
+    out.host = F::R8G8_UNORM;
+    texel_bytes = 2;
+    break;
+  default:
+    return info;
+  }
+  out.host_block_bytes = info.block_size * info.block_size * texel_bytes;
+  out.compressed = false;
+  out.decoded_blocks = true;
+  return out;
