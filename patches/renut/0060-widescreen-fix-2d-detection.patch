Zandatsu (Android, Phase 5D+): prevent Ultrawide from flipping to 16:9 during boss attacks/heavy effects:
- Increase kMaxWidened from 32 to 128 so chapter/boss targets never overflow.
- Count draws to any full-width (GuestScreenWidth x 720) surface, not only IsWidenedSurface.
- Gate captures-based 2D menu detection to widened < 500 and require 6 consecutive frames.

--- a/app/src/renut_engine/gpu/guest/sa2_screen.cpp
+++ b/app/src/renut_engine/gpu/guest/sa2_screen.cpp
@@ -56,7 +56,8 @@
 
 namespace {
 // The render targets WidenScreenSurface widened (the scene's; not the device's back buffer, already the screen's).
-constexpr int kMaxWidened = 32;
+// Zandatsu (renut/0060): 128 slots (32 overflowed across chapters/boss phases, causing false 16:9 flips).
+constexpr int kMaxWidened = 128;
 u32 g_widened[kMaxWidened] = {};
 int g_widened_count = 0;
 }  // namespace
--- a/app/src/renut_engine/gpu/render/draw.cpp
+++ b/app/src/renut_engine/gpu/render/draw.cpp
@@ -4705,11 +4705,11 @@
