+  // Zandatsu (renut/0039, 0060): count draws to widened targets OR full-width targets (so boss effects drawing
+  // directly to a GuestScreenWidth() surface don't drop widened count to 0 and flip the screen to 16:9).
   if (GuestScreenWidth() > 1280) {
     const HostSurface *first = targets.color_count && targets.colors[0] ? targets.colors[0] : targets.depth;
-    if (first && IsWidenedSurface(first->guest_va))
