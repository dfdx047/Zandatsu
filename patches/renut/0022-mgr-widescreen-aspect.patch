 namespace renut::gpu {
 
+namespace {
+// SwordMan (2026-10-26): the width the game created its device with (SetGuestScreenWidth), 0 until then.
+std::atomic<uint32_t> g_width{0};
+}  // namespace
+
 uint32_t GuestScreenWidth() {
-  return 1280;
+  const uint32_t width = g_width.load(std::memory_order_acquire);
+  return width ? width : 1280;
+}
+
+void SetGuestScreenWidth(uint32_t width) {
+  g_width.store(width, std::memory_order_release);
+}
+
+bool WidenScreenTexture(u32 header_va, uint32_t source_width, uint32_t source_height) {
+  const uint32_t width = GuestScreenWidth();
+  if (width <= 1280 || source_width != width || source_height != 720)
+    return false;
+  auto *texture = GuestPtr<d3d::BaseTexture>(header_va);
+  if (!texture)
+    return false;
+  d3d::TextureFetchConstant &fetch = texture->Format;
+  const uint32_t size = fetch.dword[2].get();
+  if ((size & 0x1FFF) + 1 != 1280 || ((size >> 13) & 0x1FFF) + 1 != 720)
+    return false;
+  // XGSetTextureHeader's fields: the pitch in 32-texel units (dword 0, bits 22-30), width - 1 (dword 2, bits 0-12).
+  // The game's memory behind it stays a 1280 one: the texels live in the host texture, which follows the header.
+  const uint32_t pitch = (width + 31) / 32;
+  fetch.dword[0] = (fetch.dword[0].get() & ~(0x1FFu << 22)) | (pitch << 22);
+  fetch.dword[2] = (size & ~0x1FFFu) | (width - 1);
+  RGPU_INFO("Widescreen: texture {:08X} 1280x720 -> {}x720", header_va, width);
+  return true;
 }
 
 } // namespace renut::gpu
+
+namespace renut::gpu {
+
+namespace {
+// The render targets WidenScreenSurface widened (the scene's; not the device's back buffer, already the screen's).
+constexpr int kMaxWidened = 32;
+u32 g_widened[kMaxWidened] = {};
+int g_widened_count = 0;
+}  // namespace
+
+bool IsWidenedSurface(u32 surface_va) {
+  for (int i = 0; i < g_widened_count; ++i)
+    if (g_widened[i] == surface_va)
+      return true;
+  return false;
+}
+
+namespace {
+std::atomic<uint32_t> g_widened_draws{0};
+std::atomic<bool> g_frame_2d{false};
+}  // namespace
+
+void NoteWidenedDraw() {
+  g_widened_draws.fetch_add(1, std::memory_order_relaxed);
+}
+
+uint32_t TakeWidenedDraws() {
+  return g_widened_draws.exchange(0, std::memory_order_relaxed);
+}
+
+void SetFrame2D(bool frame_2d) {
+  g_frame_2d.store(frame_2d, std::memory_order_relaxed);
+}
+
+bool Frame2D() {
+  return g_frame_2d.load(std::memory_order_relaxed);
+}
+
+bool WidenScreenSurface(u32 surface_va) {
+  const uint32_t width = GuestScreenWidth();
+  if (width <= 1280)
+    return false;
+  auto *desc = GuestPtr<d3d::SurfaceDesc>(surface_va + sizeof(d3d::Resource));
+  if (!desc)
+    return false;
+  const uint32_t size = desc->Size.get();
+  if (d3d::SurfaceWidth(size) != 1280 || d3d::SurfaceHeight(size) != 720 || (desc->SurfaceInfo.get() & 0x3FFF) != 1280)
+    return false;
+  desc->Size = (size & ~(0x3FFFu << 18)) | ((width - 1) << 18);
+  desc->SurfaceInfo = (desc->SurfaceInfo.get() & ~0x3FFFu) | width;
+  if (!IsWidenedSurface(surface_va) && g_widened_count < kMaxWidened)
+    g_widened[g_widened_count++] = surface_va;
+  static uint32_t logged = 0;
+  if (logged++ < 16)
+    RGPU_INFO("Widescreen: surface {:08X} 1280x720 -> {}x720", surface_va, width);
+  return true;
+}
+
+}  // namespace renut::gpu
