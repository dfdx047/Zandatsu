Zandatsu (Android, Mali Phase 5B++): compact vertex shader outputs from 29 (Location 0..28, 120 components)
to 14 (Location 0..13/14, <= 56 components) so every MGR shader fits within Mali's Vulkan limit
(maxVertexOutputComponents = 64). Fixes deterministic SIGSEGV at 0x40 in libGLES_mali.so
cmpbe_v2_compile_multiple_shaders (vs 937F4E320E232406 / ps 1995A5D0668660EE, issues #47, #83, #101)
and cuts Mali tiler varying bandwidth in half across all 298 vertex shaders.

--- a/app/thirdparty/reblue-XenosRecomp/XenosRecomp/shader_recompiler.cpp
+++ b/app/thirdparty/reblue-XenosRecomp/XenosRecomp/shader_recompiler.cpp
@@ -150,23 +150,28 @@
     { DeclUsage::TexCoord, 7 },
     { DeclUsage::TexCoord, 8 },
     { DeclUsage::TexCoord, 9 },
+    { DeclUsage::Color, 0 },
+    { DeclUsage::Color, 1 },
+};
+
+// Zandatsu (renut/0056): Mali GPUs have maxVertexOutputComponents = 64 (16 vec4 locations max).
+// Declaring all 29 interpolators (Location 0..28 = 120 components) violates Vulkan limits on Mali,
+// wastes tiler varying bandwidth, and triggers SIGSEGV at 0x40 in libGLES_mali.so
+// cmpbe_v2_compile_multiple_shaders (issues #47, #83, #101). None of MGR's 904 pixel shaders read
+// these slots, so keep them as local variables inside main() (dead-eliminated by DXC).
+static constexpr std::pair<DeclUsage, size_t> UNUSED_INTERPOLATORS[] =
+{
     { DeclUsage::TexCoord, 10 },
     { DeclUsage::TexCoord, 11 },
     { DeclUsage::TexCoord, 12 },
     { DeclUsage::TexCoord, 13 },
     { DeclUsage::TexCoord, 14 },
     { DeclUsage::TexCoord, 15 },
-    { DeclUsage::Color, 0 },
-    { DeclUsage::Color, 1 },
 #ifdef RENUT_RECOMP
-    // mgr-nx-deko: MGR passes additional colour interpolators through COLOR2..5.
     { DeclUsage::Color, 2 },
     { DeclUsage::Color, 3 },
     { DeclUsage::Color, 4 },
     { DeclUsage::Color, 5 },
-#endif
-#ifdef RENUT_RECOMP
-    // N&B also passes vectors through NORMAL/TANGENT/BINORMAL interpolators.
     { DeclUsage::Normal, 0 },
     { DeclUsage::Normal, 1 },
     { DeclUsage::Normal, 2 },
@@ -2554,6 +2559,8 @@
 
         for (auto& [usage, usageIndex] : INTERPOLATORS)
             println("\to{}{} = float4(0.0, 0.0, 0.0, 1.0);", USAGE_VARIABLES[uint32_t(usage)], usageIndex);
+        for (auto& [usage, usageIndex] : UNUSED_INTERPOLATORS)
+            println("\tfloat4 o{}{} = float4(0.0, 0.0, 0.0, 1.0);", USAGE_VARIABLES[uint32_t(usage)], usageIndex);
     #ifdef RENUT_RECOMP
         out += "\toPointCoord = 0.0;\n";
         out += "\toPointSize = 0.0;\n";
@@ -2561,6 +2568,11 @@
 
         out += "\n";
     }
+    else
+    {
+        for (auto& [usage, usageIndex] : UNUSED_INTERPOLATORS)
+            println("\tfloat4 i{}{} = float4(0.0, 0.0, 0.0, 1.0);", USAGE_VARIABLES[uint32_t(usage)], usageIndex);
+    }
 
     for (size_t i = 0; i < std::size(printedRegisters); i++)
     {
