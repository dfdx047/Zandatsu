+  // proprio de 60 Hz do pacing escorrega contra ela e o video a 30 quadros/s ficava 2, 3, 5 ou 6 refreshes em vez de 4
+  // (24% dos quadros: tremido). Aqui o vsync da tela vem do AChoreographer, num looper so desta thread; o periodo vem
+  // do callback de taxa de refresh (API 30) ou, sem ele, da media dos intervalos.
+  ALooper_prepare(0);
+  AChoreographer *choreographer = AChoreographer_getInstance();
+  if (!choreographer) {
+    REXLOG_WARN("[display] sem AChoreographer: o limitador de frames fica com o timer proprio (banjo_display_sync)");
+    return;
+  }
+  g_phase.store(uint64_t(REXCVAR_GET(banjo_display_phase_us)) * 1000, std::memory_order_relaxed);
+  static std::atomic<int64_t> s_hint{0};
+  AChoreographer_registerRefreshRateCallback(
+      choreographer, [](int64_t period_ns, void *) { s_hint.store(period_ns, std::memory_order_relaxed); }, nullptr);
+  struct Ctx {
+    AChoreographer *choreographer;
+    uint64_t last = 0;
+    double period = 0.0;
+  };
+  static Ctx ctx{choreographer};
+  static AChoreographer_frameCallback64 on_frame = [](int64_t frame_ns, void *data) {
+    auto *c = static_cast<Ctx *>(data);
+    AChoreographer_postFrameCallback64(c->choreographer, on_frame, data);
+    const uint64_t now = uint64_t(frame_ns);  // CLOCK_MONOTONIC, o mesmo do steady_clock
+    const int64_t hint = s_hint.load(std::memory_order_relaxed);
+    if (hint > 0) {
+      c->period = double(hint);
+    } else if (c->last && now > c->last) {
+      const double gap = double(now - c->last);
+      if (c->period <= 0.0)
+        c->period = gap;
+      const double refreshes = std::max(1.0, std::round(gap / c->period));
+      if (refreshes <= 4.0)
+        c->period += (gap / refreshes - c->period) / 16.0;
+    }
+    c->last = now;
+    if (c->period <= 0.0)
+      return;
+    g_period.store(uint64_t(c->period), std::memory_order_relaxed);
+    g_last_vsync.store(now, std::memory_order_release);
+    if (!g_running.load(std::memory_order_relaxed)) {
+      REXLOG_INFO("[display] o limitador de frames segue o vsync da tela (banjo_display_sync, AChoreographer), "
+                  "refresh {:.3f} ms, fase fixa {} us (banjo_display_phase_us)",
+                  c->period / 1e6, REXCVAR_GET(banjo_display_phase_us));
+      g_running.store(true, std::memory_order_release);
+    }
+    AtRefresh(now, uint64_t(c->period));
+  };
+  AChoreographer_postFrameCallback64(choreographer, on_frame, &ctx);
+  for (;;)
+    ALooper_pollOnce(-1, nullptr, nullptr, nullptr);
 #endif
