 // (Mali): decoded on the GPU by bc_decode_cs when uploaded (compute) or on the CPU (cpu). auto = native where the
 // device has BC, compute elsewhere; the Renut check (src/renut_glue.cpp) also picks compute for RADV on Xclipse,
 // whose BC4/BC5 are emulated by the driver. native/compute/cpu force one (compute and cpu work on any device).
+#if defined(__ANDROID__)
+namespace plume { void SetAndroidAfrc(bool enabled); }
+#endif
+REXCVAR_DEFINE_STRING(swordman_renut_afrc, "off", "SwordMan",
+                      "Renut: AFRC (VK_EXT_image_compression_control) nos render targets de cor em Mali Valhall+; "
+                      "desligado por padrao (na Mali-G57 desliga AFBC); on = testar em Mali Valhall v10+ (G615/G715/G720)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
 REXCVAR_DEFINE_STRING(swordman_renut_bc_astc, "auto", "SwordMan",
                       "Renut: transcodifica BC1 para ASTC 4x4 em GPU compute (4x menos banda na Mali); "
