+// Zandatsu (renut/0032, as piscadas do widescreen): a copia da tela feita a 1280 e a mesma com a largura da tela
+// (WidenScreenTexture) so diferem na largura. Largar o que o resolve escreveu faz um frame a partir da memoria do jogo.
+bool OnlyWidened(const u32 a[6], const u32 b[6]) {
+  constexpr u32 kDimensionMask = 0x600u;
+  constexpr u32 kWidthMask = 0x1FFFu;
+  const u32 narrow = 1280u - 1u, wide = GuestScreenWidth() - 1u;
+  if (wide <= narrow || a[1] != b[1] || (a[2] & ~kWidthMask) != (b[2] & ~kWidthMask) ||
+      (a[5] & kDimensionMask) != (b[5] & kDimensionMask))
+    return false;
+  const u32 wa = a[2] & kWidthMask, wb = b[2] & kWidthMask;
+  return (wa == narrow && wb == wide) || (wa == wide && wb == narrow);
+}
