+namespace {
+std::atomic<uint64_t> g_wait_us[2]{}, g_fence_waits{0};
+}
+
+void NoteGameThreadWait(int cause, double ms) {
+  g_wait_us[cause & 1].fetch_add(uint64_t(ms * 1000.0), std::memory_order_relaxed);
+  if (cause == 1) g_fence_waits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void TakeGameThreadWaits(double &swap_ms, double &fence_ms, uint64_t &fence_waits) {
+  swap_ms = g_wait_us[0].exchange(0, std::memory_order_relaxed) / 1000.0;
+  fence_ms = g_wait_us[1].exchange(0, std::memory_order_relaxed) / 1000.0;
+  fence_waits = g_fence_waits.exchange(0, std::memory_order_relaxed);
+}
+
