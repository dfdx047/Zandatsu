+
+bool DeferResolveMipsLocked(HostTexture *texture, const plume::RenderRect &rect) {
+  static const bool lazy = REXCVAR_GET(swordman_renut_resolve_mips_lazy);
+  if (!lazy || !texture)
+    return false;
+  HostTexture &t = *texture;
+  if (t.mips_pending) {
+    t.mips_rect = plume::RenderRect(std::min(t.mips_rect.left, rect.left), std::min(t.mips_rect.top, rect.top),
+                                    std::max(t.mips_rect.right, rect.right), std::max(t.mips_rect.bottom, rect.bottom));
+  } else {
+    t.mips_pending = true;
+    t.mips_rect = rect;
+    ++g_texture_epoch;  // the binds' sampler words change (LodScaleForBindLocked)
+  }
+  return true;
+}
+
+void SetBindTargetSizeLocked(uint32_t width, uint32_t height) {
+  g_bind_target_width = width;
+  g_bind_target_height = height;
+}
+
+bool TakeBindMipsDrawnLocked() { return std::exchange(g_bind_mips_drawn, false); }
+bool TakeBindNoMemoLocked() { return std::exchange(g_bind_no_memo, false); }
+
+namespace {
+
+// HostTexture::extra_levels reached by a bind's sampler (SamplerSlotLocked): none at all, the levels as they are, or,
+// pending ones, rebuilt first when the draw's target is smaller than the texture (a downsample).
+RenderScale LodScaleForBindLocked(HostTexture &t) {
+  if (!t.extra_levels)
+    return {};
+  if (!t.mips_pending)
+    return t.scale;
+  if (g_bind_target_width >= t.width && g_bind_target_height >= t.height) {
+    g_bind_no_memo = true;
+    return {};
+  }
+  t.mips_pending = false;
+  UpdateResolveMipsLocked(&t, t.mips_rect);
+  g_bind_mips_drawn = true;
+  ++g_texture_epoch;
+  return t.scale;
+}
+
