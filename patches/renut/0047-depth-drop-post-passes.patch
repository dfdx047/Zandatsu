+// Zandatsu (renut/0047): the targets of the framebuffer BindTargets bound last (with g_bound.framebuffer).
+HostSurface *g_bound_depth = nullptr;
+HostSurface *g_bound_colors[d3d::kMaxRenderTargets] = {};
+uint32_t g_bound_color_count = 0;
+
+bool BoundWithDepth(const Targets &t) {
+  if (!g_bound.framebuffer || g_bound_depth != t.depth || g_bound_color_count != t.color_count)
+    return false;
+  for (uint32_t i = 0; i < t.color_count; ++i)
+    if (g_bound_colors[i] != t.colors[i])
+      return false;
+  return true;
+}
