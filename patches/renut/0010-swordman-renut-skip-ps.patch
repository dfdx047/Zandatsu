 // banjo-nx (banjo_renut_diag_gpu_shaders, package 28b): the draw's pass split by its pixel shader and blending.
+// swordman_renut_skip_ps, parsed once.
+bool SkipPixelShader(uint64_t hash) {
+  static const std::unordered_set<uint64_t> skip = [] {
+    std::unordered_set<uint64_t> out;
+    const std::string list = REXCVAR_GET(swordman_renut_skip_ps);
+    size_t start = 0;
+    while (start < list.size()) {
+      size_t end = list.find(',', start);
+      if (end == std::string::npos)
+        end = list.size();
+      const std::string item = list.substr(start, end - start);
+      if (!item.empty())
+        out.insert(std::strtoull(item.c_str(), nullptr, 16));
+      start = end + 1;
+    }
+    if (!out.empty())
+      RGPU_INFO("swordman_renut_skip_ps: {} pixel shaders not drawn", out.size());
+    return out;
+  }();
+  return !skip.empty() && skip.count(hash);
+}
