Zandatsu (Android, Phase 5D++++): widen 1280x720 viewports on GuestScreenWidth()x720 back buffer too.
Fixes Save/Pause menu blur quads covering only 0..1024 (80%) instead of 0..1280 (100%) in Ultrawide.

--- a/app/src/renut_engine/gpu/render/draw.cpp
+++ b/app/src/renut_engine/gpu/render/draw.cpp
@@ -1521,7 +1521,8 @@
   // SwordMan (2026-10-26, widescreen): a widened target's viewport differs from the back buffer's of the same size.
   {
     const HostSurface *first = t.color_count && t.colors[0] ? t.colors[0] : t.depth;
-    key[22] = first && GuestScreenWidth() > 1280 && IsWidenedSurface(first->guest_va) ? 1u : 0u;
+    key[22] = first && GuestScreenWidth() > 1280 &&
+              (IsWidenedSurface(first->guest_va) || (first->width == GuestScreenWidth() && first->height == 720)) ? 1u : 0u;
   }
   key[23] = 0;
