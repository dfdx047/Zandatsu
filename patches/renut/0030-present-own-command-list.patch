+struct OwnPresent {
+  bool built = false, failed = false;
+  std::unique_ptr<plume::RenderCommandList> lists[kFramesInFlight];
+  std::unique_ptr<plume::RenderCommandFence> fences[kFramesInFlight];
+  std::unique_ptr<plume::RenderCommandSemaphore> acquire[kFramesInFlight];
+  bool submitted[kFramesInFlight] = {};
+  uint32_t index = 0;
+};
+OwnPresent g_own;
+
+void WaitOwnPresent(VideoState &s) {
+  for (uint32_t i = 0; i < kFramesInFlight; ++i) {
+    if (g_own.submitted[i]) {
+      s.queue->waitForCommandFence(g_own.fences[i].get());
+      g_own.submitted[i] = false;
+    }
+  }
+}
+
+bool MaliWithThreeDigits(const std::string &name) {
+  if (name.find("Mali") == std::string::npos && name.find("Immortalis") == std::string::npos)
+    return false;
+  for (size_t i = name.find('G'); i != std::string::npos; i = name.find('G', i + 1)) {
+    size_t n = 0;
+    while (i + 1 + n < name.size() && name[i + 1 + n] >= '0' && name[i + 1 + n] <= '9')
+      ++n;
+    if (n >= 3)
+      return true;
+  }
+  return false;
+}
+
+bool UseOwnPresent(VideoState &s) {
+  static const bool wanted = [&] {
+    const std::string mode = REXCVAR_GET(swordman_renut_present_own_list);
+    const bool on = mode == "true" || (mode != "false" && MaliWithThreeDigits(s.device->getDescription().name));
+    RGPU_INFO("swordman_renut_present_own_list = {}: {}", mode, on ? "saida numa lista propria" : "saida na lista do jogo");
+    return on;
+  }();
+  if (!wanted || g_own.failed)
+    return false;
+  if (!g_own.built) {
+    bool ok = true;
+    for (uint32_t i = 0; i < kFramesInFlight && ok; ++i) {
+      g_own.lists[i] = s.queue->createCommandList();
+      g_own.fences[i] = s.device->createCommandFence();
+      g_own.acquire[i] = s.device->createCommandSemaphore();
+      ok = g_own.lists[i] && g_own.fences[i] && g_own.acquire[i];
+    }
+    g_own.built = ok;
+    g_own.failed = !ok;
+    if (!ok)
+      RGPU_ERROR("swordman_renut_present_own_list: sem lista propria, saida na lista do jogo");
+  }
+  return g_own.built;
+}
+#endif
