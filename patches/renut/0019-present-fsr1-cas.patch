@@ -0,0 +1,34 @@
+// Zandatsu (renut/0019): AMD FidelityFX FSR 1 RCAS, the second pass of present_effect = fsr: the intermediate image
+// (EASU's, or the bilinear scan-out's when the frame is not upscaled) sharpened to the output, then the gamma ramp.
+//   textureIndex = the intermediate image (read 1:1); samplerIndex's bits = the sharpness reduction in stops (float,
+//   present_fsr_sharpness_reduction); param0/param1 as present_ps.
+#include "utility.hlsli"
+#include "present_output.hlsli"
+
+#define A_GPU 1
+#define A_HLSL 1
+#include "ffx_a.h"
+
+AF4 FsrRcasLoadF(ASU2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].Load(int3(p, 0));
+}
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+
+#define FSR_RCAS_F 1
+#include "ffx_fsr1.h"
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    AU4 con;
+    FsrRcasCon(con, asfloat(g_Push.samplerIndex));
+    AF3 color;
+    FsrRcasF(color.r, color.g, color.b, AU2(PresentPixel(input.uv)), con);
+    return float4(PresentOutput(color), 1.0);
+}
