+#if defined(__ANDROID__)
+// Zandatsu (renut/0019): present_effect on the scan-out, as the emulated GPU's presenter does it.
+//   fsr: AMD FSR 1. EASU from the frame into an image of the scan-out's size when that is larger than the frame (else
+//        the bilinear scan-out into it), then RCAS from that image to the output.
+//   cas: the bilinear scan-out into that image, then AMD CAS (sharpen only) from it to the output.
+// The game's gamma ramp and the output gamma go with the second pass. bilinear, the diagnostic texture view and a
+// pipeline that failed to build: the single pass of RecordScanOut. The captures (CaptureFrameLocked) stay bilinear.
+constexpr plume::RenderFormat kEffectFormat = plume::RenderFormat::R8G8B8A8_UNORM;  // kSwapChainFormat (video.cpp)
+
+enum class Effect { kBilinear, kFsr, kCas };
+
+struct PresentEffect {
+  bool built = false, failed = false;
+  std::unique_ptr<plume::RenderShader> easu_ps, rcas_ps, cas_ps;
+  std::unique_ptr<plume::RenderPipeline> easu, linear, rcas, cas;  // linear: present_ps into the image
+  std::unique_ptr<plume::RenderTexture> target;
+  std::unique_ptr<plume::RenderTextureView> view;
+  std::unique_ptr<plume::RenderFramebuffer> framebuffer;
+  uint32_t slot = kInvalidDescriptor, width = 0, height = 0;
+};
+PresentEffect g_effect;
+
+std::unique_ptr<plume::RenderPipeline> EffectPipeline(VideoState &s, plume::RenderShader *ps, const char *name) {
+  plume::RenderGraphicsPipelineDesc desc;
+  desc.pipelineLayout = s.utility_layout.get();
+  desc.vertexShader = s.present_vs.get();
+  desc.pixelShader = ps;
+  desc.primitiveTopology = plume::RenderPrimitiveTopology::TRIANGLE_LIST;
+  desc.cullMode = plume::RenderCullMode::NONE;
+  desc.renderTargetCount = 1;
+  desc.renderTargetFormat[0] = kEffectFormat;
+  desc.renderTargetBlend[0] = plume::RenderBlendDesc::Copy();
+  desc.depthTargetFormat = plume::RenderFormat::UNKNOWN;
+  std::unique_ptr<plume::RenderPipeline> pipeline = s.device->createGraphicsPipeline(desc);
+  if (pipeline)
+    pipeline->setName(name);
+  return pipeline;
+}
+
+// Once, the first time an effect is asked for.
+bool BuildEffectPipelines(VideoState &s) {
+  PresentEffect &e = g_effect;
+  if (e.built || e.failed)
+    return e.built;
+  e.easu_ps = CreateHostShader(s.device.get(), RENUT_HOST_SHADER(present_easu_ps), "present_easu_ps");
+  e.rcas_ps = CreateHostShader(s.device.get(), RENUT_HOST_SHADER(present_rcas_ps), "present_rcas_ps");
+  e.cas_ps = CreateHostShader(s.device.get(), RENUT_HOST_SHADER(present_cas_ps), "present_cas_ps");
+  if (e.easu_ps && e.rcas_ps && e.cas_ps && s.present_ps) {
+    e.easu = EffectPipeline(s, e.easu_ps.get(), "renut present: FSR EASU");
+    e.linear = EffectPipeline(s, s.present_ps.get(), "renut present: bilinear to the effect image");
+    e.rcas = EffectPipeline(s, e.rcas_ps.get(), "renut present: FSR RCAS");
+    e.cas = EffectPipeline(s, e.cas_ps.get(), "renut present: CAS");
+  }
+  e.built = e.easu && e.linear && e.rcas && e.cas;
+  e.failed = !e.built;
+  if (e.failed)
+    RGPU_ERROR("present_effect: the FSR/CAS pipelines failed to build; bilinear scan-out");
+  else
+    RGPU_INFO("present_effect: FSR 1 (EASU + RCAS) and CAS pipelines ready");
+  return e.built;
+}
+
+// The image between the passes, the scan-out's size (one bindless slot, kept).
+bool EnsureEffectTarget(VideoState &s, uint32_t w, uint32_t h) {
+  PresentEffect &e = g_effect;
+  if (e.target && e.width == w && e.height == h)
+    return true;
+  if (e.target)
+    detail::WaitAllSubmitted(s);  // the frames in flight still read the old one (only on a resize)
+  e.framebuffer.reset();
+  e.view.reset();
+  e.target.reset();
+  e.width = e.height = 0;
+  plume::RenderTextureDesc desc = plume::RenderTextureDesc::Texture2D(w, h, 1, kEffectFormat);
+  desc.flags |= plume::RenderTextureFlag::RENDER_TARGET;
+  e.target = s.device->createTexture(desc);
+  if (!e.target)
+    return false;
+  e.target->setName("renut present effect image");
+  e.view = e.target->createTextureView(plume::RenderTextureViewDesc::Texture2D(kEffectFormat));
+  const plume::RenderTexture *attachment = e.target.get();
+  e.framebuffer = s.device->createFramebuffer(plume::RenderFramebufferDesc(&attachment, 1));
+  if (e.slot == kInvalidDescriptor)
+    e.slot = Video::AllocateTextureSlotLocked();
+  if (!e.view || !e.framebuffer || e.slot == kInvalidDescriptor) {
+    e.framebuffer.reset();
+    e.view.reset();
+    e.target.reset();
+    return false;
+  }
+  Video::SetTextureSlotLocked(e.slot, e.target.get(), e.view.get());
+  e.width = w;
+  e.height = h;
+  RGPU_INFO("present_effect: effect image {}x{}", w, h);
+  return true;
+}
+
+// Before the output's render pass: the first pass into the effect image. The effect the scan-out then takes
+// (RecordEffectScanOut), bilinear when there is none.
+Effect RecordEffectPrePass(VideoState &s, const PresentImage &image, uint32_t out_w, uint32_t out_h) {
+  const std::string &name = REXCVAR_GET(present_effect);
+  const Effect effect = name == "fsr" ? Effect::kFsr : name == "cas" ? Effect::kCas : Effect::kBilinear;
+  if (effect == Effect::kBilinear || image.gamma > 0.0f)  // image.gamma: banjo_renut_diag_show_texture, as it is
+    return Effect::kBilinear;
+  const uint32_t src_w = image.source_width ? image.source_width : image.width;
+  const uint32_t src_h = image.source_height ? image.source_height : image.height;
+  const FrameFit fit = FitFrame(out_w, out_h, src_w, src_h);
+  const uint32_t w = uint32_t(fit.viewport.width + 0.5f), h = uint32_t(fit.viewport.height + 0.5f);
+  if (!w || !h || !BuildEffectPipelines(s) || !EnsureEffectTarget(s, w, h))
+    return Effect::kBilinear;
+  PresentEffect &e = g_effect;
+  plume::RenderCommandList *cmd = s.command_list;
+  if (image.layout && *image.layout != plume::RenderTextureLayout::SHADER_READ) {
+    cmd->barriers(plume::RenderBarrierStage::GRAPHICS,
+                  plume::RenderTextureBarrier(image.texture, plume::RenderTextureLayout::SHADER_READ));
+    *image.layout = plume::RenderTextureLayout::SHADER_READ;
+  }
+  cmd->barriers(plume::RenderBarrierStage::GRAPHICS,
+                plume::RenderTextureBarrier(e.target.get(), plume::RenderTextureLayout::COLOR_WRITE));
+  cmd->setFramebuffer(e.framebuffer.get());
+  cmd->setViewports(plume::RenderViewport(0.0f, 0.0f, float(w), float(h)));
+  cmd->setScissors(plume::RenderRect(0, 0, int32_t(w), int32_t(h)));
+  cmd->setGraphicsPipelineLayout(s.utility_layout.get());
+  // EASU only upscales: a frame as large as the output or larger goes in bilinear (FSR is then RCAS alone).
+  const bool easu = effect == Effect::kFsr && (float(w) > float(src_w) * fit.visible[0] + 0.5f ||
+                                               float(h) > float(src_h) * fit.visible[1] + 0.5f);
+  cmd->setPipeline(easu ? e.easu.get() : e.linear.get());
+  cmd->setGraphicsDescriptorSet(s.texture_set.get(), 0);
+  cmd->setGraphicsDescriptorSet(s.sampler_set.get(), 1);
+  UtilityPush push{};
+  // As RecordScanOut: the frame's share of the texture, less what the fit trims from its edges.
+  const float frame_u = image.width ? float(src_w) / float(image.width) : 1.0f;
+  const float frame_v = image.height ? float(src_h) / float(image.height) : 1.0f;
+  push.scale[0] = frame_u * fit.visible[0];
+  push.scale[1] = frame_v * fit.visible[1];
+  push.translate[0] = frame_u * (1.0f - fit.visible[0]) * 0.5f;
+  push.translate[1] = frame_v * (1.0f - fit.visible[1]) * 0.5f;
+  push.texture_index = image.descriptor;
+  push.sampler_index = kLinearClampSamplerSlot;
+  // EASU: the output's size; present_ps: no gamma and no ramp here (the second pass applies them).
+  push.param0 = easu ? float(w) : 1.0f;
+  push.param1 = easu ? float(h) : 0.0f;
+  cmd->setGraphicsPushConstants(0, &push, 0, sizeof(push));
+  cmd->drawInstanced(3, 1, 0, 0);
+  cmd->setFramebuffer(nullptr);
+  cmd->barriers(plume::RenderBarrierStage::GRAPHICS,
+                plume::RenderTextureBarrier(e.target.get(), plume::RenderTextureLayout::SHADER_READ));
+  return effect;
+}
+
+// In the output's render pass, in place of RecordScanOut: RCAS or CAS from the effect image, with the gamma ramp.
+void RecordEffectScanOut(VideoState &s, const PresentImage &image, uint32_t out_w, uint32_t out_h, Effect effect) {
+  const PresentEffect &e = g_effect;
+  plume::RenderCommandList *cmd = s.command_list;
+  const uint32_t src_w = image.source_width ? image.source_width : image.width;
+  const uint32_t src_h = image.source_height ? image.source_height : image.height;
+  const plume::RenderViewport vp = FitFrame(out_w, out_h, src_w, src_h).viewport;
+  cmd->setViewports(vp);
+  cmd->setScissors(plume::RenderRect(int32_t(vp.x), int32_t(vp.y), int32_t(vp.x + vp.width),
+                                     int32_t(vp.y + vp.height)));
+  cmd->setGraphicsPipelineLayout(s.utility_layout.get());
+  cmd->setPipeline(effect == Effect::kFsr ? e.rcas.get() : e.cas.get());
+  cmd->setGraphicsDescriptorSet(s.texture_set.get(), 0);
+  cmd->setGraphicsDescriptorSet(s.sampler_set.get(), 1);
+  UtilityPush push{};
+  push.scale[0] = push.scale[1] = 1.0f;
+  push.texture_index = e.slot;
+  // The shaders read the image with Load: the sampler's word carries the sharpness (a float's bits).
+  const float sharpness = effect == Effect::kFsr ? float(REXCVAR_GET(present_fsr_sharpness_reduction))
+                                                 : float(REXCVAR_GET(present_cas_additional_sharpness));
+  push.sampler_index = std::bit_cast<uint32_t>(sharpness);
+  push.param0 = s.output_gamma;
+  const uint32_t ramp_slot =
+      g_gamma.uploaded && g_gamma.slot != kInvalidDescriptor && REXCVAR_GET(sa2_renut_gamma_ramp) ? g_gamma.slot : 0u;
+  push.param1 = std::bit_cast<float>(ramp_slot);
+  cmd->setGraphicsPushConstants(0, &push, 0, sizeof(push));
+  swordman::gpu_markers::Info marker_info;
+  marker_info.kind = swordman::gpu_markers::kScanOut;
+  const uint32_t marker = swordman::gpu_markers::Before(cmd, marker_info);
+  cmd->drawInstanced(3, 1, 0, 0);
+  swordman::gpu_markers::After(cmd, marker);
+}
+#endif
 
