+++ b/app/src/renut_engine/gpu/shaders/host/present_output.hlsli
@@ -0,0 +1,30 @@
+// Zandatsu (renut/0019): the end of the scan-out, shared by present_ps's effect variants (present_rcas_ps,
+// present_cas_ps): the game's display gamma ramp, then the output gamma. The same steps as present_ps.hlsl.
+//   param0 = output gamma exponent (1 = passthrough); param1's bits = the ramp's bindless slot, 0 = none.
+#ifndef PRESENT_OUTPUT_HLSLI
+#define PRESENT_OUTPUT_HLSLI
+
+float3 PresentOutput(float3 color)
+{
+    const uint ramp = asuint(g_Push.param1);
+    if (ramp != 0u)
+    {
+        const uint3 i = uint3(saturate(color) * 255.0 + 0.5);
+        color = float3(g_Textures[NonUniformResourceIndex(ramp)].Load(int3(i.x, 0, 0)).x,
+                       g_Textures[NonUniformResourceIndex(ramp)].Load(int3(i.y, 0, 0)).y,
+                       g_Textures[NonUniformResourceIndex(ramp)].Load(int3(i.z, 0, 0)).z);
+    }
+    if (g_Push.param0 != 1.0)
+        color = pow(saturate(color), g_Push.param0);
+    return color;
+}
+
+// The effect passes read the intermediate image 1:1: uv * its size is the pixel's centre.
+int2 PresentPixel(float2 uv)
+{
+    uint w, h;
+    g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GetDimensions(w, h);
+    return int2(uv * float2(w, h));
+}
+
+#endif
