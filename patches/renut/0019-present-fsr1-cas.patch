@@ -0,0 +1,35 @@
+// Zandatsu (renut/0019): AMD FidelityFX CAS (sharpen only), the second pass of present_effect = cas: the intermediate
+// image (the bilinear scan-out at the output's size) sharpened, then the gamma ramp.
+//   textureIndex = the intermediate image (read 1:1); samplerIndex's bits = the sharpness in 0-1 (float,
+//   present_cas_additional_sharpness); param0/param1 as present_ps.
+#include "utility.hlsli"
+#include "present_output.hlsli"
+
+#define A_GPU 1
+#define A_HLSL 1
+#include "ffx_a.h"
+
+AF3 CasLoad(ASU2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].Load(int3(p, 0)).rgb;
+}
+void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) {}
+
+#include "ffx_cas.h"
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    uint w, h;
+    g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GetDimensions(w, h);
+    AU4 const0, const1;
+    CasSetup(const0, const1, asfloat(g_Push.samplerIndex), AF1(w), AF1(h), AF1(w), AF1(h));
+    AF3 color;
+    CasFilter(color.r, color.g, color.b, AU2(PresentPixel(input.uv)), const0, const1, true);
+    return float4(PresentOutput(color), 1.0);
+}
