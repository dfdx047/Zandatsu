+++ b/app/src/renut_engine/gpu/shaders/host/present_easu_ps.hlsl
@@ -0,0 +1,48 @@
+// Zandatsu (renut/0019): AMD FidelityFX FSR 1 EASU, the first pass of present_effect = fsr when the frame is upscaled
+// (backend/present.cpp, RecordEffectPrePass): the guest frame into the intermediate image of the output's size.
+//   scale/translate = the frame's share of the texture (as present_vs); param0/param1 = the output's width/height.
+#include "utility.hlsli"
+
+#define A_GPU 1
+#define A_HLSL 1
+#include "ffx_a.h"
+
+AF4 FsrEasuRF(AF2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GatherRed(
+        g_Samplers[NonUniformResourceIndex(g_Push.samplerIndex)], p);
+}
+AF4 FsrEasuGF(AF2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GatherGreen(
+        g_Samplers[NonUniformResourceIndex(g_Push.samplerIndex)], p);
+}
+AF4 FsrEasuBF(AF2 p)
+{
+    return g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GatherBlue(
+        g_Samplers[NonUniformResourceIndex(g_Push.samplerIndex)], p);
+}
+
+#define FSR_EASU_F 1
+#include "ffx_fsr1.h"
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    uint w, h;
+    g_Textures[NonUniformResourceIndex(g_Push.textureIndex)].GetDimensions(w, h);
+    const float2 size = float2(w, h);
+    const float2 view = g_Push.scale * size;  // the frame, in source texels
+    AU4 con0, con1, con2, con3;
+    FsrEasuCon(con0, con1, con2, con3, view.x, view.y, size.x, size.y, g_Push.param0, g_Push.param1);
+    // The frame starts at translate (the fit's trim): moved in source texels.
+    con0.zw = asuint(asfloat(con0.zw) + g_Push.translate * size);
+    AF3 color;
+    FsrEasuF(color, AU2(input.position.xy), con0, con1, con2, con3);
+    return float4(color, 1.0);
+}
