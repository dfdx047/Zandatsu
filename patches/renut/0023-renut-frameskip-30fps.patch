+namespace {
+std::atomic<bool> g_frame_skipped{false};
+uint32_t g_frame_skip_counter = 0;  // so a thread do jogo (o Swap)
+}  // namespace
+
+bool FrameSkipped() { return g_frame_skipped.load(std::memory_order_relaxed); }
+
+void AdvanceFrameSkip() {
+  const std::string text = rex::cvar::GetFlagByName("dbz3_frameskip");
+  const int skip = text.empty() ? 0 : std::clamp(std::atoi(text.c_str()), 0, 3);
+  ++g_frame_skip_counter;
+  g_frame_skipped.store(skip > 0 && g_frame_skip_counter % uint32_t(skip + 1) != 0, std::memory_order_relaxed);
+}
