+//============================================================================================================
+//                  Copyright (c) 2025, Qualcomm Innovation Center, Inc. All rights reserved.
+//                              SPDX-License-Identifier: BSD-3-Clause
+//============================================================================================================
+// Zandatsu (renut/0058): Qualcomm Snapdragon Game Super Resolution (SGSR1 Edge Direction), single-pass FP16
+// spatial upscaler + edge-directed sharpener for Renut scan-out (present_effect = sgsr).
+// Runs directly in the swapchain pass with zero intermediate texture or extra render pass.
+#include "utility.hlsli"
+#include "present_output.hlsli"
+
+static const min16float kEdgeThreshold = min16float(8.0 / 255.0);
+static const min16float kEdgeSharpness = min16float(2.0);
+
+min16float FastLanczos2(min16float x)
+{
+    min16float wA = x - min16float(4.0);
+    min16float wB = x * wA - wA;
+    wA *= wA;
+    return wB * wA;
+}
+
+min16float2 WeightY(min16float dx, min16float dy, min16float c, min16float3 data)
+{
+    min16float std = data.x;
+    min16float2 dir = data.yz;
+    min16float edgeDis = (dx * dir.y) + (dy * dir.x);
+    min16float x = (dx * dx + dy * dy) +
+                   (edgeDis * edgeDis) * (saturate(c * c * std) * min16float(0.7) - min16float(1.0));
+    min16float w = FastLanczos2(x);
+    return min16float2(w, w * c);
+}
+
+min16float2 EdgeDirection(min16float4 left, min16float4 right)
+{
+    min16float rxLz = right.x - left.z;
+    min16float rwLy = right.w - left.y;
+    min16float2 delta = min16float2(rxLz + rwLy, rxLz - rwLy);
+    min16float lengthInv = rsqrt(delta.x * delta.x + delta.y * delta.y + min16float(3.075740e-05));
+    return delta * lengthInv;
+}
+
+struct PSInput
+{
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+float4 main(PSInput input) : SV_Target0
+{
+    Texture2D tex = g_Textures[g_Push.textureIndex];
+    SamplerState samp = g_Samplers[g_Push.samplerIndex];
+
+    uint w, h;
+    tex.GetDimensions(w, h);
+    const float2 texSize = float2(w, h);
+    const float2 texSizeInv = 1.0 / texSize;
+
+    min16float3 color = min16float3(tex.SampleLevel(samp, input.uv, 0.0).rgb);
+
+    const float2 imgCoord = input.uv * texSize + float2(-0.5, 0.5);
+    const float2 imgCoordPixel = floor(imgCoord);
+    float2 coord = imgCoordPixel * texSizeInv;
+    const min16float2 pl = min16float2(imgCoord - imgCoordPixel);
+
+    min16float4 left = min16float4(tex.GatherGreen(samp, coord));
+    const min16float edgeVote = abs(left.z - left.y) + abs(color.g - left.y) + abs(color.g - left.z);
+    if (edgeVote > kEdgeThreshold)
+    {
+        coord.x += texSizeInv.x;
+        min16float4 right = min16float4(tex.GatherGreen(samp, coord + float2(texSizeInv.x, 0.0)));
+        min16float4 upDown;
+        upDown.xy = min16float2(tex.GatherGreen(samp, coord + float2(0.0, -texSizeInv.y)).wz);
+        upDown.zw = min16float2(tex.GatherGreen(samp, coord + float2(0.0, texSizeInv.y)).yx);
+
+        const min16float mean = (left.y + left.z + right.x + right.w) * min16float(0.25);
+        left -= mean;
+        right -= mean;
+        upDown -= mean;
+        const min16float centerY = color.g - mean;
+
+        const min16float sum =
+            abs(left.x) + abs(left.y) + abs(left.z) + abs(left.w) +
+            abs(right.x) + abs(right.y) + abs(right.z) + abs(right.w) +
+            abs(upDown.x) + abs(upDown.y) + abs(upDown.z) + abs(upDown.w);
+        const min16float sumMean = min16float(10.14185) / max(sum, min16float(1e-4));
+        const min16float std = sumMean * sumMean;
+        const min16float3 data = min16float3(std, EdgeDirection(left, right));
+
+        min16float2 aWY = WeightY(pl.x, pl.y + min16float(1.0), upDown.x, data);
+        aWY += WeightY(pl.x - min16float(1.0), pl.y + min16float(1.0), upDown.y, data);
+        aWY += WeightY(pl.x - min16float(1.0), pl.y - min16float(2.0), upDown.z, data);
+        aWY += WeightY(pl.x, pl.y - min16float(2.0), upDown.w, data);
+        aWY += WeightY(pl.x + min16float(1.0), pl.y - min16float(1.0), left.x, data);
+        aWY += WeightY(pl.x, pl.y - min16float(1.0), left.y, data);
+        aWY += WeightY(pl.x, pl.y, left.z, data);
+        aWY += WeightY(pl.x + min16float(1.0), pl.y, left.w, data);
+        aWY += WeightY(pl.x - min16float(1.0), pl.y - min16float(1.0), right.x, data);
+        aWY += WeightY(pl.x - min16float(2.0), pl.y - min16float(1.0), right.y, data);
+        aWY += WeightY(pl.x - min16float(2.0), pl.y, right.z, data);
+        aWY += WeightY(pl.x - min16float(1.0), pl.y, right.w, data);
+
+        const min16float finalY = aWY.y / max(abs(aWY.x), min16float(1e-4));
+        const min16float maxY = max(max(left.y, left.z), max(right.x, right.w));
+        const min16float minY = min(min(left.y, left.z), min(right.x, right.w));
+        min16float deltaY = clamp(kEdgeSharpness * finalY, minY, maxY) - centerY;
+        deltaY = clamp(deltaY, min16float(-23.0 / 255.0), min16float(23.0 / 255.0));
+        color = saturate(color + deltaY);
+    }
+
+    return float4(PresentOutput(float3(color)), 1.0);
+}
