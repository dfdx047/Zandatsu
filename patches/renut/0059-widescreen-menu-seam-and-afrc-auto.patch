Zandatsu (Android, Phase 5D): fix Ultrawide Save/Pause menu 20% unfiltered seam and auto-enable AFRC on Mali Valhall v10+:
- draw.cpp: do not widen destination texture on 1280-column menu captures of the widened back buffer.
- video.cpp: default swordman_renut_afrc = auto (enables AFRC on 3-digit Mali/Immortalis/G1* = -15% GPU ms on G615; off on G57).

--- a/app/src/renut_engine/gpu/render/draw.cpp
+++ b/app/src/renut_engine/gpu/render/draw.cpp
@@ -5997,10 +5997,14 @@
     source_rect = &widened_rect;
   }
   HostSurface *surface = GetHostSurfaceLocked(source_va);
-  // Zandatsu (renut/0046, 12/11): the console's 1280 columns of the back buffer (the screen's width already, not a
-  // WidenScreenSurface target) copied for a menu's background: that frame is 2D (guest/widescreen.h).
-  if (source_rect && source_rect->x1 == 0 && source_rect->x2 == 1280 && GuestScreenWidth() > 1280 && surface &&
-      !surface->depth && surface->width == GuestScreenWidth() && surface->height == 720)
+  // Zandatsu (renut/0046, 0059): the console's 1280 columns of the back buffer (the screen's width already, not a
+  // WidenScreenSurface target) copied for a menu's background: that frame is 2D (guest/widescreen.h), and the
+  // destination texture must NOT be widened to GuestScreenWidth() or u=0..1 squishes the blur into 0..1024 (80%)
+  // and exposes unfiltered/stale columns on the right 20%.
+  const bool menu_capture = source_rect && source_rect->x1 == 0 && source_rect->x2 == 1280 &&
+                            GuestScreenWidth() > 1280 && surface && !surface->depth &&
+                            surface->width == GuestScreenWidth() && surface->height == 720;
+  if (menu_capture)
     NoteScreenCapture();
   if (swordman::frame_dump::On() && surface && swordman::frame_dump::Active(TextureFrameLocked())) {
     const ClearRect r = source_rect ? *source_rect : ClearRect{0, 0, -1, -1};
@@ -6038,8 +6042,8 @@
     return src.x2 > src.x1 && src.y2 > src.y1;
   };
 
-  // SwordMan (2026-10-26, widescreen): the game's 1280x720 copies of the screen follow the wider screen.
-  if (surface && dest_texture_va && dest_level == 0)
+  // SwordMan (2026-10-26, widescreen; renut/0059): widen 1280x720 screen copies, except 1280-col menu captures.
+  if (surface && dest_texture_va && dest_level == 0 && !menu_capture)
     WidenScreenTexture(dest_texture_va, surface->width, surface->height);
   if (surface && dest_texture_va) {
     if (surface->depth) {
