+#if defined(__ANDROID__)
+namespace {
+plume::RenderWindow g_swap_chain_window = nullptr;  // the ANativeWindow the swapchain presents to
+uint32_t g_swap_chain_images = 0;
+} // namespace
+
+bool FollowAndroidWindow(VideoState &s, bool vsync) {
+  plume::RenderWindow window = nullptr;
+  if (!GetNativeRenderWindow(window) || !window) {
+    s.swap_framebuffers.clear();  // background: no surface to present to
+    return false;
+  }
+  if (window == g_swap_chain_window && s.swap_chain)
+    return true;
+  if (s.list_open)
+    SubmitAndAdvance(s, nullptr, nullptr);
+  WaitAllSubmitted(s);
+  s.swap_framebuffers.clear();
+  s.present_semaphores.clear();
+  s.swap_chain.reset();
+  g_swap_chain_window = window;
+  plume::RenderSwapChainDesc swap_desc(window, kSwapChainFormat, g_swap_chain_images, false, kFramesInFlight);
+  s.swap_chain = s.queue->createSwapChain(swap_desc);
+  s.swap_chain->setVsyncEnabled(vsync);
+  if (!s.swap_chain->resize() || s.swap_chain->isEmpty() || !BuildSwapChainTargets(s)) {
+    RGPU_ERROR("Swapchain: no swapchain for the new window yet");
+    s.swap_framebuffers.clear();
+    g_swap_chain_window = nullptr;  // tried again at the next present
+    return false;
+  }
+  RGPU_INFO("Swapchain: recreated for the new window ({}x{})", s.swap_chain->getWidth(), s.swap_chain->getHeight());
+  return true;
+}
+#endif
