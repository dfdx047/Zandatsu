+  const std::filesystem::path live = folder / "renut_compiling.bin";
+  // A lista: "<sessoes> <id>" por linha.
+  if (std::ifstream in(g_bad_path); in) {
+    std::string line;
+    while (std::getline(in, line)) {
+      const size_t sp = line.find(' ');
+      if (sp == std::string::npos)
+        continue;
+      g_seen[line.substr(sp + 1)] = uint32_t(std::strtoul(line.c_str(), nullptr, 10));
+    }
+  }
+  // O que a sessao anterior deixou a meio.
+  uint32_t unfinished = 0;
+  if (std::ifstream in(live, std::ios::binary); in) {
+    std::vector<char> bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    for (size_t at = 0; at + kSlotBytes <= bytes.size(); at += kSlotBytes) {
+      const char *slot = bytes.data() + at;
+      if (slot[0] != 'v')
+        continue;
