+      const uint32_t times = ++g_seen[id];
+      ++unfinished;
+      RGPU_WARN("[renut] a sessao anterior terminou durante a compilacao do pipeline {} ({}a vez){}", id, times,
+                times >= 2 ? "; bloqueado (cache/renut_bad_pipelines.txt)" : "");
+    }
+  }
+  if (unfinished) {
+    if (std::ofstream out(g_bad_path, std::ios::trunc); out) {
+      for (const auto &[id, times] : g_seen)
+        out << times << ' ' << id << '\n';
+    }
+  }
+  const std::string mode = REXCVAR_GET(swordman_renut_serial_pipelines);
+  const std::string name = State().device ? State().device->getDescription().name : std::string();
+  const bool powervr = name.find("PowerVR") != std::string::npos;
+  g_serial = mode == "true" || (mode == "auto" && (powervr || !g_seen.empty()));
+  RGPU_INFO("[renut] swordman_renut_serial_pipelines = {}: {}", mode,
+            g_serial ? (powervr ? "um pipeline de cada vez (PowerVR)"
+                                : "um pipeline de cada vez (o driver ja caiu a compilar)")
+                     : "em paralelo");
+  if (REXCVAR_GET(swordman_renut_compile_guard)) {
+    g_fd = ::open(live.c_str(), O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (g_fd >= 0) {
+      const std::vector<char> zeros(size_t(kSlots) * kSlotBytes, 0);
+      if (::pwrite(g_fd, zeros.data(), zeros.size(), 0) != ssize_t(zeros.size())) {
+        ::close(g_fd);
+        g_fd = -1;
+      }
+    }
+  }
+#endif
+}
+
+bool Blocked(const std::string &id) {
+  std::lock_guard lock(g_blocked_mutex);
+  const auto it = g_seen.find(id);
+  return it != g_seen.end() && it->second >= 2;
+}
+
+void Mark(const std::string *id) {
+#if !defined(_WIN32)
+  if (g_fd < 0)
+    return;
+  if (t_slot == -2) {
+    const uint32_t slot = g_next_slot.fetch_add(1, std::memory_order_relaxed);
+    t_slot = slot < kSlots ? int(slot) : -1;
+  }
+  if (t_slot < 0)
+    return;
+  char buf[kSlotBytes] = {};
+  if (id)
+    std::memcpy(buf, id->data(), std::min<size_t>(id->size(), kSlotBytes - 1));
+  (void)::pwrite(g_fd, buf, kSlotBytes, off_t(t_slot) * kSlotBytes);
+#else
+  (void)id;
+#endif
+}
