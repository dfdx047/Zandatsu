+namespace compile_guard {
+constexpr uint32_t kSlots = 16;
+constexpr uint32_t kSlotBytes = 96;
+std::once_flag g_once;
+int g_fd = -1;
+std::atomic<uint32_t> g_next_slot{0};
+thread_local int t_slot = -2;  // -2: ainda sem posicao; -1: sem posicao livre
+bool g_serial = false;
+std::mutex g_serial_mutex;
+std::mutex g_blocked_mutex;
+std::unordered_map<std::string, uint32_t> g_seen;  // id -> sessoes em que a compilacao nao acabou
+std::filesystem::path g_bad_path;
+
+std::string Id(const PipelineKey &key) {
+  const PipelineKey stored = StoredKey(key);
+  const auto *vs = static_cast<const ShaderCacheEntry *>(key.vertex_shader);
+  const auto *ps = static_cast<const ShaderCacheEntry *>(key.pixel_shader);
+  return fmt::format("vs {:016X} ps {:016X} key {:016X}", vs ? vs->hash : 0, ps ? ps->hash : 0,
+                     XXH3_64bits(&stored, sizeof(stored)));
