+// Dragon Burst (0092): frame generation ("120 FPS (interpolado)").
+//
+// The game renders N frames per second (60); with dbz3_frame_interpolation on a display of at
+// least ~1.8x N Hz with FIFO, each new guest frame is preceded on the screen by a frame generated
+// halfway between the previous guest frame and the new one, so the display gets 2N frames per
+// second. Both presents are queued back to back and FIFO spaces them by one vblank: the real
+// frame reaches the screen one display frame (8.3 ms at 120 Hz) later than without this.
+//
+// It works on the guest output (the frontbuffer the game swapped, before the present effects):
+// it is game-agnostic, runs at the game's resolution (cheaper than at the display's), and the
+// generated frame then goes through the same bilinear / CAS / FSR as the real ones.
+// Algorithm and thresholds: src/ui/shaders/dbz3_frame_interp.comp, validated with the numpy
+// model dragon-burst/tools/frame_interp_ref.py.
+// ---------------------------------------------------------------------------
+
+struct VulkanPresenter::Dbz3FrameInterp {
+  static constexpr uint32_t kSlots = PaintContext::kSubmissionCount;
+  // History, generated frame and the luma pyramid: rgba8 (full rate linear filtering on mobile
+  // GPUs; the guest output of these games is 8 bits per channel). Motion vectors: rgba16f.
+  static constexpr VkFormat kFormat = VK_FORMAT_R8G8B8A8_UNORM;
+  static constexpr VkFormat kVectorFormat = VK_FORMAT_R16G16B16A16_SFLOAT;
+
+  struct PushConstants {
+    int32_t full_size[2];
+    int32_t q_size[2];
+    int32_t s_size[2];
+    int32_t b_size[2];
+    int32_t k;
+    int32_t quality;
+    int32_t mode;
+    int32_t pad;
+  };
+
+  bool init_tried = false;
+  bool ok = false;
+  VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+  VkPipelineLayout layout = VK_NULL_HANDLE;
+  VkPipeline pipelines[4] = {};
+  VkDescriptorPool pool = VK_NULL_HANDLE;
+  VkDescriptorSet sets[kSlots] = {};
+  VkSampler sampler = VK_NULL_HANDLE;
+
+  // Counters (bad blocks, fallback pixels, unchanged pixels) per paint submission slot, read
+  // back when the slot comes round again (that submission has completed by then).
+  VkBuffer counters = VK_NULL_HANDLE;
+  VkDeviceMemory counters_memory = VK_NULL_HANDLE;
+  uint32_t counters_memory_type = 0;
+  VkDeviceSize counters_stride = 256;
+  uint8_t* counters_mapped = nullptr;
+
+  VkQueryPool queries = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  PFN_vkGetQueryPoolResults get_query_results = nullptr;
+  double ns_per_tick = 0.0;
+  uint64_t timestamp_mask = 0;
+
+  // Size-dependent.
+  uint32_t width = 0, height = 0;
+  int32_t k = 1;
+  VkExtent2D q = {}, s = {}, b = {};
+  std::unique_ptr<GuestOutputImage> hist[2], qimg[2], simg[2], vs, v8;
+  std::shared_ptr<GuestOutputImage> gen;
+  bool images_need_layout = false;
+  uint32_t parity = 0;  // hist / qimg / simg [parity] hold the previous frame
+  bool history_valid = false;
+  uint64_t last_submission = 0;
+
+  struct Slot {
+    bool pending = false;
+    bool timed = false;
+    uint32_t pixels = 0;
+    uint32_t blocks = 0;
+  } slots[kSlots];
+
+  std::string state;
+};
+
+namespace {
+uint32_t Dbz3DivUp(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
+}  // namespace
+
+void VulkanPresenter::Dbz3DestroyFrameInterp() {
+  Dbz3FrameInterp* fi = dbz3_frame_interp_;
+  if (!fi) {
+    return;
+  }
+  dbz3_frame_interp_ = nullptr;
+  paint_context_.submission_tracker.AwaitSubmissionCompletion(fi->last_submission);
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  for (VkPipeline& pipeline : fi->pipelines) {
+    util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, pipeline);
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, fi->layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device, fi->pool);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device, fi->set_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroySampler, device, fi->sampler);
+  if (fi->counters_mapped) {
+    dfn.vkUnmapMemory(device, fi->counters_memory);
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, fi->counters);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, fi->counters_memory);
+  util::DestroyAndNullHandle(dfn.vkDestroyQueryPool, device, fi->queries);
+  delete fi;
+}
+
+bool VulkanPresenter::Dbz3EnsureFrameInterp(uint32_t width, uint32_t height) {
+  if (!dbz3_frame_interp_) {
+    dbz3_frame_interp_ = new Dbz3FrameInterp;
+  }
+  Dbz3FrameInterp& fi = *dbz3_frame_interp_;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  if (!fi.init_tried) {
+    fi.init_tried = true;
+    // Bindings: see dbz3_frame_interp.comp.
+    static constexpr VkDescriptorType kTypes[14] = {
+        VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+        VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,          VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+        VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+        VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,          VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+        VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+        VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,          VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+        VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+    };
+    VkDescriptorSetLayoutBinding bindings[14];
+    uint32_t sampler_count = 0, storage_image_count = 0;
+    for (uint32_t i = 0; i < 14; ++i) {
+      bindings[i] = {i, kTypes[i], 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};
+      sampler_count += kTypes[i] == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      storage_image_count += kTypes[i] == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    }
+    VkDescriptorSetLayoutCreateInfo set_layout_info = {};
+    set_layout_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+    set_layout_info.bindingCount = 14;
+    set_layout_info.pBindings = bindings;
+    VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                      uint32_t(sizeof(Dbz3FrameInterp::PushConstants))};
+    VkPipelineLayoutCreateInfo layout_info = {};
+    layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_info.setLayoutCount = 1;
+    layout_info.pSetLayouts = &fi.set_layout;
+    layout_info.pushConstantRangeCount = 1;
+    layout_info.pPushConstantRanges = &push_range;
+    VkDescriptorPoolSize pool_sizes[3] = {
+        {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, sampler_count * Dbz3FrameInterp::kSlots},
+        {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, storage_image_count * Dbz3FrameInterp::kSlots},
+        {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, Dbz3FrameInterp::kSlots},
+    };
+    VkDescriptorPoolCreateInfo pool_info = {};
+    pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pool_info.maxSets = Dbz3FrameInterp::kSlots;
+    pool_info.poolSizeCount = 3;
+    pool_info.pPoolSizes = pool_sizes;
+    VkSamplerCreateInfo sampler_info = {};
+    sampler_info.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+    sampler_info.magFilter = VK_FILTER_LINEAR;
+    sampler_info.minFilter = VK_FILTER_LINEAR;
+    sampler_info.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler_info.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.maxLod = 0.0f;
+    if (dfn.vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr, &fi.set_layout) !=
+            VK_SUCCESS ||
+        dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &fi.layout) != VK_SUCCESS ||
+        dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &fi.pool) != VK_SUCCESS ||
+        dfn.vkCreateSampler(device, &sampler_info, nullptr, &fi.sampler) != VK_SUCCESS) {
+      REXLOG_ERROR("dbz3: interpolacao de frames: falhou a criar os objetos Vulkan");
+      return false;
+    }
+    VkDescriptorSetLayout set_layouts[Dbz3FrameInterp::kSlots];
+    std::fill(set_layouts, set_layouts + Dbz3FrameInterp::kSlots, fi.set_layout);
+    VkDescriptorSetAllocateInfo alloc_info = {};
+    alloc_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    alloc_info.descriptorPool = fi.pool;
+    alloc_info.descriptorSetCount = Dbz3FrameInterp::kSlots;
+    alloc_info.pSetLayouts = set_layouts;
+    if (dfn.vkAllocateDescriptorSets(device, &alloc_info, fi.sets) != VK_SUCCESS) {
+      REXLOG_ERROR("dbz3: interpolacao de frames: vkAllocateDescriptorSets falhou");
+      return false;
+    }
+    const std::pair<const uint32_t*, size_t> code[4] = {
+        {shaders::dbz3_frame_interp_p1_cs, sizeof(shaders::dbz3_frame_interp_p1_cs)},
+        {shaders::dbz3_frame_interp_p2_cs, sizeof(shaders::dbz3_frame_interp_p2_cs)},
+        {shaders::dbz3_frame_interp_p3_cs, sizeof(shaders::dbz3_frame_interp_p3_cs)},
+        {shaders::dbz3_frame_interp_p4_cs, sizeof(shaders::dbz3_frame_interp_p4_cs)},
+    };
+    for (uint32_t i = 0; i < 4; ++i) {
+      fi.pipelines[i] =
+          util::CreateComputePipeline(vulkan_device_, fi.layout, code[i].first, code[i].second);
+      if (fi.pipelines[i] == VK_NULL_HANDLE) {
+        REXLOG_ERROR("dbz3: interpolacao de frames: o passe {} nao compilou", i + 1);
+        return false;
+      }
+    }
+    fi.counters_stride = std::max<VkDeviceSize>(
+        256, vulkan_device_->properties().minStorageBufferOffsetAlignment);
+    if (!util::CreateDedicatedAllocationBuffer(
+            vulkan_device_, fi.counters_stride * Dbz3FrameInterp::kSlots,
+            VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, util::MemoryPurpose::kReadback, fi.counters,
+            fi.counters_memory, &fi.counters_memory_type) ||
+        dfn.vkMapMemory(device, fi.counters_memory, 0, VK_WHOLE_SIZE, 0,
+                        reinterpret_cast<void**>(&fi.counters_mapped)) != VK_SUCCESS) {
+      REXLOG_ERROR("dbz3: interpolacao de frames: falhou o buffer dos contadores");
+      fi.counters_mapped = nullptr;
+      return false;
+    }
+    std::memset(fi.counters_mapped, 0, size_t(fi.counters_stride * Dbz3FrameInterp::kSlots));
+    // GPU time (optional): timestamps around the passes.
+    {
+      const auto& ifn = vulkan_device_->vulkan_instance()->functions();
+      VkPhysicalDevice physical_device = vulkan_device_->physical_device();
+      uint32_t family_count = 0;
+      ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &family_count, nullptr);
+      std::vector<VkQueueFamilyProperties> families(family_count);
+      ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &family_count,
+                                                   families.data());
+      const uint32_t family = vulkan_device_->queue_family_graphics_compute();
+      VkPhysicalDeviceProperties props;
+      ifn.vkGetPhysicalDeviceProperties(physical_device, &props);
+      fi.write_timestamp = reinterpret_cast<PFN_vkCmdWriteTimestamp>(
+          ifn.vkGetDeviceProcAddr(device, "vkCmdWriteTimestamp"));
+      fi.get_query_results = reinterpret_cast<PFN_vkGetQueryPoolResults>(
+          ifn.vkGetDeviceProcAddr(device, "vkGetQueryPoolResults"));
+      if (family < family_count && families[family].timestampValidBits &&
+          props.limits.timestampPeriod > 0.0f && fi.write_timestamp && fi.get_query_results) {
+        const uint32_t bits = families[family].timestampValidBits;
+        fi.timestamp_mask = bits >= 64 ? ~uint64_t(0) : ((uint64_t(1) << bits) - 1);
+        fi.ns_per_tick = double(props.limits.timestampPeriod);
+        VkQueryPoolCreateInfo query_info = {};
+        query_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+        query_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        query_info.queryCount = 2 * Dbz3FrameInterp::kSlots;
+        if (dfn.vkCreateQueryPool(device, &query_info, nullptr, &fi.queries) != VK_SUCCESS) {
+          fi.queries = VK_NULL_HANDLE;
+        }
+      }
+    }
+    fi.ok = true;
+  }
+  if (!fi.ok) {
+    return false;
+  }
+  if (fi.width == width && fi.height == height && fi.gen) {
+    return true;
+  }
+  // New size (or first use): new images; the old ones may still be in use on the GPU.
+  paint_context_.submission_tracker.AwaitSubmissionCompletion(fi.last_submission);
+  fi.width = width;
+  fi.height = height;
+  fi.k = int32_t(std::max<uint32_t>(1, (width + 640) / 1280));
+  const uint32_t d = 4 * uint32_t(fi.k);
+  fi.q = {Dbz3DivUp(width, d), Dbz3DivUp(height, d)};
+  fi.s = {Dbz3DivUp(fi.q.width, 4), Dbz3DivUp(fi.q.height, 4)};
+  fi.b = {Dbz3DivUp(fi.q.width, 2), Dbz3DivUp(fi.q.height, 2)};
+  bool created = true;
+  for (uint32_t i = 0; i < 2; ++i) {
+    fi.hist[i] = GuestOutputImage::Create(vulkan_device_, width, height, Dbz3FrameInterp::kFormat);
+    fi.qimg[i] = GuestOutputImage::Create(vulkan_device_, fi.q.width, fi.q.height,
+                                          Dbz3FrameInterp::kFormat);
+    fi.simg[i] = GuestOutputImage::Create(vulkan_device_, fi.s.width, fi.s.height,
+                                          Dbz3FrameInterp::kFormat);
+    created = created && fi.hist[i] && fi.qimg[i] && fi.simg[i];
+  }
+  fi.vs = GuestOutputImage::Create(vulkan_device_, fi.s.width, fi.s.height,
+                                   Dbz3FrameInterp::kVectorFormat);
+  fi.v8 = GuestOutputImage::Create(vulkan_device_, fi.b.width, fi.b.height,
+                                   Dbz3FrameInterp::kVectorFormat);
+  fi.gen = GuestOutputImage::Create(vulkan_device_, width, height, Dbz3FrameInterp::kFormat);
+  if (!created || !fi.vs || !fi.v8 || !fi.gen) {
+    REXLOG_ERROR("dbz3: interpolacao de frames: falhou a criar as imagens de {}x{}", width,
+                 height);
+    fi.gen.reset();
+    fi.width = fi.height = 0;
+    return false;
+  }
+  fi.images_need_layout = true;
+  fi.history_valid = false;
+  fi.parity = 0;
+  REXLOG_INFO(
+      "dbz3: interpolacao de frames: imagens {}x{} (k={}, luma {}x{} e {}x{}, blocos {}x{})",
+      width, height, fi.k, fi.q.width, fi.q.height, fi.s.width, fi.s.height, fi.b.width,
+      fi.b.height);
+  return true;
+}
+
+VulkanPresenter::Dbz3PaintMode VulkanPresenter::Dbz3ChooseFrameMode(const GuestOutputImage& image) {
+  const bool enabled = REXCVAR_GET(dbz3_frame_interpolation);
+  const int32_t quality = REXCVAR_GET(dbz3_frame_interpolation_quality);
+  const int32_t display_override = REXCVAR_GET(dbz3_frame_interpolation_display_hz);
+  const float display_hz =
+      display_override > 0 ? float(display_override) : rex::perf::GetDisplayRefreshRate();
+  const double game_rate = rex::graphics::GetGuestVblankRate();
+  const double game_fps = game_rate > 0.0 && game_rate < 500.0 ? game_rate : 60.0;
+  const int32_t present_mode = g_dbz3_present_mode.load(std::memory_order_relaxed);
+  const bool fifo = paint_context_.swapchain_is_fifo;
+  std::string state;
+  Dbz3PaintMode mode = Dbz3PaintMode::kNormal;
+  if (!enabled) {
+    state = "desligada";
+  } else if (!fifo) {
+    state = fmt::format("a espera: modo de apresentacao {} sem vsync (precisa de FIFO)",
+                        Dbz3PresentModeName(present_mode));
+  } else if (display_hz <= 0.0f) {
+    state = "a espera: Hz da tela desconhecido";
+  } else if (double(display_hz) < 1.8 * game_fps) {
+    state = fmt::format("a espera: tela de {:.0f} Hz, precisa de {:.0f} Hz para {:.0f} FPS",
+                        display_hz, std::ceil(1.8 * game_fps), game_fps);
+  } else if (!Dbz3EnsureFrameInterp(image.extent().width, image.extent().height)) {
+    state = "desligada: erro ao criar os recursos (ver acima)";
+  } else {
+    state = fmt::format("ativa (tela {:.0f} Hz, jogo {:.0f} FPS -> {:.0f}, {}, {}x{}, qualidade {})",
+                        display_hz, game_fps, 2.0 * game_fps, Dbz3PresentModeName(present_mode),
+                        image.extent().width, image.extent().height, quality);
+    Dbz3FrameInterp& fi = *dbz3_frame_interp_;
+    if (fi.history_valid) {
+      mode = Dbz3PaintMode::kGenerated;
+    } else {
+      mode = Dbz3PaintMode::kPrime;
+      rex::perf::GetPresentStats().not_generated.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  static std::string last_state;
+  if (state != last_state) {
+    last_state = state;
+    REXLOG_INFO("dbz3: interpolacao de frames: {}", state);
+  }
+  rex::perf::SetPresentInfo(fmt::format(
+      "{}, tela {:.0f} Hz, jogo {:.0f} FPS, interpolacao de frames: {}",
+      Dbz3PresentModeName(present_mode), display_hz, game_fps, state));
+  if (mode == Dbz3PaintMode::kNormal && dbz3_frame_interp_) {
+    // Off or waiting: the next frame generated must not use an old history.
+    dbz3_frame_interp_->history_valid = false;
+  }
+  return mode;
+}
+
+std::shared_ptr<VulkanPresenter::GuestOutputImage> VulkanPresenter::Dbz3RecordFrameInterp(
+    VkCommandBuffer command_buffer, uint64_t submission_index, const GuestOutputImage& cur,
+    bool generate) {
+  Dbz3FrameInterp* fip = dbz3_frame_interp_;
+  if (!fip || !fip->ok || !fip->gen || fip->width != cur.extent().width ||
+      fip->height != cur.extent().height) {
+    return nullptr;
+  }
+  Dbz3FrameInterp& fi = *fip;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  const uint32_t slot_index = uint32_t(submission_index % Dbz3FrameInterp::kSlots);
+  Dbz3FrameInterp::Slot& slot = fi.slots[slot_index];
+  rex::perf::PresentStats& stats = rex::perf::GetPresentStats();
+
+  // The previous use of this slot has completed (PaintAndPresentOnce awaited it): its results.
+  if (slot.pending) {
+    slot.pending = false;
+    if (!(vulkan_device_->memory_types().host_coherent & (uint32_t(1) << fi.counters_memory_type))) {
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = fi.counters_memory;
+      range.offset = 0;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+    }
+    const uint32_t* counters =
+        reinterpret_cast<const uint32_t*>(fi.counters_mapped + fi.counters_stride * slot_index);
+    const uint32_t bad_blocks = counters[0];
+    const uint32_t fallback_pixels = counters[1];
+    const uint32_t static_pixels = counters[2];
+    if (bad_blocks * 2 > slot.blocks) {
+      stats.cuts.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      stats.fallback_pixels.fetch_add(fallback_pixels, std::memory_order_relaxed);
+      stats.moving_pixels.fetch_add(slot.pixels > static_pixels ? slot.pixels - static_pixels : 0,
+                                    std::memory_order_relaxed);
+    }
+    if (slot.timed && fi.queries != VK_NULL_HANDLE) {
+      uint64_t ticks[2] = {};
+      if (fi.get_query_results(device, fi.queries, slot_index * 2, 2, sizeof(ticks), ticks,
+                               sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+        const uint64_t delta = (ticks[1] - ticks[0]) & fi.timestamp_mask;
+        stats.gpu_ns.fetch_add(uint64_t(double(delta) * fi.ns_per_tick),
+                               std::memory_order_relaxed);
+        stats.gpu_samples.fetch_add(1, std::memory_order_relaxed);
+      }
+    }
+    slot.timed = false;
+  }
+
+  const bool interpolate = generate && fi.history_valid;
+  const uint32_t prev = fi.parity, next = fi.parity ^ 1;
+
+  // Descriptors of this slot (its previous submission has completed).
+  {
+    VkDescriptorImageInfo images[13];
+    auto sampled = [&](uint32_t i, VkImageView view, VkImageLayout layout) {
+      images[i] = {fi.sampler, view, layout};
+    };
+    auto storage = [&](uint32_t i, VkImageView view) {
+      images[i] = {VK_NULL_HANDLE, view, VK_IMAGE_LAYOUT_GENERAL};
+    };
+    sampled(0, cur.view(), kGuestOutputInternalLayout);
+    sampled(1, fi.hist[prev]->view(), VK_IMAGE_LAYOUT_GENERAL);
+    storage(2, fi.hist[next]->view());
+    storage(3, fi.gen->view());
+    sampled(4, fi.qimg[prev]->view(), VK_IMAGE_LAYOUT_GENERAL);
+    sampled(5, fi.qimg[next]->view(), VK_IMAGE_LAYOUT_GENERAL);
+    storage(6, fi.qimg[next]->view());
+    sampled(7, fi.simg[prev]->view(), VK_IMAGE_LAYOUT_GENERAL);
+    sampled(8, fi.simg[next]->view(), VK_IMAGE_LAYOUT_GENERAL);
+    storage(9, fi.simg[next]->view());
+    storage(10, fi.vs->view());
+    storage(11, fi.v8->view());
+    sampled(12, fi.v8->view(), VK_IMAGE_LAYOUT_GENERAL);
+    VkDescriptorBufferInfo buffer_info = {fi.counters, fi.counters_stride * slot_index, 16};
+    VkWriteDescriptorSet writes[14];
+    for (uint32_t i = 0; i < 14; ++i) {
+      VkWriteDescriptorSet& w = writes[i];
+      w = {};
+      w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      w.dstSet = fi.sets[slot_index];
+      w.dstBinding = i;
+      w.descriptorCount = 1;
+      if (i == 13) {
+        w.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        w.pBufferInfo = &buffer_info;
+      } else {
+        w.descriptorType = images[i].sampler != VK_NULL_HANDLE
+                               ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
+                               : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        w.pImageInfo = &images[i];
+      }
+    }
+    dfn.vkUpdateDescriptorSets(device, 14, writes, 0, nullptr);
+  }
+
+  // Before: everything earlier on the queue (the guest output refresh, the previous paints that
+  // sampled the generated frame) done and visible; layouts of new images; the generated frame
+  // (fully rewritten) to GENERAL.
+  {
+    VkImageMemoryBarrier image_barriers[10];
+    uint32_t image_barrier_count = 0;
+    auto to_general = [&](VkImage image) {
+      VkImageMemoryBarrier& ib = image_barriers[image_barrier_count++];
+      ib = {};
+      ib.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+      ib.srcAccessMask = 0;
+      ib.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+      ib.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      ib.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      ib.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      ib.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      ib.image = image;
+      ib.subresourceRange = util::InitializeSubresourceRange();
+    };
+    if (fi.images_need_layout) {
+      fi.images_need_layout = false;
+      for (uint32_t i = 0; i < 2; ++i) {
+        to_general(fi.hist[i]->image());
+        to_general(fi.qimg[i]->image());
+        to_general(fi.simg[i]->image());
+      }
+      to_general(fi.vs->image());
+      to_general(fi.v8->image());
+    }
+    if (interpolate) {
+      to_general(fi.gen->image());
+    }
+    VkMemoryBarrier memory_barrier = {};
+    memory_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    memory_barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    memory_barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &memory_barrier, 0,
+                             nullptr, image_barrier_count, image_barriers);
+  }
+  const bool timed = interpolate && fi.queries != VK_NULL_HANDLE;
+  if (timed) {
+    dfn.vkCmdResetQueryPool(command_buffer, fi.queries, slot_index * 2, 2);
+    fi.write_timestamp(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, fi.queries,
+                       slot_index * 2);
+  }
+
+  Dbz3FrameInterp::PushConstants pc = {};
+  pc.full_size[0] = int32_t(fi.width);
+  pc.full_size[1] = int32_t(fi.height);
+  pc.q_size[0] = int32_t(fi.q.width);
+  pc.q_size[1] = int32_t(fi.q.height);
+  pc.s_size[0] = int32_t(fi.s.width);
+  pc.s_size[1] = int32_t(fi.s.height);
+  pc.b_size[0] = int32_t(fi.b.width);
+  pc.b_size[1] = int32_t(fi.b.height);
+  pc.k = fi.k;
+  pc.quality = REXCVAR_GET(dbz3_frame_interpolation_quality);
+  pc.mode = interpolate ? 0 : 1;
+  dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fi.layout, 0, 1,
+                              &fi.sets[slot_index], 0, nullptr);
+  dfn.vkCmdPushConstants(command_buffer, fi.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc),
+                         &pc);
+  VkMemoryBarrier pass_barrier = {};
+  pass_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  pass_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+  pass_barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  auto between_passes = [&]() {
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &pass_barrier, 0,
+                             nullptr, 0, nullptr);
+  };
+  // Pass 1: pyramid of the new frame (8x8 Q texels -> 2x2 S texels per group).
+  dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fi.pipelines[0]);
+  dfn.vkCmdDispatch(command_buffer, Dbz3DivUp(fi.s.width, 2), Dbz3DivUp(fi.s.height, 2), 1);
+  between_passes();
+  if (interpolate && pc.quality > 0) {
+    dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fi.pipelines[1]);
+    dfn.vkCmdDispatch(command_buffer, Dbz3DivUp(fi.s.width, 8), Dbz3DivUp(fi.s.height, 8), 1);
+    between_passes();
+    dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fi.pipelines[2]);
+    dfn.vkCmdDispatch(command_buffer, Dbz3DivUp(fi.b.width, 8), Dbz3DivUp(fi.b.height, 8), 1);
+    between_passes();
+  }
+  // Pass 4: the generated frame and the history copy (mode 1: only the copy).
+  dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fi.pipelines[3]);
+  dfn.vkCmdDispatch(command_buffer, Dbz3DivUp(fi.width, 8), Dbz3DivUp(fi.height, 8), 1);
+  if (timed) {
+    fi.write_timestamp(command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, fi.queries,
+                       slot_index * 2 + 1);
+  }
+  // After: the generated frame to the layout the present effects sample it in; the counters to
+  // the host; the history for the next frame (its barrier is the "before" one above).
+  {
+    VkImageMemoryBarrier gen_barrier = {};
+    gen_barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    gen_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    gen_barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    gen_barrier.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    gen_barrier.newLayout = kGuestOutputInternalLayout;
+    gen_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    gen_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    gen_barrier.image = fi.gen->image();
+    gen_barrier.subresourceRange = util::InitializeSubresourceRange();
+    VkMemoryBarrier host_barrier = {};
+    host_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    host_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    host_barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT | VK_ACCESS_SHADER_READ_BIT;
+    dfn.vkCmdPipelineBarrier(
+        command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+            VK_PIPELINE_STAGE_HOST_BIT,
+        0, 1, &host_barrier, 0, nullptr, interpolate ? 1 : 0, &gen_barrier);
+  }
+  fi.parity = next;
+  fi.history_valid = true;
+  fi.last_submission = submission_index;
+  if (!interpolate) {
+    return nullptr;
+  }
+  slot.pending = true;
+  slot.timed = timed;
+  slot.pixels = fi.width * fi.height;
+  slot.blocks = fi.b.width * fi.b.height;
+  return fi.gen;
+}
+
 bool VulkanPresenter::InitializeSurfaceIndependent() {
   const VulkanDevice::Functions& dfn = vulkan_device_->functions();
   const VkDevice device = vulkan_device_->device();
