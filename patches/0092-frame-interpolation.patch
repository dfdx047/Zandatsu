 Presenter::PaintResult VulkanPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  // Dragon Burst (0092): take the guest output here, so the generated frame and the real one
+  // after it are painted from the same guest frame even if a newer one arrives in between.
+  Dbz3PaintSource source;
+  uint64_t serial = 0;
+  {
+    uint32_t guest_output_mailbox_index;
+    std::unique_lock<std::mutex> guest_output_consumer_lock(ConsumeGuestOutput(
+        guest_output_mailbox_index, &source.properties, &source.paint_config));
+    if (guest_output_mailbox_index != UINT32_MAX) {
+      assert_true(guest_output_images_[guest_output_mailbox_index].ever_successfully_refreshed);
+      source.image = guest_output_images_[guest_output_mailbox_index].image;
+      serial = dbz3_refresh_serial_[guest_output_mailbox_index].load(std::memory_order_relaxed);
+    }
+    // Incremented the reference count of the guest output image - safe to leave
+    // the consumer critical section now as everything here either will be using
+    // the new reference or is exclusively owned by main target painting (and
+    // multiple threads can't paint the main target at the same time).
+  }
+  Dbz3PaintMode mode = Dbz3PaintMode::kNormal;
+  if (source.image && serial != dbz3_last_painted_serial_) {
+    dbz3_last_painted_serial_ = serial;
+    mode = Dbz3ChooseFrameMode(*source.image);
+  }
+  if (mode == Dbz3PaintMode::kGenerated) {
+    const PaintResult result = PaintAndPresentOnce(execute_ui_drawers, source, mode);
+    if (result != PaintResult::kPresented && result != PaintResult::kPresentedSuboptimal) {
+      return result;
+    }
+    rex::perf::GetPresentStats().generated.fetch_add(1, std::memory_order_relaxed);
+    // FIFO: this present waits for a free swapchain image, so the real frame reaches the
+    // screen one vblank after the generated one.
+    mode = Dbz3PaintMode::kNormal;
+  }
+  return PaintAndPresentOnce(execute_ui_drawers, source, mode);
+}
