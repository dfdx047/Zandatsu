diff --git a/src/ui/shaders/dbz3_frame_interp.comp b/src/ui/shaders/dbz3_frame_interp.comp
new file mode 100644
index 0000000000000000000000000000000000000000..eb2d07377f140013541e4cfb1cc72d9a5a5e817c
--- /dev/null
+++ b/src/ui/shaders/dbz3_frame_interp.comp
@@ -0,0 +1,351 @@
+// Dragon Burst (0092): frame generation for "120 FPS (interpolated)" in the Vulkan presenter.
+// The game renders 60 frames per second; for each new frame the presenter first shows a frame
+// generated halfway between the previous one and the new one, then the new one (FIFO at 120 Hz
+// spaces them by one vblank). Runs on the guest output (the frontbuffer the game swapped),
+// before the present effects (bilinear / CAS / FSR), so it is the same for any game.
+//
+// Same maths as dragon-burst/tools/frame_interp_ref.py (the numpy model used to validate it).
+//
+// PASS 1  luma+chroma pyramid of the new frame: Q (1/4k) and S (1/16k), k = round(width / 1280),
+//         as (Y, U + 0.5, V + 0.5) in rgba8 (full rate linear filtering on mobile GPUs);
+//         resets the counters.
+// PASS 2  coarse motion on S: symmetric search +-3 texels (prev(c - v/2) against cur(c + v/2)),
+//         3x3 window, then half a texel of refinement.
+// PASS 3  motion per 8k x 8k block on Q: candidates = the S vector of the block and its 4
+//         neighbours (cross) + zero, then +-1 and +-0.5 Q texel; 4x4 window. Blocks without a
+//         match count for the scene cut test.
+// PASS 4  per pixel: unchanged pixel -> the new frame (HUD, still background); scene cut -> the
+//         new frame; otherwise the best of {interpolated vector, block vector (, 4 neighbours)}
+//         by the colour error between the two samples plus a coherence penalty (the block where
+//         each sample lands must move with that vector), and on a mismatch (occlusion) the side
+//         that is coherent, or a plain blend. Also copies the new frame into the history.
+//         mode 1 = only the history copy (first frame, size change).
+//
+// Regenerate the headers in vulkan_spirv/ (glslang), for p in 1 2 3 4:
+//   glslangValidator -V --target-env vulkan1.0 -DPASS=$p --vn dbz3_frame_interp_p${p}_cs
+//     -o vulkan_spirv/dbz3_frame_interp_p${p}_cs.h dbz3_frame_interp.comp
+#version 450
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 0) uniform sampler2D u_cur;    // guest output (new frame)
+layout(set = 0, binding = 1) uniform sampler2D u_prev;   // history (previous frame)
+layout(set = 0, binding = 2, rgba8) uniform writeonly image2D u_hist_out;
+layout(set = 0, binding = 3, rgba8) uniform writeonly image2D u_gen;
+layout(set = 0, binding = 4) uniform sampler2D u_q_prev;
+layout(set = 0, binding = 5) uniform sampler2D u_q_cur;
+layout(set = 0, binding = 6, rgba8) uniform writeonly image2D u_q_out;
+layout(set = 0, binding = 7) uniform sampler2D u_s_prev;
+layout(set = 0, binding = 8) uniform sampler2D u_s_cur;
+layout(set = 0, binding = 9, rgba8) uniform writeonly image2D u_s_out;
+layout(set = 0, binding = 10, rgba16f) uniform image2D u_vs;
+layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D u_v8_out;
+layout(set = 0, binding = 12) uniform sampler2D u_v8;
+layout(set = 0, binding = 13, std430) buffer Counters {
+  uint bad_blocks;
+  uint fallback_pixels;
+  uint static_pixels;
+  uint cut;
+} u_counters;
+
+layout(push_constant) uniform Constants {
+  ivec2 full_size;
+  ivec2 q_size;
+  ivec2 s_size;
+  ivec2 b_size;
+  int k;
+  int quality;
+  int mode;
+  int pad;
+} pc;
+
+const int R_COARSE = 3;
+const vec3 YUV_OFFSET = vec3(0.0, 0.5, 0.5);
+const float LAMBDA_COARSE = 0.002;
+const float LAMBDA_REFINE = 0.0005;
+const float T_CUT_BLOCK = 0.15;
+const float EPS_STATIC = 1.5 / 255.0;
+const float T_LO = 0.03;
+const float T_HI = 0.10;
+const float K_COHERENCE = 0.004;
+const float COHERENCE_CAP = 32.0;
+const float COHERENT_PX = 4.0;
+
+// (Y, (B - Y) / 2, (R - Y) / 2)
+vec3 Yuv(vec3 rgb) {
+  float y = dot(rgb, vec3(0.299, 0.587, 0.114));
+  return vec3(y, (rgb.b - y) * 0.5, (rgb.r - y) * 0.5);
+}
+
+float YuvDiff(vec3 a, vec3 b) {
+  vec3 d = abs(a - b);
+  return d.x + d.y + d.z;
+}
+
+// Pixel coordinates (texel centres at i + 0.5) -> linear sample with the clamp sampler.
+vec3 At(sampler2D t, vec2 p, ivec2 size) {
+  return textureLod(t, p / vec2(size), 0.0).rgb;
+}
+
+#if PASS == 1
+
+shared vec3 s_q[8][8];
+
+void main() {
+  ivec2 lid = ivec2(gl_LocalInvocationID.xy);
+  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
+  if (gl_GlobalInvocationID.x == 0u && gl_GlobalInvocationID.y == 0u) {
+    u_counters.bad_blocks = 0u;
+    u_counters.fallback_pixels = 0u;
+    u_counters.static_pixels = 0u;
+    u_counters.cut = 0u;
+  }
+  int d = 4 * pc.k;
+  vec3 acc = vec3(0.0);
+  for (int b = 0; b < 2 * pc.k; ++b) {
+    for (int a = 0; a < 2 * pc.k; ++a) {
+      vec2 p = vec2(float(q.x * d + 1 + 2 * a), float(q.y * d + 1 + 2 * b));
+      acc += Yuv(At(u_cur, p, pc.full_size));
+    }
+  }
+  acc /= float(4 * pc.k * pc.k);
+  if (all(lessThan(q, pc.q_size))) {
+    imageStore(u_q_out, q, vec4(acc + YUV_OFFSET, 0.0));
+  }
+  s_q[lid.y][lid.x] = acc;
+  barrier();
+  if (lid.x < 2 && lid.y < 2) {
+    vec3 sum = vec3(0.0);
+    for (int y = 0; y < 4; ++y) {
+      for (int x = 0; x < 4; ++x) {
+        sum += s_q[lid.y * 4 + y][lid.x * 4 + x];
+      }
+    }
+    ivec2 s = ivec2(gl_WorkGroupID.xy) * 2 + lid;
+    if (all(lessThan(s, pc.s_size))) {
+      imageStore(u_s_out, s, vec4(sum / 16.0 + YUV_OFFSET, 0.0));
+    }
+  }
+}
+
+#elif PASS == 2
+
+float CoarseCost(vec2 c, vec2 v) {
+  float cost = 0.0;
+  for (int dy = -1; dy <= 1; ++dy) {
+    for (int dx = -1; dx <= 1; ++dx) {
+      vec2 o = c + vec2(float(dx), float(dy));
+      cost += YuvDiff(At(u_s_prev, o - v * 0.5, pc.s_size), At(u_s_cur, o + v * 0.5, pc.s_size));
+    }
+  }
+  return cost / 9.0 + LAMBDA_COARSE * (abs(v.x) + abs(v.y));
+}
+
+void main() {
+  ivec2 s = ivec2(gl_GlobalInvocationID.xy);
+  if (any(greaterThanEqual(s, pc.s_size))) {
+    return;
+  }
+  vec2 c = vec2(s) + 0.5;
+  float best = 1.0e30;
+  vec2 bv = vec2(0.0);
+  for (int vy = -R_COARSE; vy <= R_COARSE; ++vy) {
+    for (int vx = -R_COARSE; vx <= R_COARSE; ++vx) {
+      vec2 v = vec2(float(vx), float(vy));
+      float cost = CoarseCost(c, v);
+      if (cost < best) {
+        best = cost;
+        bv = v;
+      }
+    }
+  }
+  vec2 cv = bv;
+  for (int dy = -1; dy <= 1; ++dy) {
+    for (int dx = -1; dx <= 1; ++dx) {
+      if (dx == 0 && dy == 0) {
+        continue;
+      }
+      vec2 v = cv + vec2(float(dx), float(dy)) * 0.5;
+      float cost = CoarseCost(c, v);
+      if (cost < best) {
+        best = cost;
+        bv = v;
+      }
+    }
+  }
+  imageStore(u_vs, s, vec4(bv * float(16 * pc.k), best, 0.0));
+}
+
+#elif PASS == 3
+
+shared uint s_bad;
+
+float RefineCost(vec2 c, vec2 v) {
+  float cost = 0.0;
+  for (int oy = 0; oy < 4; ++oy) {
+    for (int ox = 0; ox < 4; ++ox) {
+      vec2 o = c + vec2(float(ox) - 1.5, float(oy) - 1.5);
+      cost += YuvDiff(At(u_q_prev, o - v * 0.5, pc.q_size), At(u_q_cur, o + v * 0.5, pc.q_size));
+    }
+  }
+  return cost / 16.0;
+}
+
+void main() {
+  if (gl_LocalInvocationIndex == 0u) {
+    s_bad = 0u;
+  }
+  barrier();
+  ivec2 b = ivec2(gl_GlobalInvocationID.xy);
+  bool inside = all(lessThan(b, pc.b_size));
+  if (inside) {
+    vec2 c = vec2(b) * 2.0 + 1.0;
+    float q2px = float(4 * pc.k);
+    float best = RefineCost(c, vec2(0.0));
+    float best_raw = best;
+    vec2 bv = vec2(0.0);
+    ivec2 s = b / 2;
+    for (int dy = -1; dy <= 1; ++dy) {
+      for (int dx = -1; dx <= 1; ++dx) {
+        if (dx != 0 && dy != 0) {
+          continue;
+        }
+        ivec2 n = clamp(s + ivec2(dx, dy), ivec2(0), pc.s_size - 1);
+        vec2 v = imageLoad(u_vs, n).xy / q2px;
+        float raw = RefineCost(c, v);
+        float cost = raw + LAMBDA_REFINE * (abs(v.x) + abs(v.y));
+        if (cost < best) {
+          best = cost;
+          best_raw = raw;
+          bv = v;
+        }
+      }
+    }
+    for (int step_i = 0; step_i < 2; ++step_i) {
+      float step = step_i == 0 ? 1.0 : 0.5;
+      vec2 cv = bv;
+      for (int dy = -1; dy <= 1; ++dy) {
+        for (int dx = -1; dx <= 1; ++dx) {
+          if (dx == 0 && dy == 0) {
+            continue;
+          }
+          vec2 v = cv + vec2(float(dx), float(dy)) * step;
+          float raw = RefineCost(c, v);
+          float cost = raw + LAMBDA_REFINE * (abs(v.x) + abs(v.y));
+          if (cost < best) {
+            best = cost;
+            best_raw = raw;
+            bv = v;
+          }
+        }
+      }
+    }
+    imageStore(u_v8_out, b, vec4(bv * q2px, best_raw, 0.0));
+    if (best_raw > T_CUT_BLOCK) {
+      atomicAdd(s_bad, 1u);
+    }
+  }
+  barrier();
+  if (gl_LocalInvocationIndex == 0u && s_bad != 0u) {
