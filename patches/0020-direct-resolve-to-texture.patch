+// ---------------------------------------------------------------------------
+// DBZ3-Android: atalho render target -> textura.
+//
+// O jogo copia o ecra inteiro (1280x720 k_8_8_8_8) ~10 vezes por frame para os
+// efeitos e le cada copia como textura logo a seguir. No caminho normal cada copia
+// passa pelo buffer EDRAM, vai para a memoria do guest com tiling e endian, e a
+// textura volta a ler essa memoria e a desfazer tudo. Aqui, depois do resolve
+// normal (a memoria do guest continua certa), a textura que ja existe para esse
+// destino recebe o conteudo diretamente do render target (um compute que so troca
+// R/B se o resolve o pedir) e fica marcada como carregada.
+//
+// `dbz3_direct_resolve_texture`: 0 desligado, 1 ligado, 2 ligado com R/B ao
+// contrario (para testar a ordem dos canais sem recompilar).
+// ---------------------------------------------------------------------------
+namespace {
+struct Dbz3DirectResolveState {
+  bool init_tried = false;
+  VkPipelineLayout layout = VK_NULL_HANDLE;
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  bool source_is_integer = false;
+  uint32_t logged = 0;
+};
+Dbz3DirectResolveState g_dbz3_direct;
+
+const char* Dbz3DirectResolveSource(bool integer) {
+  if (integer) {
+    return R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Dest { uint dest[]; };
+layout(set = 1, binding = 0) uniform utexture2D src;
+layout(push_constant) uniform Constants { uint width; uint height; uint swap_rb; } pc;
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= pc.width || p.y >= pc.height) return;
+  uvec4 c = texelFetch(src, ivec2(p), 0) & 0xFFu;
+  if (pc.swap_rb != 0u) c.rb = c.br;
+  dest[p.y * pc.width + p.x] = c.r | (c.g << 8u) | (c.b << 16u) | (c.a << 24u);
+}
+)";
+  }
+  return R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Dest { uint dest[]; };
+layout(set = 1, binding = 0) uniform texture2D src;
+layout(push_constant) uniform Constants { uint width; uint height; uint swap_rb; } pc;
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= pc.width || p.y >= pc.height) return;
+  uvec4 c = uvec4(clamp(texelFetch(src, ivec2(p), 0), 0.0, 1.0) * 255.0 + 0.5);
+  if (pc.swap_rb != 0u) c.rb = c.br;
+  dest[p.y * pc.width + p.x] = c.r | (c.g << 8u) | (c.b << 16u) | (c.a << 24u);
+}
+)";
+}
+}  // namespace
+
+bool VulkanRenderTargetCache::Dbz3TryResolveToTexture(const draw_util::ResolveInfo& resolve_info,
+                                                      VulkanTextureCache& texture_cache) {
+  const std::string mode_text = rex::cvar::GetFlagByName("dbz3_direct_resolve_texture");
+  const int mode = mode_text.empty() ? 0 : std::atoi(mode_text.c_str());
+  if (mode <= 0 || GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  // So copias de cor 8888 sem MSAA, sem escala, de um retangulo a comecar em (0,0)
+  // do render target e do destino, com o destino linear em largura = pitch.
+  if (resolve_info.IsCopyingDepth() || resolve_info.copy_dest_info.copy_dest_exp_bias != 0 ||
+      resolve_info.copy_dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 ||
+      uint32_t(resolve_info.copy_dest_info.copy_dest_endian) > 3) {
+    return false;
+  }
+  const draw_util::ResolveEdramInfo& src_info = resolve_info.color_edram_info;
+  if (src_info.msaa_samples != xenos::MsaaSamples::k1X || src_info.format_is_64bpp ||
+      xenos::ColorRenderTargetFormat(src_info.format) != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      resolve_info.coordinate_info.edram_offset_x_div_8 != 0 ||
+      resolve_info.coordinate_info.edram_offset_y_div_8 != 0 ||
+      resolve_info.copy_dest_coordinate_info.offset_x_div_8 != 0 ||
+      resolve_info.copy_dest_coordinate_info.offset_y_div_8 != 0) {
+    return false;
+  }
+  const uint32_t width = uint32_t(resolve_info.coordinate_info.width_div_8) * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  if (width < 256 || height < 128 ||
+      uint32_t(resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32) * 32 != width ||
+      resolve_info.copy_dest_base != resolve_info.copy_dest_extent_start) {
+    return false;
+  }
+  // O conteudo tem de estar todo num unico render target 8888 1x a comecar no
+  // mesmo tile (dump_rectangles_ foi preenchido pelo dump deste resolve).
+  if (dump_rectangles_.size() != 1 || !dump_rectangles_[0].render_target) {
+    return false;
+  }
+  auto& rt = *static_cast<VulkanRenderTarget*>(dump_rectangles_[0].render_target);
+  const RenderTargetKey rt_key = rt.key();
+  if (rt_key.is_depth || rt_key.msaa_samples != xenos::MsaaSamples::k1X ||
+      rt_key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      rt_key.base_tiles != src_info.base_tiles ||
+      rt_key.pitch_tiles_at_32bpp != src_info.pitch_tiles) {
+    return false;
+  }
+  void* texture = texture_cache.Dbz3FindResolveTexture(
+      resolve_info.copy_dest_base, width, height,
+      xenos::Endian(uint32_t(resolve_info.copy_dest_info.copy_dest_endian)));
+  if (!texture) {
+    return false;
+  }
+
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  Dbz3DirectResolveState& st = g_dbz3_direct;
+  if (!st.init_tried) {
+    st.init_tried = true;
+    GetColorOwnershipTransferVulkanFormat(xenos::ColorRenderTargetFormat::k_8_8_8_8,
+                                          xenos::MsaaSamples::k1X, &st.source_is_integer);
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT,
+                                               Dbz3DirectResolveSource(st.source_is_integer),
+                                               spirv, error)) {
+      REXGPU_ERROR("dbz3: atalho resolve->textura: shader nao compilou: {}", error);
+      return false;
+    }
+    VkDescriptorSetLayout set_layouts[2] = {
+        command_processor_.GetSingleTransientDescriptorLayout(
+            VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+        descriptor_set_layout_sampled_image_};
+    VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(uint32_t) * 3};
+    VkPipelineLayoutCreateInfo layout_info = {};
+    layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_info.setLayoutCount = 2;
+    layout_info.pSetLayouts = set_layouts;
+    layout_info.pushConstantRangeCount = 1;
+    layout_info.pPushConstantRanges = &push_range;
+    if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &st.layout) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: atalho resolve->textura: vkCreatePipelineLayout falhou");
+      return false;
+    }
+    VkShaderModuleCreateInfo module_info = {};
+    module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+    module_info.codeSize = spirv.size() * sizeof(uint32_t);
+    module_info.pCode = spirv.data();
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (dfn.vkCreateShaderModule(device, &module_info, nullptr, &module) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: atalho resolve->textura: vkCreateShaderModule falhou");
+      return false;
+    }
+    VkComputePipelineCreateInfo pipeline_info = {};
+    pipeline_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+    pipeline_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    pipeline_info.stage.module = module;
+    pipeline_info.stage.pName = "main";
+    pipeline_info.layout = st.layout;
+    const VkResult result = dfn.vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                                         nullptr, &st.pipeline);
+    dfn.vkDestroyShaderModule(device, module, nullptr);
+    if (result != VK_SUCCESS) {
+      st.pipeline = VK_NULL_HANDLE;
+      REXGPU_ERROR("dbz3: atalho resolve->textura: vkCreateComputePipelines falhou");
+      return false;
+    }
+    REXGPU_INFO("dbz3: atalho resolve->textura ativo (origem {})",
+                st.source_is_integer ? "uint" : "unorm");
+  }
+  if (st.pipeline == VK_NULL_HANDLE) {
+    return false;
+  }
+
+  const VkDeviceSize buffer_size = VkDeviceSize(width) * height * 4;
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch = command_processor_.AcquireScratchGpuBuffer(
+      buffer_size, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+  VkBuffer scratch_buffer = scratch.buffer();
+  if (scratch_buffer == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSet dest_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (dest_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorBufferInfo dest_buffer_info = {scratch_buffer, 0, buffer_size};
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = dest_set;
+  write.dstBinding = 0;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write.pBufferInfo = &dest_buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+
+  // O render target ja esta pronto para leitura em compute (o dump deste resolve
+  // fez essa transicao); garante-o na mesma, sem custo se ja estiver.
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(), ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+      rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rt.current_access_mask(),
+      VK_ACCESS_SHADER_READ_BIT, rt.current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+              VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(st.pipeline);
+  VkDescriptorSet sets[2] = {dest_set, rt.GetDescriptorSetTransferSource()};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, st.layout, 0, 2, sets, 0,
+                                         nullptr);
+  const bool swap_rb = (resolve_info.copy_dest_info.copy_dest_swap != 0) != (mode == 2);
+  const uint32_t constants[3] = {width, height, swap_rb ? 1u : 0u};
+  command_buffer.CmdVkPushConstants(st.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                    constants);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((width + 7) / 8, (height + 7) / 8, 1);
+
+  texture_cache.Dbz3CopyToResolveTexture(
+      texture, scratch_buffer, width, height,
+      scratch.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT),
+      scratch.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT));
+  dbz3_gpuprof::CountDirectResolve();
+  if (st.logged < 4) {
+    ++st.logged;
+    REXGPU_INFO("dbz3: atalho resolve->textura {}x{} dest={:08X} troca_rb={}", width, height,
+                resolve_info.copy_dest_base, swap_rb ? 1 : 0);
+  }
+  return true;
+}
+
 }  // namespace rex::graphics::vulkan
