+  texture_cache.Dbz3EndAttachmentWrite(texture);
+  if ((st.done++ % 30000) == 0) {
+    REXGPU_INFO("dbz3: copia por desenho para a textura: {} ({}x{}, troca R/B {})", st.done, width,
+                height, bgra ? 1 : 0);
+  }
+  return true;
+}
