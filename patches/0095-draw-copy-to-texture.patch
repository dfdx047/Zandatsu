+// ---------------------------------------------------------------------------
+// Dragon Burst (0095): copia por desenho para uma textura 8888 (dbz3_direct_resolve_draw).
+// No Mali as texturas 8888 nao tem STORAGE (a vista SNORM nao o suporta e o STORAGE tiraria a
+// compressao AFBC), por isso o atalho resolve -> textura fazia compute (render target ->
+// buffer linear) + vkCmdCopyBufferToImage: ~8 MB de trafego por resolve de 960x540 (ler o
+// render target, escrever e ler o buffer, escrever a imagem) e duas barreiras compute ->
+// transfer -> leitura. Aqui: um passe com a vista da textura como alvo de cor (0074) e um
+// triangulo de ecra inteiro que le a origem texel a texel (texelFetch em gl_FragCoord): ~4 MB,
+// sem buffer. Exato: UNORM -> float -> UNORM devolve o mesmo byte; a troca R/B (copy_dest_swap)
+// e a vista B8G8R8A8, como no passo 4. Render pass proprio (vale com ou sem dynamic rendering).
+// ---------------------------------------------------------------------------
+namespace dbz3_draw_copy {
+constexpr uint32_t kSetRing = 64;
+struct State {
+  bool init_tried = false;
+  bool ok = false;
+  VkRenderPass render_pass[2] = {};  // 0: R8G8B8A8_UNORM, 1: B8G8R8A8_UNORM
+  VkPipelineLayout layout = VK_NULL_HANDLE;
+  VkPipeline pipeline[2] = {};
+  VkDescriptorPool pool = VK_NULL_HANDLE;
+  VkDescriptorSet sets[kSetRing] = {};
+  uint32_t next_set = 0;
+  std::vector<std::pair<uint64_t, VkFramebuffer>> old_framebuffers;
+  uint64_t done = 0;
+  uint64_t fail[3] = {};
+};
+State g_state;
+
+const char* kVertexSource = R"(#version 450
+void main() {
+  vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)";
+const char* kFragmentSource = R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(set = 0, binding = 0) uniform texture2D src;
+layout(location = 0) out vec4 color;
+void main() { color = texelFetch(src, ivec2(gl_FragCoord.xy), 0); }
+)";
+
+void Fail(uint32_t why) {
+  if ((g_state.fail[why]++ % 600) == 0) {
+    REXGPU_INFO("dbz3: copia por desenho para a textura nao feita ({}; {} vezes), caminho antigo",
+                why, g_state.fail[why]);
+  }
+}
+}  // namespace dbz3_draw_copy
+
+bool VulkanRenderTargetCache::Dbz3DrawCopyInit() {
+  namespace dc = dbz3_draw_copy;
+  dc::State& st = dc::g_state;
+  if (st.init_tried) return st.ok;
+  st.init_tried = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // Anel de descriptor sets para as origens que sao texturas (os render targets tem o seu).
+  VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, dc::kSetRing};
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = dc::kSetRing;
+  pool_info.poolSizeCount = 1;
+  pool_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &st.pool) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: copia por desenho: vkCreateDescriptorPool falhou");
+    return false;
+  }
+  VkDescriptorSetLayout set_layouts[dc::kSetRing];
+  for (uint32_t i = 0; i < dc::kSetRing; ++i) set_layouts[i] = descriptor_set_layout_sampled_image_;
+  VkDescriptorSetAllocateInfo alloc_info = {};
+  alloc_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  alloc_info.descriptorPool = st.pool;
+  alloc_info.descriptorSetCount = dc::kSetRing;
+  alloc_info.pSetLayouts = set_layouts;
+  if (dfn.vkAllocateDescriptorSets(device, &alloc_info, st.sets) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: copia por desenho: vkAllocateDescriptorSets falhou");
+    return false;
+  }
+  VkPipelineLayoutCreateInfo layout_info = {};
+  layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  layout_info.setLayoutCount = 1;
+  layout_info.pSetLayouts = &descriptor_set_layout_sampled_image_;
+  if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &st.layout) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: copia por desenho: vkCreatePipelineLayout falhou");
+    return false;
+  }
+  VkShaderModule modules[2] = {};
+  const VkShaderStageFlagBits stages[2] = {VK_SHADER_STAGE_VERTEX_BIT,
+                                           VK_SHADER_STAGE_FRAGMENT_BIT};
+  const char* sources[2] = {dc::kVertexSource, dc::kFragmentSource};
+  auto destroy_modules = [&] {
+    for (VkShaderModule m : modules) {
+      if (m != VK_NULL_HANDLE) dfn.vkDestroyShaderModule(device, m, nullptr);
+    }
+  };
+  for (uint32_t i = 0; i < 2; ++i) {
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (!command_processor_.CompileGlslToSpirv(stages[i], sources[i], spirv, error)) {
+      REXGPU_ERROR("dbz3: copia por desenho: shader {} nao compilou: {}", i, error);
+      destroy_modules();
+      return false;
+    }
+    VkShaderModuleCreateInfo module_info = {};
+    module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+    module_info.codeSize = spirv.size() * sizeof(uint32_t);
+    module_info.pCode = spirv.data();
+    if (dfn.vkCreateShaderModule(device, &module_info, nullptr, &modules[i]) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: copia por desenho: vkCreateShaderModule falhou");
+      destroy_modules();
+      return false;
+    }
+  }
+  const VkFormat formats[2] = {VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_B8G8R8A8_UNORM};
+  for (uint32_t f = 0; f < 2; ++f) {
+    VkAttachmentDescription attachment = {};
+    attachment.format = formats[f];
+    attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    VkAttachmentReference color_ref = {0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription subpass = {};
+    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    subpass.colorAttachmentCount = 1;
+    subpass.pColorAttachments = &color_ref;
+    VkRenderPassCreateInfo render_pass_info = {};
+    render_pass_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+    render_pass_info.attachmentCount = 1;
+    render_pass_info.pAttachments = &attachment;
+    render_pass_info.subpassCount = 1;
+    render_pass_info.pSubpasses = &subpass;
+    if (dfn.vkCreateRenderPass(device, &render_pass_info, nullptr, &st.render_pass[f]) !=
+        VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: copia por desenho: vkCreateRenderPass falhou");
+      destroy_modules();
+      return false;
+    }
+    VkPipelineShaderStageCreateInfo stage_info[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      stage_info[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stage_info[i].stage = stages[i];
+      stage_info[i].module = modules[i];
+      stage_info[i].pName = "main";
+    }
+    VkPipelineVertexInputStateCreateInfo vertex_input = {};
+    vertex_input.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+    VkPipelineInputAssemblyStateCreateInfo input_assembly = {};
+    input_assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    input_assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport_state = {};
+    viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    viewport_state.viewportCount = 1;
+    viewport_state.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo rasterization = {};
+    rasterization.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+    rasterization.polygonMode = VK_POLYGON_MODE_FILL;
+    rasterization.cullMode = VK_CULL_MODE_NONE;
+    rasterization.frontFace = VK_FRONT_FACE_CLOCKWISE;
+    rasterization.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {};
+    multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState blend_attachment = {};
+    blend_attachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                                      VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+    VkPipelineColorBlendStateCreateInfo blend = {};
+    blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+    blend.attachmentCount = 1;
+    blend.pAttachments = &blend_attachment;
+    const VkDynamicState dynamic_states[2] = {VK_DYNAMIC_STATE_VIEWPORT,
+                                              VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic = {};
+    dynamic.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+    dynamic.dynamicStateCount = 2;
+    dynamic.pDynamicStates = dynamic_states;
+    VkGraphicsPipelineCreateInfo pipeline_info = {};
+    pipeline_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    pipeline_info.stageCount = 2;
+    pipeline_info.pStages = stage_info;
+    pipeline_info.pVertexInputState = &vertex_input;
+    pipeline_info.pInputAssemblyState = &input_assembly;
+    pipeline_info.pViewportState = &viewport_state;
+    pipeline_info.pRasterizationState = &rasterization;
+    pipeline_info.pMultisampleState = &multisample;
+    pipeline_info.pColorBlendState = &blend;
+    pipeline_info.pDynamicState = &dynamic;
+    pipeline_info.layout = st.layout;
+    pipeline_info.renderPass = st.render_pass[f];
+    pipeline_info.subpass = 0;
+    if (dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info, nullptr,
+                                      &st.pipeline[f]) != VK_SUCCESS) {
+      st.pipeline[f] = VK_NULL_HANDLE;
+      REXGPU_ERROR("dbz3: copia por desenho: vkCreateGraphicsPipelines falhou");
+      destroy_modules();
+      return false;
+    }
+  }
+  destroy_modules();
+  st.ok = true;
+  REXGPU_INFO("dbz3: copia por desenho para a textura ativa (atalho resolve -> textura sem buffer)");
+  return true;
+}
+
+VkDescriptorSet VulkanRenderTargetCache::Dbz3DrawCopyTextureSet(VkImageView view) {
+  namespace dc = dbz3_draw_copy;
+  if (view == VK_NULL_HANDLE || !Dbz3DrawCopyInit()) return VK_NULL_HANDLE;
+  dc::State& st = dc::g_state;
+  // Como o contorno: um anel de 64 (poucos por frame, muito mais que os frames em voo).
+  const VkDescriptorSet set = st.sets[st.next_set];
+  st.next_set = (st.next_set + 1) % dc::kSetRing;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorImageInfo image_info = {VK_NULL_HANDLE, view,
+                                      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = set;
+  write.dstBinding = 0;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+  write.pImageInfo = &image_info;
+  vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0,
+                                                    nullptr);
+  return set;
+}
+
+bool VulkanRenderTargetCache::Dbz3DrawCopyToTexture(VkDescriptorSet source_set,
+                                                    VulkanTextureCache& texture_cache,
+                                                    void* texture, uint32_t width,
+                                                    uint32_t height, bool bgra) {
+  namespace dc = dbz3_draw_copy;
+  if (source_set == VK_NULL_HANDLE || !width || !height || !Dbz3DrawCopyInit()) {
+    dc::Fail(0);
+    return false;
+  }
+  dc::State& st = dc::g_state;
+  if (!texture_cache.Dbz3TextureIsRenderable(texture)) {
+    dc::Fail(1);
+    return false;
+  }
+  const VkImageView view = texture_cache.Dbz3GetAttachmentView(texture, bgra);
+  if (view == VK_NULL_HANDLE) {
+    dc::Fail(2);
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // Framebuffers das copias anteriores cujas submissoes ja acabaram.
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  auto end = std::remove_if(st.old_framebuffers.begin(), st.old_framebuffers.end(),
+                            [&](const std::pair<uint64_t, VkFramebuffer>& f) {
+                              if (f.first > completed) return false;
+                              dfn.vkDestroyFramebuffer(device, f.second, nullptr);
+                              return true;
+                            });
+  st.old_framebuffers.erase(end, st.old_framebuffers.end());
+  const uint32_t f = bgra ? 1 : 0;
+  VkFramebufferCreateInfo fb_info = {};
+  fb_info.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+  fb_info.renderPass = st.render_pass[f];
+  fb_info.attachmentCount = 1;
+  fb_info.pAttachments = &view;
+  fb_info.width = width;
+  fb_info.height = height;
+  fb_info.layers = 1;
+  VkFramebuffer framebuffer;
+  if (dfn.vkCreateFramebuffer(device, &fb_info, nullptr, &framebuffer) != VK_SUCCESS) {
+    dc::Fail(0);
+    return false;
+  }
+  st.old_framebuffers.emplace_back(command_processor_.GetCurrentSubmission(), framebuffer);
+
+  // A textura passa a alvo de cor; as barreiras (e o fim do passe do jogo) antes do nosso.
+  texture_cache.Dbz3BeginAttachmentWrite(texture);
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VkRenderPassBeginInfo begin_info = {};
+  begin_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+  begin_info.renderPass = st.render_pass[f];
+  begin_info.framebuffer = framebuffer;
+  begin_info.renderArea = {{0, 0}, {width, height}};
+  command_buffer.CmdVkBeginRenderPass(&begin_info, VK_SUBPASS_CONTENTS_INLINE);
+  // Pipeline externo: o processador volta a ligar o pipeline, o layout e os sets do jogo.
+  command_processor_.BindExternalGraphicsPipeline(st.pipeline[f]);
+  VkViewport viewport = {0.0f, 0.0f, float(width), float(height), 0.0f, 1.0f};
+  command_processor_.SetViewport(viewport);
