index 0000000..fa896b7
--- /dev/null
+++ b/include/rex/graphics/vulkan/dbz3_gpuprof.h
@@ -0,0 +1,154 @@
+#pragma once
+// DBZ3-Android: perfil da GPU por categoria (so com `dbz3_perf_logging`).
+//
+// Escreve timestamps Vulkan FORA dos render passes (nos tilers, como os Adreno, um
+// timestamp dentro de um pass nao diz nada): antes de cada pass comecar e depois
+// de cada pass acabar, e ao entrar/sair de zonas de trabalho conhecidas (resolve,
+// transferencias de render targets, carga de texturas, apresentacao). Cada
+// intervalo entre dois timestamps e atribuido a categoria do primeiro. Assim a
+// linha `dbz3: perf` diz onde vai o tempo de GPU de cada frame.
+//
+// Tudo corre na thread do command processor: estado global simples, sem locks.
+
+#include <array>
+#include <cstdint>
+#include <vector>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::graphics::vulkan::dbz3_gpuprof {
+
+enum Category : uint8_t {
+  kOther = 0,    // fora de passes e de zonas conhecidas (barreiras, copias, etc.)
+  kDraw,         // render passes do jogo (desenho normal)
+  kTransfer,     // passes/dispatches de transferencia e limpeza de render targets (EDRAM)
+  kResolve,      // resolves (copia do EDRAM para memoria do guest)
+  kTexture,      // carga/untile de texturas
+  kSwap,         // gamma + copia para a imagem de saida
+  kCount,
+};
+
+inline constexpr const char* kCategoryNames[kCount] = {"outros",  "desenho", "transfer",
+                                                       "resolve", "texturas", "swap"};
+
+inline constexpr uint32_t kQueryCount = 8192;
+
+struct Pending {
+  uint64_t frame;
+  uint32_t first;  // primeiro indice no pool (os seguintes sao consecutivos, mod kQueryCount)
+  uint32_t count;
+  std::vector<uint8_t> categories;  // categoria do intervalo que comeca em cada marca
+};
+
+struct State {
+  bool enabled = false;
+  bool ok = false;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  uint32_t next_query = 0;
+  uint32_t in_flight = 0;  // indices em submissoes ainda nao lidas
+  // Submissao em gravacao.
+  bool recording = false;
+  uint32_t cur_first = 0;
+  std::vector<uint8_t> cur_categories;
+  // Zona atual (pilha simples) e se o buffer diferido esta dentro de um pass.
+  Category zone = kOther;
+  bool in_pass = false;
+  // Contadores do frame em gravacao (lado CPU), copiados para a janela no swap.
+  std::array<uint32_t, kCount> passes{};
+  uint32_t draws = 0;
+  // Janela de 5 s.
+  std::array<uint64_t, kCount> win_passes{};
+  uint64_t win_draws = 0;
+  uint32_t win_cpu_frames = 0;
+};
+
+inline State g_state;
+
+// Proximo indice livre, ou UINT32_MAX se o pool esta cheio.
+inline uint32_t AllocQuery() {
+  State& st = g_state;
+  if (st.in_flight + uint32_t(st.cur_categories.size()) + 2 >= kQueryCount) {
+    return UINT32_MAX;
+  }
+  uint32_t q = st.next_query;
+  st.next_query = (st.next_query + 1) % kQueryCount;
+  return q;
+}
+
+// Marca um timestamp no buffer diferido. A categoria e a do intervalo que comeca
+// aqui. Template para nao depender do DeferredCommandBuffer neste header.
+template <typename DeferredCommandBufferT>
+inline void Mark(DeferredCommandBufferT& cb, Category category) {
+  State& st = g_state;
+  if (!st.ok || !st.recording || st.in_pass) {
+    return;
+  }
+  // Duas marcas seguidas: a primeira mediria um intervalo vazio, reaproveita-se.
+  if (!st.cur_categories.empty() && cb.Dbz3LastCommandWasTimestamp()) {
+    st.cur_categories.back() = category;
+    return;
+  }
+  uint32_t q = AllocQuery();
+  if (q == UINT32_MAX) {
+    return;
+  }
+  if (st.cur_categories.empty()) {
+    st.cur_first = q;
+  }
+  st.cur_categories.push_back(category);
+  cb.CmdDbz3WriteTimestamp(st.pool, q);
+}
+
+// Chamado pelo buffer diferido ao gravar o inicio/fim de um pass.
+template <typename DeferredCommandBufferT>
+inline void OnBeginPass(DeferredCommandBufferT& cb) {
+  State& st = g_state;
+  Category c = st.zone == kOther ? kDraw : st.zone;
+  ++st.passes[c];
+  Mark(cb, c);
+  st.in_pass = true;
+}
+
+template <typename DeferredCommandBufferT>
+inline void OnEndPass(DeferredCommandBufferT& cb) {
+  State& st = g_state;
+  st.in_pass = false;
+  Mark(cb, st.zone);
+}
+
+// Zona de trabalho (RAII): resolve, transferencias, texturas, swap.
+template <typename DeferredCommandBufferT>
+class Zone {
+ public:
+  Zone(DeferredCommandBufferT& cb, Category category) : cb_(cb), previous_(g_state.zone) {
+    g_state.zone = category;
+    Mark(cb_, category);
+  }
+  ~Zone() {
+    g_state.zone = previous_;
+    Mark(cb_, previous_);
+  }
+  Zone(const Zone&) = delete;
+  Zone& operator=(const Zone&) = delete;
+
+ private:
+  DeferredCommandBufferT& cb_;
+  Category previous_;
+};
+
+inline void CountDraw() { ++g_state.draws; }
+
+// No swap: fecha os contadores CPU do frame.
+inline void OnFrameEnd() {
+  State& st = g_state;
+  for (uint32_t i = 0; i < kCount; ++i) {
+    st.win_passes[i] += st.passes[i];
+    st.passes[i] = 0;
+  }
+  st.win_draws += st.draws;
+  st.draws = 0;
+  ++st.win_cpu_frames;
+}
+
+}  // namespace rex::graphics::vulkan::dbz3_gpuprof
