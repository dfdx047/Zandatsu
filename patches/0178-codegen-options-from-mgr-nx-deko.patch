+        "\t{}.u64 = uint32_t(({}.s32 && !({}.s32 == INT32_MIN && {}.s32 == -1)) ? {}.s32 / {}.s32 : "
+        "0);",
+        rD, rB, rA, rB, rA, rB);
   emitRecordFormCompare(ctx);
   return true;
 }
