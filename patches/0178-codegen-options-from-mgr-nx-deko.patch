+  P::setcsr(decltype(saved)(saved & ~decltype(saved)(P::FlushMask)));
+  REX_DIET_FP_BARRIER(a);
+  REX_DIET_FP_BARRIER(b);
+  cr.compare(a, b);
+  P::setcsr(saved);
