+  // Project SwordMan: ao repetir um frame congelado, nada de interrupcoes, esperas ou swaps
+  // (o jogo esta parado; as escritas de cercas repetem os mesmos valores).
+  if (swordman_replaying_ &&
+      (opcode == PM4_INTERRUPT || opcode == PM4_WAIT_REG_MEM || opcode == PM4_XE_SWAP)) {
+    reader->AdvanceRead(count * sizeof(uint32_t));
+    return true;
+  }
+
   bool result = false;
   switch (opcode) {
     case PM4_ME_INIT:
@@ -961,6 +1013,13 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   // VdSwap will post this to tell us we need to swap the screen/fire an
   // interrupt.
   // 63 words here, but only the first has any data.
+  // Project SwordMan: posicao do pacote do swap no anel (o cabecalho e a palavra antes).
+  const bool swordman_in_primary = reader == swordman_primary_reader_;
+  const uint32_t swordman_ring = primary_buffer_size_ / sizeof(uint32_t);
+  const uint32_t swordman_swap_index =
+      swordman_ring ? static_cast<uint32_t>((reader->read_offset() / sizeof(uint32_t) +
+                                             swordman_ring - 1) % swordman_ring)
+                    : 0;
   uint32_t magic = reader->ReadAndSwap<memory::fourcc_t>();
   assert_true(magic == kSwapSignature);
 
@@ -973,6 +1032,20 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
 
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
+  // Project SwordMan: o proximo frame comeca aqui (para o congelamento).
+  swordman_swap_ptr_ = frontbuffer_ptr;
+  swordman_swap_width_ = frontbuffer_width;
+  swordman_swap_height_ = frontbuffer_height;
+  if (swordman_in_primary && swordman_ring) {
+    swordman_last_frame_start_ = swordman_frame_start_index_;
+    swordman_last_frame_end_ = swordman_swap_index;
+    swordman_frame_start_index_ =
+        static_cast<uint32_t>((reader->read_offset() / sizeof(uint32_t)) % swordman_ring);
+    swordman_frame_valid_ = true;
+  } else {
+    swordman_frame_valid_ = false;
+  }
+
   ++counter_;
   return true;
 }
