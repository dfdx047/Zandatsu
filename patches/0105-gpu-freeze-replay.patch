@@ -261,6 +261,21 @@ class CommandProcessor {
   uint32_t primary_buffer_size_ = 0;
 
   uint32_t read_ptr_index_ = 0;
+
+  // Project SwordMan: congelar a imagem com o jogo parado (autoteste do render). O jogo fica
+  // preso no VdSwap seguinte (pausa do app) e o CP volta a executar os comandos do ultimo
+  // frame completo (de um swap ao seguinte, no anel) e apresenta-o outra vez, com as cvars
+  // de agora.
+  void SwordManReplayFrozenFrame();
+  const memory::RingBuffer* swordman_primary_reader_ = nullptr;
+  bool swordman_replaying_ = false;
+  bool swordman_frame_valid_ = false;
+  uint32_t swordman_frame_start_index_ = 0;    // depois do ultimo swap (frame em curso)
+  uint32_t swordman_last_frame_start_ = 0;     // ultimo frame completo: inicio
+  uint32_t swordman_last_frame_end_ = 0;       // ... e o pacote do swap dele
+  uint32_t swordman_swap_ptr_ = 0;
+  uint32_t swordman_swap_width_ = 0;
+  uint32_t swordman_swap_height_ = 0;
   uint32_t read_ptr_update_freq_ = 0;
   uint32_t read_ptr_writeback_ptr_ = 0;
 
