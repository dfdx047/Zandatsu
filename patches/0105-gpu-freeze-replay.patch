@@ -222,6 +226,13 @@ void CommandProcessor::WorkerThreadMain() {
     }
 
     uint32_t write_ptr_index = write_ptr_index_.load();
+    // Project SwordMan: imagem congelada - o CP ja executou tudo e o jogo esta preso no
+    // VdSwap: repete o ultimo frame ~60 vezes por segundo.
+    if (REXCVAR_GET(swordman_freeze_replay) && read_ptr_index_ == write_ptr_index) {
+      SwordManReplayFrozenFrame();
+      rex::thread::Sleep(std::chrono::milliseconds(16));
+      continue;
+    }
     if (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index) {
       SCOPE_profile_cpu_i("gpu", "rex::graphics::CommandProcessor::Stall");
       // We've run out of commands to execute.
@@ -241,6 +252,7 @@ void CommandProcessor::WorkerThreadMain() {
         loop_count++;
         write_ptr_index = write_ptr_index_.load();
       } while (worker_running_ && pending_fns_.empty() &&
+               !REXCVAR_GET(swordman_freeze_replay) &&
                (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index));
       ReturnFromWait();
       if (!worker_running_ || !pending_fns_.empty()) {
@@ -630,6 +642,7 @@ uint32_t CommandProcessor::ExecutePrimaryBuffer(uint32_t read_index, uint32_t wr
   memory::RingBuffer reader(memory_->TranslatePhysical(primary_buffer_ptr_), primary_buffer_size_);
   reader.set_read_offset(read_index * sizeof(uint32_t));
   reader.set_write_offset(write_index * sizeof(uint32_t));
+  swordman_primary_reader_ = &reader;
   do {
     if (!ExecutePacket(&reader)) {
       // This probably should be fatal - but we're going to continue anyways.
@@ -638,12 +651,43 @@ uint32_t CommandProcessor::ExecutePrimaryBuffer(uint32_t read_index, uint32_t wr
       break;
     }
   } while (reader.read_count());
+  swordman_primary_reader_ = nullptr;
 
   OnPrimaryBufferEnd();
 
   return write_index;
 }
 
+void CommandProcessor::SwordManReplayFrozenFrame() {
+  if (!swordman_frame_valid_ || swordman_last_frame_start_ == swordman_last_frame_end_) {
+    return;
+  }
+  // O frame tem de continuar inteiro no anel (o frame seguinte, ja comecado, nao o pode ter
+  // escrito por cima).
+  const uint32_t ring = primary_buffer_size_ / sizeof(uint32_t);
+  auto dist = [ring](uint32_t from, uint32_t to) { return (to + ring - from) % ring; };
+  const uint32_t frame_len = dist(swordman_last_frame_start_, swordman_last_frame_end_);
+  const uint32_t after_len = dist(swordman_last_frame_end_, read_ptr_index_);
+  static uint32_t logged_state = 0;
+  if (!ring || frame_len + after_len >= ring) {
+    if (logged_state != 2) {
+      logged_state = 2;
+      REXGPU_WARN("swordman: imagem congelada indisponivel (frame {} + {} palavras, anel {})",
+                  frame_len, after_len, ring);
+    }
+    return;
+  }
+  if (logged_state != 1) {
+    logged_state = 1;
+    REXGPU_INFO("swordman: imagem congelada (repete o anel {}..{}, {} palavras)",
+                swordman_last_frame_start_, swordman_last_frame_end_, frame_len);
+  }
+  swordman_replaying_ = true;
+  ExecutePrimaryBuffer(swordman_last_frame_start_, swordman_last_frame_end_);
+  swordman_replaying_ = false;
+  IssueSwap(swordman_swap_ptr_, swordman_swap_width_, swordman_swap_height_);
+}
+
 void CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
