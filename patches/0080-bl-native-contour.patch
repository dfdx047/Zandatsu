+uint32_t Dbz3RecognizeContour(const RegisterFile& regs, const memory::Memory& memory,
+                              const VulkanShader& vertex_shader, bool indexed,
+                              VulkanRenderTargetCache::Dbz3ContourParams& out) {
+  constexpr uint32_t kW = 1280, kH = 720;
+  if (indexed) return 1;
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto color = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
