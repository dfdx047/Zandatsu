+bool g_learn = false;
+bool g_dirty = false;  // houve um draw feito entre o quad saltado e o resolve
+VulkanRenderTargetCache::Dbz3ContourParams g_params = {};
+uint32_t g_dest = 0;
+uint32_t g_dest_endian = 0;
+bool g_dest_swap = false;
+uint64_t g_done = 0;
+uint64_t g_fail = 0;
+uint64_t g_frames = 0;
+uint64_t g_not_yet[8] = {};
+bool g_active_logged = false;
+
+constexpr uint32_t kSetRing = 64;
+struct State {
+  bool init_tried = false;
+  bool ok = false;
+  VkPipelineLayout layout = VK_NULL_HANDLE;
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  VkDescriptorPool pool = VK_NULL_HANDLE;
+  VkDescriptorSet sets[kSetRing] = {};
+  uint32_t next_set = 0;
+};
+State g_state;
+
+struct PushConstants {
+  float colors[3][4];
+  float ids[4];
+  float scale;
+  uint32_t width;
+  uint32_t height;
+  uint32_t flags;  // bits 0-1: canal do ID; bit 2: troca R/B (copy_dest_swap)
+};
+static_assert(sizeof(PushConstants) == 80, "contorno: push constants");
+
+// O mesmo que o PS ABBF..., em GLSL (a referencia em numpy, tools/ref_contour.py, faz estas
+// mesmas contas). A aresta e "algum vizinho com outro ID" porque c254.w = 0 (reconhecimento).
+const char* kSource = R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Dest { uint dest[]; };
+layout(set = 1, binding = 0) uniform texture2D id_tex;
+layout(set = 1, binding = 1) uniform texture2D depth_tex;
+layout(push_constant) uniform Constants {
+  vec4 color0;
+  vec4 color1;
+  vec4 color2;
+  vec4 ids;
+  float scale;
+  uint width;
+  uint height;
+  uint flags;
+} pc;
+float IdAt(ivec2 p) {
+  p = clamp(p, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
+  return floor(texelFetch(id_tex, p, 0)[pc.flags & 3u] * pc.scale);
+}
+float DepthAt(ivec2 p) {
+  if (p.x < 0 || p.y < 0 || p.x >= int(pc.width) || p.y >= int(pc.height)) return 0.0;
+  return texelFetch(depth_tex, p, 0).r;
+}
+void main() {
+  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+  if (uint(p.x) >= pc.width || uint(p.y) >= pc.height) return;
+  float il = IdAt(p + ivec2(-1, 0));
+  float ir = IdAt(p + ivec2(1, 0));
+  float iu = IdAt(p + ivec2(0, -1));
+  float id = IdAt(p + ivec2(0, 1));
+  uint v = 0u;
+  if (il != ir || il != iu || il != id) {
+    float dl = DepthAt(p + ivec2(-1, 0));
+    float dr = DepthAt(p + ivec2(1, 0));
+    float du = DepthAt(p + ivec2(0, -1));
+    float dd = DepthAt(p + ivec2(0, 1));
+    float near_id = dr > dl ? il : ir;
+    float m2 = min(dl, dr);
+    if (m2 > du) near_id = iu;
+    if (min(m2, du) > dd) near_id = id;
+    vec4 c = vec4(0.0);
+    if (near_id == pc.ids.x) c = pc.color0;
+    if (near_id == pc.ids.y) c = pc.color1;
+    if (near_id == pc.ids.z) c = pc.color2;
+    uvec4 u = uvec4(clamp(c, 0.0, 1.0) * 255.0 + 0.5);
+    if ((pc.flags & 4u) != 0u) u.rb = u.br;
+    v = u.r | (u.g << 8u) | (u.b << 16u) | (u.a << 24u);
+  }
+  dest[uint(p.y) * pc.width + uint(p.x)] = v;
+}
+)";
+
+bool NotYet(uint32_t why) {
+  g_pending = false;
+  g_learn = true;
+  if ((g_not_yet[why & 7]++ % 600) == 0) {
+    REXGPU_INFO("dbz3: render nativo: contorno ainda nao ({})", why);
+  }
+  return false;
+}
+}  // namespace dbz3_native_contour
+
+bool VulkanRenderTargetCache::Dbz3NativeContourInit() {
+  namespace nc = dbz3_native_contour;
+  nc::State& st = nc::g_state;
+  if (st.init_tried) {
+    return st.ok;
+  }
+  st.init_tried = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, nc::kSetRing * 2};
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = nc::kSetRing;
+  pool_info.poolSizeCount = 1;
+  pool_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &st.pool) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: render nativo: contorno: vkCreateDescriptorPool falhou");
+    return false;
+  }
+  VkDescriptorSetLayout set_layouts[nc::kSetRing];
+  for (uint32_t i = 0; i < nc::kSetRing; ++i) {
+    set_layouts[i] = descriptor_set_layout_sampled_image_x2_;
+  }
+  VkDescriptorSetAllocateInfo alloc_info = {};
+  alloc_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  alloc_info.descriptorPool = st.pool;
+  alloc_info.descriptorSetCount = nc::kSetRing;
+  alloc_info.pSetLayouts = set_layouts;
+  if (dfn.vkAllocateDescriptorSets(device, &alloc_info, st.sets) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: render nativo: contorno: vkAllocateDescriptorSets falhou");
+    return false;
+  }
+  VkDescriptorSetLayout layouts[2] = {
+      command_processor_.GetSingleTransientDescriptorLayout(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+      descriptor_set_layout_sampled_image_x2_};
+  VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    uint32_t(sizeof(nc::PushConstants))};
+  VkPipelineLayoutCreateInfo layout_info = {};
+  layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  layout_info.setLayoutCount = 2;
+  layout_info.pSetLayouts = layouts;
+  layout_info.pushConstantRangeCount = 1;
+  layout_info.pPushConstantRanges = &push_range;
+  if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &st.layout) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: render nativo: contorno: vkCreatePipelineLayout falhou");
+    return false;
+  }
+  std::vector<uint32_t> spirv;
+  std::string error;
+  if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, nc::kSource, spirv,
+                                             error)) {
+    REXGPU_ERROR("dbz3: render nativo: contorno: shader nao compilou: {}", error);
+    return false;
+  }
+  VkShaderModuleCreateInfo module_info = {};
+  module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+  module_info.codeSize = spirv.size() * sizeof(uint32_t);
+  module_info.pCode = spirv.data();
+  VkShaderModule module = VK_NULL_HANDLE;
+  if (dfn.vkCreateShaderModule(device, &module_info, nullptr, &module) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: render nativo: contorno: vkCreateShaderModule falhou");
+    return false;
+  }
+  VkComputePipelineCreateInfo pipeline_info = {};
+  pipeline_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+  pipeline_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+  pipeline_info.stage.module = module;
+  pipeline_info.stage.pName = "main";
+  pipeline_info.layout = st.layout;
+  const VkResult result = dfn.vkCreateComputePipelines(device, Dbz3GetDriverPipelineCache(), 1,
+                                                       &pipeline_info, nullptr, &st.pipeline);
+  dfn.vkDestroyShaderModule(device, module, nullptr);
+  if (result != VK_SUCCESS) {
+    st.pipeline = VK_NULL_HANDLE;
+    REXGPU_ERROR("dbz3: render nativo: contorno: vkCreateComputePipelines falhou");
+    return false;
+  }
+  Dbz3MarkDriverPipelineCacheDirty();
+  st.ok = true;
+  return true;
+}
+
+bool VulkanRenderTargetCache::Dbz3NativeContourBegin(VulkanTextureCache& texture_cache,
+                                                     const Dbz3ContourParams& params) {
+  namespace nc = dbz3_native_contour;
+  if (GetPath() != Path::kHostRenderTargets || IsDrawResolutionScaled()) {
+    return nc::NotYet(0);
+  }
+  if (!nc::g_dest) {
+    return nc::NotYet(1);  // o primeiro frame ensina o destino
+  }
+  void* found[4];
+  if (!texture_cache.Dbz3FindResolveTextures(nc::g_dest, params.width, params.height,
+                                             xenos::TextureFormat::k_8_8_8_8, false,
+                                             xenos::Endian(nc::g_dest_endian), found, 4)) {
+    return nc::NotYet(2);
+  }
+  void* id_texture = texture_cache.Dbz3FindResolveTexture(
+      params.id_base, params.width, params.height, xenos::Endian(params.id_endian),
+      xenos::TextureFormat::k_8_8_8_8);
+  if (!id_texture || !texture_cache.Dbz3TextureUpToDate(id_texture)) {
+    return nc::NotYet(3);
+  }
+  void* depth_texture = texture_cache.Dbz3FindResolveTexture(
+      params.depth_base, params.width, params.height, xenos::Endian(params.depth_endian),
+      xenos::TextureFormat::k_32_FLOAT);
+  if (!depth_texture || !texture_cache.Dbz3TextureUpToDate(depth_texture)) {
+    return nc::NotYet(4);
+  }
+  if (texture_cache.Dbz3GetSampledView(id_texture) == VK_NULL_HANDLE ||
+      texture_cache.Dbz3GetSampledView(depth_texture) == VK_NULL_HANDLE) {
+    return nc::NotYet(5);
+  }
+  if (!Dbz3NativeContourInit()) {
+    return nc::NotYet(6);
+  }
+  nc::g_params = params;
+  nc::g_pending = true;
+  nc::g_learn = false;
+  nc::g_dirty = false;
+  return true;
+}
+
+void VulkanRenderTargetCache::Dbz3NativeContourFrameEnd() {
+  namespace nc = dbz3_native_contour;
+  nc::g_pending = false;
+  nc::g_learn = false;
+  if ((++nc::g_frames % 3000) == 0 && (nc::g_done || nc::g_fail)) {
+    REXGPU_INFO(
+        "dbz3: render nativo: contorno por compute: {} passes, {} falhas, ainda nao "
+        "{}/{}/{}/{}/{}/{}/{} (frame {})",
+        nc::g_done, nc::g_fail, nc::g_not_yet[0], nc::g_not_yet[1], nc::g_not_yet[2],
+        nc::g_not_yet[3], nc::g_not_yet[4], nc::g_not_yet[5], nc::g_not_yet[6], nc::g_frames);
+  }
+}
+
+bool VulkanRenderTargetCache::Dbz3NativeContourResolve(
+    const draw_util::ResolveInfo& resolve_info, VulkanTextureCache& texture_cache) {
+  namespace nc = dbz3_native_contour;
+  const bool pending = nc::g_pending;
+  nc::g_pending = false;
+  const nc::State& st = nc::g_state;
+  const Dbz3ContourParams& prm = nc::g_params;
+  const draw_util::ResolveEdramInfo& src = resolve_info.color_edram_info;
+  const uint32_t width = uint32_t(resolve_info.coordinate_info.width_div_8) * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  // O resolve que fecha o passe do contorno: cor 0 8888 1x do render target do quad, sem
+  // limpeza, de (0,0) a (0,0) do destino, 8888 sem expoente.
+  const bool matches =
+      !resolve_info.IsCopyingDepth() && !resolve_info.IsClearingDepth() &&
+      !resolve_info.IsClearingColor() && resolve_info.copy_dest_extent_length &&
+      resolve_info.rb_copy_control.copy_src_select == 0 && !src.format_is_64bpp &&
+      xenos::ColorRenderTargetFormat(src.format) == xenos::ColorRenderTargetFormat::k_8_8_8_8 &&
+      src.msaa_samples == xenos::MsaaSamples::k1X && src.pitch_tiles == prm.width / 80 &&
+      src.base_tiles == prm.color_base_tiles &&
+      resolve_info.copy_dest_info.copy_dest_format == xenos::ColorFormat::k_8_8_8_8 &&
+      resolve_info.copy_dest_info.copy_dest_exp_bias == 0 &&
+      uint32_t(resolve_info.copy_dest_info.copy_dest_endian) <= 3 &&
+      resolve_info.coordinate_info.edram_offset_x_div_8 == 0 &&
+      resolve_info.coordinate_info.edram_offset_y_div_8 == 0 &&
+      resolve_info.copy_dest_coordinate_info.offset_x_div_8 == 0 &&
+      resolve_info.copy_dest_coordinate_info.offset_y_div_8 == 0 &&
+      uint32_t(resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32) * 32 ==
+          ((prm.width + 31) & ~31u) &&
+      resolve_info.copy_dest_base == resolve_info.copy_dest_extent_start && width == prm.width &&
+      height == prm.height;
+  const uint32_t endian = uint32_t(resolve_info.copy_dest_info.copy_dest_endian);
+  const bool swap = resolve_info.copy_dest_info.copy_dest_swap != 0;
+  if (nc::g_learn) {
+    // A aprender: este resolve segue o caminho normal (ou o do passo 4).
+    nc::g_learn = false;
+    if (matches && (nc::g_dest != resolve_info.copy_dest_base || nc::g_dest_endian != endian ||
+                    nc::g_dest_swap != swap)) {
+      nc::g_dest = resolve_info.copy_dest_base;
+      nc::g_dest_endian = endian;
+      nc::g_dest_swap = swap;
+      REXGPU_INFO("dbz3: render nativo: contorno -> {:08X} (endian {}, troca R/B {})",
+                  nc::g_dest, endian, swap ? 1 : 0);
+    }
+    return false;
+  }
+  if (!pending) {
+    return false;
+  }
+  auto fail = [&](uint32_t why) {
+    if ((nc::g_fail++ % 600) == 0) {
+      REXGPU_WARN("dbz3: render nativo: contorno falhou ({}), volta ao caminho normal", why);
+    }
+    nc::g_dest = 0;
+    return false;
+  };
+  if (!matches || resolve_info.copy_dest_base != nc::g_dest || endian != nc::g_dest_endian ||
+      swap != nc::g_dest_swap) {
+    return fail(1);
+  }
+  if (nc::g_dirty) {
+    return fail(7);
+  }
+  void* found[4];
+  const uint32_t n = texture_cache.Dbz3FindResolveTextures(
+      resolve_info.copy_dest_base, width, height, xenos::TextureFormat::k_8_8_8_8, false,
+      xenos::Endian(endian), found, 4);
+  void* id_texture = texture_cache.Dbz3FindResolveTexture(
+      prm.id_base, prm.width, prm.height, xenos::Endian(prm.id_endian),
+      xenos::TextureFormat::k_8_8_8_8);
+  void* depth_texture = texture_cache.Dbz3FindResolveTexture(
+      prm.depth_base, prm.width, prm.height, xenos::Endian(prm.depth_endian),
+      xenos::TextureFormat::k_32_FLOAT);
+  if (!n) {
+    return fail(2);
+  }
+  if (!id_texture || !depth_texture || !texture_cache.Dbz3TextureUpToDate(id_texture) ||
+      !texture_cache.Dbz3TextureUpToDate(depth_texture)) {
+    return fail(3);
+  }
+  const VkImageView id_view = texture_cache.Dbz3GetSampledView(id_texture);
+  const VkImageView depth_view = texture_cache.Dbz3GetSampledView(depth_texture);
+  if (!st.ok || id_view == VK_NULL_HANDLE || depth_view == VK_NULL_HANDLE) {
+    return fail(4);
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const VkDeviceSize buffer_size = VkDeviceSize(width) * height * 4;
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch =
+      command_processor_.AcquireScratchGpuBuffer(buffer_size, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                                 VK_ACCESS_SHADER_WRITE_BIT);
+  const VkBuffer scratch_buffer = scratch.buffer();
+  if (scratch_buffer == VK_NULL_HANDLE) {
+    return fail(5);
+  }
+  const VkDescriptorSet dest_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (dest_set == VK_NULL_HANDLE) {
+    return fail(6);
+  }
+  // A partir daqui o resolve e nosso: as outras texturas deste intervalo ficam invalidas e as
+  // do destino voltam a ficar carregadas na copia.
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                    resolve_info.copy_dest_extent_length);
+  texture_cache.Dbz3BeginComputeRead(id_texture);
+  texture_cache.Dbz3BeginComputeRead(depth_texture);
+  // Anel de sets: 2 passes por frame, um set so volta a ser escrito ~30 frames depois.
+  const VkDescriptorSet source_set = st.sets[nc::g_state.next_set];
+  nc::g_state.next_set = (nc::g_state.next_set + 1) % nc::kSetRing;
+  VkDescriptorImageInfo image_infos[2] = {
+      {VK_NULL_HANDLE, id_view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, depth_view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL}};
+  VkDescriptorBufferInfo buffer_info = {scratch_buffer, 0, buffer_size};
+  VkWriteDescriptorSet writes[3] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = source_set;
+    writes[i].dstBinding = i;
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    writes[i].pImageInfo = &image_infos[i];
+  }
+  writes[2].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  writes[2].dstSet = dest_set;
+  writes[2].dstBinding = 0;
+  writes[2].descriptorCount = 1;
+  writes[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  writes[2].pBufferInfo = &buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+
+  nc::PushConstants pc = {};
+  std::memcpy(pc.colors, prm.colors, sizeof(pc.colors));
+  std::memcpy(pc.ids, prm.ids, sizeof(pc.ids));
+  pc.scale = prm.scale;
+  pc.width = width;
+  pc.height = height;
+  pc.flags = (prm.id_channel & 3u) | (swap ? 4u : 0u);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(st.pipeline);
+  VkDescriptorSet sets[2] = {dest_set, source_set};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, st.layout, 0, 2, sets, 0,
+                                         nullptr);
+  command_buffer.CmdVkPushConstants(st.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc), &pc);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  for (uint32_t i = 0; i < n; ++i) {
+    const uint32_t tex_height = std::min(height, texture_cache.Dbz3TextureHeight(found[i]));
+    texture_cache.Dbz3CopyToResolveTexture(found[i], scratch_buffer, width, tex_height,
+                                           scratch.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT),
+                                           scratch.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT));
+  }
+  dbz3_resolve_dedupe::ForgetHolder(resolve_info.copy_dest_base);
+  ++nc::g_done;
+  if (!nc::g_active_logged) {
+    nc::g_active_logged = true;
+    REXGPU_INFO(
+        "dbz3: render nativo: contorno por compute ativo ({:08X} <- IDs {:08X} canal {}, "
+        "profundidade {:08X}; {} textura(s), troca R/B {})",
+        resolve_info.copy_dest_base, prm.id_base, prm.id_channel, prm.depth_base, n,
+        swap ? 1 : 0);
+  }
+  return true;
+}
+
 }  // namespace rex::graphics::vulkan
