+  for (uint32_t v = 0; v < 4; ++v) {
+    float f[4];
+    for (uint32_t k = 0; k < 4; ++k) {
+      uint32_t bits;
+      std::memcpy(&bits, data + (v * 4 + k) * 4, 4);
+      if (vf.endian == xenos::Endian::k8in32) bits = rex::byte_swap(bits);
+      std::memcpy(&f[k], &bits, 4);
+    }
+    if ((f[0] != -0.5f && f[0] != 0.5f) || (f[1] != -0.5f && f[1] != 0.5f) ||
+        f[2] != (f[0] + 0.5f) * float(kW) + 0.5f || f[3] != (0.5f - f[1]) * float(kH) + 0.5f) {
+      return 6;
+    }
+    corners |= 1u << ((f[0] > 0 ? 1 : 0) | (f[1] > 0 ? 2 : 0));
+  }
+  if (corners != 0xF) return 6;
