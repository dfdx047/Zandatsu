+    return m == xenos::ClampMode::kClampToEdge || m == xenos::ClampMode::kClampToHalfway;
+  };
+  const xenos::TextureSign t0_signs[4] = {t0.sign_x, t0.sign_y, t0.sign_z, t0.sign_w};
+  if (t0.type != xenos::FetchConstantType::kTexture ||
+      t0.dimension != xenos::DataDimension::k2DOrStacked ||
+      t0.format != xenos::TextureFormat::k_8_8_8_8 || !t0.tiled ||
+      uint32_t(t0.size_2d.width) + 1 != kW || uint32_t(t0.size_2d.height) + 1 != kH ||
+      z_source > 3 || t0_signs[z_source] != xenos::TextureSign::kUnsigned || t0.num_format ||
+      t0.exp_adjust != 0 || t0.mag_filter != xenos::TextureFilter::kPoint ||
+      t0.min_filter != xenos::TextureFilter::kPoint || !edge_clamp(t0.clamp_x) ||
+      !edge_clamp(t0.clamp_y) || t0.mip_max_level != 0) {
+    return 8;
+  }
+  // tf1: profundidade linear (32_FLOAT 1280x720, ponto, fora da imagem = borda preta = 0).
+  const xenos::xe_gpu_texture_fetch_t t1 = regs.GetTextureFetch(1);
+  if (t1.type != xenos::FetchConstantType::kTexture ||
+      t1.dimension != xenos::DataDimension::k2DOrStacked ||
+      t1.format != xenos::TextureFormat::k_32_FLOAT || !t1.tiled ||
+      uint32_t(t1.size_2d.width) + 1 != kW || uint32_t(t1.size_2d.height) + 1 != kH ||
+      (t1.swizzle & 7) != 0 || t1.exp_adjust != 0 ||
+      t1.mag_filter != xenos::TextureFilter::kPoint ||
+      t1.min_filter != xenos::TextureFilter::kPoint ||
+      t1.clamp_x != xenos::ClampMode::kClampToBorder ||
+      t1.clamp_y != xenos::ClampMode::kClampToBorder ||
+      t1.border_color != xenos::BorderColor::k_ABGR_Black || t1.mip_max_level != 0) {
+    return 9;
+  }
+  out.width = kW;
+  out.height = kH;
+  out.id_base = (uint32_t(t0.base_address) << 12) & 0x1FFFFFFF;
+  out.id_endian = uint32_t(t0.endianness);
+  out.id_channel = z_source;
+  out.depth_base = (uint32_t(t1.base_address) << 12) & 0x1FFFFFFF;
+  out.depth_endian = uint32_t(t1.endianness);
+  out.color_base_tiles = color.color_base;
+  return 0;
