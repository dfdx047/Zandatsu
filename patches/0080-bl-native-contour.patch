+bool VulkanTextureCache::Dbz3TextureUpToDate(void* texture_opaque) const {
+  return static_cast<Texture*>(texture_opaque)->outdated_mask() == 0;
+}
+
+VkImageView VulkanTextureCache::Dbz3GetSampledView(void* texture_opaque) {
+  auto* t = static_cast<VulkanTexture*>(static_cast<Texture*>(texture_opaque));
+  return t->GetView(false, xenos::XE_GPU_TEXTURE_SWIZZLE_RGBA, false);
+}
+
+void VulkanTextureCache::Dbz3BeginComputeRead(void* texture_opaque) {
+  VulkanTexture& vulkan_texture =
+      *static_cast<VulkanTexture*>(static_cast<Texture*>(texture_opaque));
+  vulkan_texture.MarkAsUsed();
+  const VulkanTexture::Usage old_usage =
+      vulkan_texture.SetUsage(VulkanTexture::Usage::kDbz3ComputeSampled);
+  if (old_usage == VulkanTexture::Usage::kDbz3ComputeSampled) {
+    return;
+  }
+  VkPipelineStageFlags src_stage, dst_stage;
+  VkAccessFlags src_access, dst_access;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage, src_access, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kDbz3ComputeSampled, dst_stage, dst_access,
+                       new_layout);
+  if (!src_stage) {
+    src_stage = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  command_processor_.PushImageMemoryBarrier(vulkan_texture.image(),
+                                            ui::vulkan::util::InitializeSubresourceRange(),
+                                            src_stage, dst_stage, src_access, dst_access,
+                                            old_layout, new_layout);
+}
+
