+  auto rf = [&](uint32_t reg_index) {
+    float f;
+    std::memcpy(&f, &regs.values[reg_index], sizeof(f));
+    return f;
+  };
+  if ((tl & 0x7FFF7FFF) != 0 || (br & 0x7FFF) < kW || ((br >> 16) & 0x7FFF) < kH ||
+      regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET] != 0 || !vte.vport_x_scale_ena ||
+      !vte.vport_x_offset_ena || !vte.vport_y_scale_ena || !vte.vport_y_offset_ena ||
+      vte.vtx_xy_fmt || rf(XE_GPU_REG_PA_CL_VPORT_XSCALE) != 640.0f ||
+      rf(XE_GPU_REG_PA_CL_VPORT_XOFFSET) != 640.0f ||
+      rf(XE_GPU_REG_PA_CL_VPORT_YSCALE) != -360.0f ||
+      rf(XE_GPU_REG_PA_CL_VPORT_YOFFSET) != 360.0f) {
+    return 4;
+  }
+  auto vsc = [&](uint32_t n, uint32_t k) { return rf(XE_GPU_REG_SHADER_CONSTANT_000_X + n * 4 + k); };
+  auto psc = [&](uint32_t n, uint32_t k) { return rf(XE_GPU_REG_SHADER_CONSTANT_256_X + n * 4 + k); };
+  // c0..c4 do VS bit a bit como nas capturas (c2.z = -1.0001, c3.z = 999.0999: o z fica dentro
