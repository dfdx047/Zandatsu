   if (!sdl_window_) {
     return;
   }
+#if REX_PLATFORM_ANDROID
+  // DBZ3-Android: sempre ecra inteiro (ver OpenImpl).
+  SDL_SetWindowFullscreen(sdl_window_, true);
+#else
   SDL_SetWindowFullscreen(sdl_window_, IsFullscreen());
+#endif
 }
 
