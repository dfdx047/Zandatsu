+// ---------------------------------------------------------------------------
+// Dragon Burst: render nativo, passo 2 (dbz3_bl_native_linear_depth).
+// O Burst Limit converte a profundidade (resolvida para 0E921000, k_24_8) em profundidade
+// linear com um quad de ecra inteiro (PS D9872B5AFB5E0BEC: A / (A - d * B), A = c255.x,
+// B = c255.y) num render target 32_FLOAT e resolve-o para uma textura k_32_FLOAT
+// (0F451000). Aqui o draw e o resolve sao trocados por um compute que le a profundidade
+// direto do render target (ainda intacto: entre o resolve da profundidade e o quad nada
+// desenha) e escreve na textura k_32_FLOAT por imageStore.
+// ---------------------------------------------------------------------------
+namespace dbz3_native_ld {
+bool g_pending = false;
+bool g_learn = false;
+uint32_t g_dest = 0;
+uint32_t g_depth_base = 0;
+uint32_t g_pitch_tiles = 0;
+float g_a = 0.0f;
+float g_b = 0.0f;
+uint64_t g_done = 0;
+uint64_t g_fail = 0;
+}  // namespace dbz3_native_ld
+
+VulkanRenderTargetCache::RenderTarget* VulkanRenderTargetCache::Dbz3NativeLinearDepthSource(
+    uint32_t depth_base_tiles, uint32_t pitch_tiles, uint32_t height) const {
+  if (GetPath() != Path::kHostRenderTargets || !pitch_tiles || !height) {
+    return nullptr;
+  }
+  const uint32_t rows = (height + 15) / 16;
+  RenderTarget* owner = GetSingleOwner(depth_base_tiles, 0, pitch_tiles * rows);
+  if (!owner) {
+    return nullptr;
+  }
+  const RenderTargetKey key = owner->key();
+  if (!key.is_depth || key.msaa_samples != xenos::MsaaSamples::k1X ||
+      key.base_tiles != depth_base_tiles || key.pitch_tiles_at_32bpp != pitch_tiles ||
+      xenos::DepthRenderTargetFormat(key.resource_format) !=
+          xenos::DepthRenderTargetFormat::kD24S8) {
+    return nullptr;
+  }
+  return owner;
+}
+
+bool VulkanRenderTargetCache::Dbz3NativeLinearDepthReady(VulkanTextureCache& texture_cache,
+                                                         uint32_t depth_base_tiles,
+                                                         uint32_t pitch_tiles, uint32_t width,
+                                                         uint32_t height) {
+  if (!dbz3_native_ld::g_dest) {
+    return false;
+  }
+  if (!Dbz3NativeLinearDepthSource(depth_base_tiles, pitch_tiles, height)) {
+    return false;
+  }
+  void* found[4];
+  const uint32_t n = texture_cache.Dbz3FindResolveTextures(
+      dbz3_native_ld::g_dest, width, height, xenos::TextureFormat::k_32_FLOAT, true,
+      xenos::Endian::kNone, found, 4);
+  if (!n) {
+    return false;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    if (!texture_cache.Dbz3TextureHasStorage(found[i])) {
+      return false;
+    }
+  }
+  return Dbz3StoreInit() && Dbz3StorePipeline(6) != VK_NULL_HANDLE;
+}
+
+bool VulkanRenderTargetCache::Dbz3NativeLinearDepthResolve(
+    const draw_util::ResolveInfo& resolve_info, VulkanTextureCache& texture_cache) {
+  const bool pending = dbz3_native_ld::g_pending;
+  dbz3_native_ld::g_pending = false;
+  const bool matches =
+      !resolve_info.IsCopyingDepth() && !resolve_info.IsClearingDepth() &&
+      !resolve_info.IsClearingColor() && resolve_info.copy_dest_extent_length &&
+      xenos::ColorRenderTargetFormat(resolve_info.color_edram_info.format) ==
+          xenos::ColorRenderTargetFormat::k_32_FLOAT &&
+      resolve_info.copy_dest_info.copy_dest_format == xenos::ColorFormat::k_32_FLOAT &&
+      resolve_info.copy_dest_info.copy_dest_exp_bias == 0 &&
+      resolve_info.coordinate_info.edram_offset_x_div_8 == 0 &&
+      resolve_info.coordinate_info.edram_offset_y_div_8 == 0 &&
+      resolve_info.copy_dest_coordinate_info.offset_x_div_8 == 0 &&
+      resolve_info.copy_dest_coordinate_info.offset_y_div_8 == 0;
+  if (dbz3_native_ld::g_learn) {
+    // Primeira vez: so aprende o destino; este resolve segue o caminho normal.
+    dbz3_native_ld::g_learn = false;
+    if (matches) {
+      dbz3_native_ld::g_dest = resolve_info.copy_dest_base;
+      REXGPU_INFO("dbz3: render nativo: profundidade linear -> {:08X}",
+                  resolve_info.copy_dest_base);
+    }
+    return false;
+  }
+  if (!pending) {
+    return false;
+  }
+  const uint32_t width = uint32_t(resolve_info.coordinate_info.width_div_8) * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  auto fail = [&](uint32_t why) {
+    if ((dbz3_native_ld::g_fail++ % 600) == 0) {
+      REXGPU_WARN("dbz3: render nativo: profundidade linear falhou ({}), volta ao caminho normal",
+                  why);
+    }
+    dbz3_native_ld::g_dest = 0;
+    return false;
+  };
+  if (!matches || resolve_info.copy_dest_base != dbz3_native_ld::g_dest) {
+    return fail(1);
+  }
+  RenderTarget* source =
+      Dbz3NativeLinearDepthSource(dbz3_native_ld::g_depth_base, dbz3_native_ld::g_pitch_tiles,
+                                  height);
+  if (!source) {
+    return fail(2);
+  }
+  void* found[4];
+  const uint32_t n = texture_cache.Dbz3FindResolveTextures(
+      resolve_info.copy_dest_base, width, height, xenos::TextureFormat::k_32_FLOAT, true,
+      xenos::Endian::kNone, found, 4);
+  if (!n) {
+    return fail(3);
+  }
+  auto& rt = *static_cast<VulkanRenderTarget*>(source);
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                    resolve_info.copy_dest_extent_length);
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(),
+      ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_DEPTH_BIT |
+                                                   VK_IMAGE_ASPECT_STENCIL_BIT),
+      rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rt.current_access_mask(),
+      VK_ACCESS_SHADER_READ_BIT, rt.current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+              VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  uint32_t raw[2];
+  std::memcpy(&raw[0], &dbz3_native_ld::g_a, sizeof(float));
+  std::memcpy(&raw[1], &dbz3_native_ld::g_b, sizeof(float));
+  bool any = false;
+  for (uint32_t i = 0; i < n; ++i) {
+    const uint32_t tex_height = std::min(height, texture_cache.Dbz3TextureHeight(found[i]));
+    if (texture_cache.Dbz3TextureHasStorage(found[i]) &&
+        Dbz3StoreToTexture(6, rt.GetDescriptorSetTransferSource(), texture_cache, found[i], width,
+                           tex_height, false, 1, raw)) {
+      any = true;
+    }
+  }
+  if (!any) {
+    // A memoria ja foi marcada como resolvida; sem nada escrito a textura recarrega o
+    // conteudo antigo. Melhor que nada, e o proximo frame volta ao caminho normal.
+    return fail(4);
+  }
+  if ((++dbz3_native_ld::g_done % 3000) == 1) {
+    REXGPU_INFO("dbz3: render nativo: profundidade linear por compute ({} frames, A={} B={})",
+                dbz3_native_ld::g_done, dbz3_native_ld::g_a, dbz3_native_ld::g_b);
+  }
+  return true;
+}
+
 }  // namespace rex::graphics::vulkan
