+// Dragon Burst (0098): a guest access violation that nobody can service. Logs
+// the guest page table entry and the host mapping once, shows a message box
+// and aborts, instead of letting the faulting instruction retry forever.
+bool Memory::FatalGuestAccessViolation(std::unique_lock<std::recursive_mutex> global_lock,
+                                       BaseHeap* heap, uint32_t virtual_address,
+                                       void* host_address, bool is_write) {
+  // A racing Protect/commit on another thread may have fixed the page already.
+  {
+    size_t length = rex::memory::page_size();
+    rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+    if (rex::memory::QueryProtect(host_address, length, access) &&
+        access != rex::memory::PageAccess::kNoAccess &&
+        (!is_write || (access != rex::memory::PageAccess::kReadOnly &&
+                       access != rex::memory::PageAccess::kExecuteReadOnly))) {
+      return true;
+    }
+  }
+
+  static std::atomic<bool> reported{false};
+  if (!reported.exchange(true)) {
+    HeapAllocationInfo info{};
+    bool have_info = heap && heap->QueryRegionInfo(virtual_address, &info);
+    REXSYS_ERROR(
+        "FATAL guest memory fault: {} of 0x{:08X} on thread 0x{:X}; heap {} (page 0x{:X}); "
+        "guest region {}: base 0x{:08X} size 0x{:X} state 0x{:X} protect 0x{:X} "
+        "allocation_protect 0x{:X}; host mapping [{}]; MAP_FIXED_NOREPLACE honoured: {}",
+        is_write ? "write" : "read", virtual_address, rex::thread::current_thread_id(),
+        heap ? fmt::format("0x{:08X}", heap->heap_base()) : std::string("none"),
+        heap ? heap->page_size() : 0, have_info ? "found" : "not found", info.base_address,
+        info.region_size, info.state, info.protect, info.allocation_protect,
+        rex::memory::DescribeHostMapping(host_address), rex::memory::FixedNoReplaceHonored());
+    rex::FlushLogging();
+
+    static std::string message;
+    message = fmt::format(
+        "O jogo parou: falha de memoria do guest ({} em 0x{:08X}).\n"
+        "Exporte os logs no launcher e envie-os.\n\n"
+        "The game stopped: guest memory fault ({} of 0x{:08X}).\n"
+        "Export the logs from the launcher and send them.",
+        is_write ? "escrita" : "leitura", virtual_address, is_write ? "write" : "read",
+        virtual_address);
+    // Show the box from another thread: this one is inside the SIGSEGV
+    // handler (with SIGSEGV blocked), not a place to run JNI or Java.
+    try {
+      std::thread([] {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Dragon Burst", message.c_str(), nullptr);
+        rex::FlushLogging();
+        std::abort();
+      }).detach();
+    } catch (...) {
+      std::abort();
+    }
+  }
+  // Park the faulting thread (and any other thread that faults now) until the
+  // message box thread aborts the process.
+  if (global_lock.owns_lock()) {
+    global_lock.unlock();
+  }
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::seconds(1));
+  }
+}
