+  static const bool honored = [] {
+    const size_t length = page_size();
+    void* first = mmap(nullptr, length, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (first == MAP_FAILED) {
+      return true;  // Can't tell; assume a modern kernel.
+    }
+    void* second = mmap(first, length, PROT_NONE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    bool result = true;
+    if (second != MAP_FAILED) {
+      // Same address: the flag was ignored and the mapping replaced; other
+      // address: the flag was ignored and the address treated as a hint.
+      result = false;
+      if (second != first) {
+        munmap(second, length);
+      }
+    } else {
+      result = errno == EEXIST;
+    }
+    munmap(first, length);
+    return result;
+  }();
+  return honored;
+#else
+  return true;
+#endif
