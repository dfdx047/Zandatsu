 };
 
@@ -126,6 +131,24 @@ inline void WriteMem(const MemoryT& memory, uint32_t addr, uint32_t len) {
   WriteRecord(kMem, buf.data(), buf.size());
 }
 
+// Leitura de volta dos resolves: so no primeiro frame capturado (chega para ver cada
+// passe e nao estica a captura demasiado), ate 160 MB.
+inline bool WantsResolveReadback() {
+  const State& st = g_state;
+  return st.file && st.frame_index == 0 && st.resolve_bytes < 160ull * 1024 * 1024;
+}
+
+inline void WriteResolveData(const void* data, uint32_t addr, uint32_t len) {
+  State& st = g_state;
+  if (!st.file || !data || !len) return;
+  std::vector<uint8_t> buf(8 + size_t(len));
+  std::memcpy(buf.data(), &addr, 4);
+  std::memcpy(buf.data() + 4, &len, 4);
+  std::memcpy(buf.data() + 8, data, len);
+  WriteRecord(kResolveData, buf.data(), buf.size());
+  st.resolve_bytes += len;
+}
+
 template <typename ShaderT>
 inline void WriteShader(const ShaderT* shader, uint32_t type) {
   State& st = g_state;
@@ -217,12 +240,14 @@ inline void Begin(uint32_t frames, const RegisterFile& regs) {
