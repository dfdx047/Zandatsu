 //   5 SHADER  u32 tipo(0 vs 1 ps), u64 hash, u32 ndwords, dwords (big-endian do guest)
 //   6 MEM     u32 addr_fisico, u32 len, bytes
 //   7 INFO    texto (cabecalho)
+//   8 RESOLVE u32 addr_fisico, u32 len, bytes: o que o resolve anterior (COPY) escreveu,
+//             lido de volta da GPU (so no 1.o frame da captura; ver IssueCopy). Assim ve-se
+//             offline a imagem de cada passe, que no Vulkan nunca chega a memoria do guest.
 // Tudo corre na thread do command processor.
 
 #include <cstdint>
@@ -46,6 +49,7 @@ enum RecordType : uint32_t {
   kShader = 5,
   kMem = 6,
   kInfo = 7,
+  kResolveData = 8,
 };
 
 struct State {
@@ -59,6 +63,7 @@ struct State {
   std::vector<std::pair<uint32_t, uint32_t>> mem_ranges;  // (addr, len) ja escritos
   std::vector<std::pair<uint32_t, uint32_t>> pending;     // par (indice, valor)
   uint64_t bytes = 0;
+  uint64_t resolve_bytes = 0;  // dados de resolves lidos de volta nesta captura
