+++ b/include/rex/graphics/vulkan/dbz3_hitch.h
@@ -0,0 +1,77 @@
+// DBZ3-Android: diagnostico dos travoes (stutter) no backend Vulkan.
+//
+// Conta, entre dois frames, quanto tempo a thread da GPU passou em cada
+// operacao que pode bloquear: traduzir shaders, criar pipelines de forma
+// sincrona, criar pipelines de transferencia de render targets, carregar
+// texturas e esperar pela GPU. O command_processor junta isto as linhas
+// "dbz3: tiron" do logcat, para se saber a causa de cada travao.
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::graphics::vulkan::dbz3_hitch {
+
+enum Counter : uint32_t {
+  kShaderTranslate,
+  kPipelineSync,
+  kPipelinePlaceholder,
+  kRtTransferPipeline,
+  kTextureLoad,
+  kFenceWait,
+  kCounterCount,
+};
+
+struct Slot {
+  std::atomic<uint32_t> count{0};
+  std::atomic<uint64_t> us{0};
+};
+
+inline Slot g_slots[kCounterCount];
+// Frames que nao foram apresentados por usarem pipelines provisorios (async).
+inline std::atomic<uint32_t> g_skipped_presents{0};
+
+class Scope {
+ public:
+  explicit Scope(Counter counter)
+      : counter_(counter), start_(std::chrono::steady_clock::now()) {}
+  ~Scope() {
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+                        std::chrono::steady_clock::now() - start_)
+                        .count();
+    g_slots[counter_].count.fetch_add(1, std::memory_order_relaxed);
+    g_slots[counter_].us.fetch_add(uint64_t(us), std::memory_order_relaxed);
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  Counter counter_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+struct Snapshot {
+  uint32_t count[kCounterCount] = {};
+  uint64_t us[kCounterCount] = {};
+
+  void Add(const Snapshot& other) {
+    for (uint32_t i = 0; i < kCounterCount; ++i) {
+      count[i] += other.count[i];
+      us[i] += other.us[i];
+    }
+  }
+  void Clear() { *this = Snapshot(); }
+};
+
+inline Snapshot TakeAndReset() {
+  Snapshot snapshot;
+  for (uint32_t i = 0; i < kCounterCount; ++i) {
+    snapshot.count[i] = g_slots[i].count.exchange(0, std::memory_order_relaxed);
+    snapshot.us[i] = g_slots[i].us.exchange(0, std::memory_order_relaxed);
+  }
+  return snapshot;
+}
+
+}  // namespace rex::graphics::vulkan::dbz3_hitch
