   SCOPE_profile_cpu_f("gpu");
 
   // Execute commands!
   memory::RingBuffer reader(memory_->TranslatePhysical(ptr), count * sizeof(uint32_t));
   reader.set_write_offset(count * sizeof(uint32_t));
+  ++swordman_rec_ib_calls_;  // 0109: o pacote INDIRECT_BUFFER de fora nao e gravado
   do {
+    const uint32_t rec_from = reader.read_offset();
+    const uint32_t rec_ibs = swordman_rec_ib_calls_;
     if (!ExecutePacket(&reader)) {
       // Return up a level if we encounter a bad packet.
       REXGPU_ERROR("**** INDIRECT RINGBUFFER: Failed to execute packet.");
       assert_always();
       break;
     }
+    if (swordman_rec_on_ && !swordman_replaying_ && rec_ibs == swordman_rec_ib_calls_) {
+      SwordManRecordPacket(reader, rec_from);
+    }
   } while (reader.read_count());
 }
 
