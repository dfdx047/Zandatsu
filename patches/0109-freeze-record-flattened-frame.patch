+// 0109: copia o pacote acabado de executar (de from_offset ate a posicao do leitor, com a volta
+// do anel) para o frame em curso; no XE_SWAP o frame passa a ser o "ultimo completo".
+void CommandProcessor::SwordManRecordPacket(const memory::RingBuffer& reader,
+                                            uint32_t from_offset) {
+  const uint32_t cap = uint32_t(reader.capacity());
+  const uint32_t to_offset = uint32_t(reader.read_offset());
+  const uint32_t* base = reinterpret_cast<const uint32_t*>(reader.buffer());
+  if (cap) {
+    uint32_t i = from_offset % cap;
+    const uint32_t end = to_offset % cap;
+    // Um pacote nunca e maior que o anel; i == end com o leitor no fim de um buffer indireto
+    // (write_offset = 0) quer dizer "ate ao fim".
+    uint32_t guard = cap / sizeof(uint32_t) + 1;
+    do {
+      swordman_rec_.push_back(base[i / sizeof(uint32_t)]);
+      i = (i + sizeof(uint32_t)) % cap;
+    } while (i != end && --guard);
+  }
+  if (swordman_rec_.size() > (16u << 20)) {  // 64 MB: algo correu mal, recomeca
+    swordman_rec_.clear();
+    swordman_rec_synced_ = false;
+  }
+  if (swordman_rec_swap_) {
+    swordman_rec_swap_ = false;
+    if (swordman_rec_synced_) {
+      swordman_rec_last_.swap(swordman_rec_);
+      static bool logged = false;
+      if (!logged) {
+        logged = true;
+        REXGPU_INFO("swordman: frame gravado para a imagem congelada ({} palavras)",
+                    swordman_rec_last_.size());
+      }
+    }
+    swordman_rec_synced_ = true;
+    swordman_rec_.clear();
+  }
+}
+
+bool CommandProcessor::SwordManReplayRecorded() {
+  if (swordman_rec_last_.empty()) {
+    return false;
+  }
+  static bool logged = false;
+  if (!logged) {
+    logged = true;
+    REXGPU_INFO("swordman: imagem congelada (repete o frame gravado, {} palavras)",
+                swordman_rec_last_.size());
+  }
+  const memory::RingBuffer* outer_reader = swordman_primary_reader_;
+  memory::RingBuffer reader(reinterpret_cast<uint8_t*>(swordman_rec_last_.data()),
+                            swordman_rec_last_.size() * sizeof(uint32_t));
+  reader.set_write_offset(swordman_rec_last_.size() * sizeof(uint32_t));
+  swordman_replaying_ = true;
+  do {
+    if (!ExecutePacket(&reader)) {
+      REXGPU_ERROR("swordman: pacote invalido ao repetir o frame gravado");
+      break;
+    }
+  } while (reader.read_count());
+  swordman_replaying_ = false;
+  swordman_primary_reader_ = outer_reader;
+  IssueSwap(swordman_swap_ptr_, swordman_swap_width_, swordman_swap_height_);
+  return true;
+}
+
