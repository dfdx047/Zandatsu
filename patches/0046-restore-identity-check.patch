@@ -1550,7 +1553,10 @@ bool RenderTargetCache::Dbz3IsRedundantRestore(const uint32_t* sampled_bases,
                color0.pitch_tiles_at_32bpp == rec->source.pitch_tiles_at_32bpp &&
