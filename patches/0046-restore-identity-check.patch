@@ -1491,7 +1494,7 @@ bool RenderTargetCache::Dbz3ShouldElideResolve(uint32_t dest_base, RenderTargetK
 
 bool RenderTargetCache::Dbz3IsRedundantRestore(const uint32_t* sampled_bases,
                                                uint32_t sampled_count, uint32_t index_count,
-                                               uint64_t pixel_shader_hash) {
