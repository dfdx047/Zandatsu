diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index ee67764..78ebbfa 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -4425,8 +4425,42 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
         sampled_bases[sampled_count++] = uint32_t(fetch.base_address) << 12;
       }
     }
+    // Copia identidade: VS de passagem (posicao em pixeis + UV) com os 3 vertices de um
+    // retangulo de ecra inteiro (0,0)-(L,0)-(0,A) e UV (0,0)-(1,0)-(0,1), viewport desligado.
+    // Os efeitos dos especiais desenham o ecra por cima dele transformado (outros vertices ou
+    // outro VS) e nao passam neste teste.
+    bool dbz3_identity_copy = false;
+    if (prim_type == xenos::PrimitiveType::kRectangleList && index_count == 3 &&
+        vertex_shader->ucode_data_hash() == UINT64_C(0xB4ED697CB92C1759) &&
+        !vertex_shader->vertex_bindings().empty()) {
+      const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+      const auto& vb = vertex_shader->vertex_bindings()[0];
+      const xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(vb.fetch_constant);
+      const auto br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+      const uint8_t* data = vf.type == xenos::FetchConstantType::kVertex && vb.stride_words == 4
+                                ? memory_->TranslatePhysical(uint32_t(vf.address) << 2)
+                                : nullptr;
+      if (data && !vte.vport_x_scale_ena && !vte.vport_x_offset_ena && !vte.vport_y_scale_ena &&
+          !vte.vport_y_offset_ena &&
+          (vf.endian == xenos::Endian::k8in32 || vf.endian == xenos::Endian::kNone)) {
+        float f[12];
+        for (uint32_t k = 0; k < 12; ++k) {
+          uint32_t bits;
+          std::memcpy(&bits, data + k * 4, 4);
+          if (vf.endian == xenos::Endian::k8in32) bits = rex::byte_swap(bits);
+          std::memcpy(&f[k], &bits, 4);
+        }
+        const float w = float(br.br_x), h = float(br.br_y);
+        const float expect[12] = {0, 0, 0, 0, w, 0, 1, 0, 0, h, 0, 1};
+        dbz3_identity_copy = w > 0 && h > 0;
+        for (uint32_t k = 0; k < 12 && dbz3_identity_copy; ++k) {
+          dbz3_identity_copy = f[k] == expect[k];
+        }
+      }
+    }
     if (render_target_cache_->Dbz3IsRedundantRestore(sampled_bases, sampled_count, index_count,
-                                                     pixel_shader->ucode_data_hash())) {
+                                                     pixel_shader->ucode_data_hash(),
+                                                     dbz3_identity_copy)) {
       return true;
     }
   }
