 inline void CountDraw() { ++g_state.draws; }
 
+inline void CountResolve(uint32_t width, uint32_t height) {
+  State& st = g_state;
+  if (!st.enabled) return;
+  ++st.win_resolves;
+  st.win_resolve_px += uint64_t(width) * height;
+  ++st.win_resolve_sizes[(uint64_t(width) << 32) | height];
+}
+
+inline void CountLoad(const void* texture, uint32_t width, uint32_t height, uint32_t depth,
+                      uint32_t format) {
+  State& st = g_state;
+  if (!st.enabled) return;
+  ++st.win_loads;
+  st.win_load_texels += uint64_t(width) * height * depth;
+  if (std::find(st.frame_loaded.begin(), st.frame_loaded.end(), texture) !=
+      st.frame_loaded.end()) {
+    ++st.win_load_repeats;
+  } else {
+    st.frame_loaded.push_back(texture);
+  }
+  ++st.win_load_sizes[(uint64_t(format) << 48) | (uint64_t(width) << 24) | height];
+}
+
+// "resolves=N/f (X Mpx) [WxH xN ...] cargas=N/f (X Mtexels, repetidas=N) [WxH fF xN ...]"
+// por frame e com os 4 tamanhos mais frequentes. Reinicia os contadores.
+inline std::string TakeCountsSummary() {
+  State& st = g_state;
+  const double frames = st.win_cpu_frames ? double(st.win_cpu_frames) : 1.0;
+  auto top = [&](const std::unordered_map<uint64_t, uint32_t>& m, bool load) {
+    std::vector<std::pair<uint64_t, uint32_t>> v(m.begin(), m.end());
+    std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+    std::string out;
+    for (size_t i = 0; i < v.size() && i < 4; ++i) {
+      const uint64_t k = v[i].first;
+      if (load) {
+        out += fmt::format(" {}x{}f{}:{:.1f}", uint32_t((k >> 24) & 0xFFFFFF), uint32_t(k & 0xFFFFFF),
+                           uint32_t(k >> 48), double(v[i].second) / frames);
+      } else {
+        out += fmt::format(" {}x{}:{:.1f}", uint32_t(k >> 32), uint32_t(k & 0xFFFFFFFF),
+                           double(v[i].second) / frames);
+      }
+    }
+    return out;
+  };
+  std::string text = fmt::format(
+      "resolves={:.1f}/f ({:.2f} Mpx){} | cargas={:.1f}/f ({:.2f} Mtexels, repetidas={:.1f}){}",
+      double(st.win_resolves) / frames, double(st.win_resolve_px) / frames / 1.0e6,
+      top(st.win_resolve_sizes, false), double(st.win_loads) / frames,
+      double(st.win_load_texels) / frames / 1.0e6, double(st.win_load_repeats) / frames,
+      top(st.win_load_sizes, true));
+  st.win_resolves = st.win_resolve_px = st.win_loads = st.win_load_texels = st.win_load_repeats = 0;
+  st.win_resolve_sizes.clear();
+  st.win_load_sizes.clear();
+  return text;
+}
