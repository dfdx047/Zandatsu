@@ -0,0 +1,13 @@
+/**
+ * SwordMan (0176, from mgr-nx-deko's SDK fork): a function the input system calls at every controller state read
+ * (InputSystem::GetState), before the read. Renut's late input delays the frame's first read there and its latency
+ * probe notes the read (rex::latency::BeforeInputRead / NoteInputRead). None by default.
+ */
+#pragma once
+
+namespace rex::input {
+
+using ReadHook = void (*)();
+void SetReadHook(ReadHook hook);
+
+}  // namespace rex::input
