+void RequestGpuPowerControlIfDue() {
+#if REX_PLATFORM_ANDROID && defined(REX_HAS_ADRENOTOOLS)
+  // Called once per frame by the GPU thread.
+  static bool unavailable = false;
+  static bool turbo_on = false;
+  static uint64_t last_call_ms = 0;
+  static uint64_t last_request_ms = 0;
+  if (unavailable) {
+    return;
+  }
+  const uint64_t now_ms =
+      uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+                   .count());
+  const bool after_pause = last_call_ms != 0 && now_ms - last_call_ms > 1000;
+  last_call_ms = now_ms;
+  if (!REXCVAR_GET(adrenotools_turbo)) {
+    if (turbo_on) {
+      // KGSL power control is device-wide state - give it back to the governor.
+      turbo_on = false;
+      if (adrenotools_set_turbo(false)) {
+        REXLOG_INFO("GPU clocks: KGSL power control returned to the kernel governor");
+      }
+    }
+    return;
+  }
+  const int32_t period_seconds = REXCVAR_GET(adrenotools_turbo_reassert_seconds);
+  if (turbo_on && !after_pause &&
+      (period_seconds <= 0 || now_ms - last_request_ms < uint64_t(period_seconds) * 1000)) {
+    return;
+  }
+  last_request_ms = now_ms;
+  if (adrenotools_set_turbo(true)) {
+    if (!turbo_on || after_pause) {
+      REXLOG_INFO("GPU clocks: KGSL power control forced on at the maximum clock ({})",
+                  !turbo_on ? "startup" : "after a pause");
+    }
+    turbo_on = true;
+    return;
+  }
+  if (!turbo_on) {
+    // Never accepted (not a Qualcomm KGSL device, or no permission) - stop trying.
+    unavailable = true;
+    REXLOG_WARN("GPU clocks: KGSL power control request failed: {}; not requesting it again",
+                std::strerror(errno));
+  } else {
+    REXLOG_WARN("GPU clocks: KGSL power control request failed: {}", std::strerror(errno));
+  }
+#endif
+}
 
