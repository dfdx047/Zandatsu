+// DBZ3-Android: diagnostico das transicoes para leitura feitas no draw (cada uma pode
+// fechar o passe aberto). A cada 3000 transicoes escreve as mais frequentes por
+// (uso anterior, tamanho, formato, base).
+static void Dbz3NoteSampleTransition(uint32_t old_usage, uint32_t width, uint32_t height,
+                                     uint32_t format, uint32_t base) {
+  static std::map<std::tuple<uint32_t, uint32_t, uint32_t, uint32_t, uint32_t>, uint32_t> counts;
+  static uint32_t total = 0;
+  ++counts[{old_usage, width, height, format, base}];
+  if (++total < 3000) {
+    return;
+  }
+  std::vector<std::pair<uint32_t, std::tuple<uint32_t, uint32_t, uint32_t, uint32_t, uint32_t>>>
+      sorted;
+  for (const auto& [k, v] : counts) sorted.push_back({v, k});
+  std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  std::string report;
+  for (size_t i = 0; i < sorted.size() && i < 8; ++i) {
+    const auto& [u, w, h, f, b] = sorted[i].second;
+    report += fmt::format(" | uso{} {}x{} f{} {:08X}: {}", u, w, h, f, b, sorted[i].first);
+  }
+  REXGPU_INFO("dbz3: transicoes para leitura no draw ({}){}", total, report);
+  counts.clear();
+  total = 0;
+}
