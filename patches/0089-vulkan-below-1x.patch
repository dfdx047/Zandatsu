+bool VulkanTextureCache::IsDownscaledResolveSupportedForFormat(TextureKey key) const {
+  // As D3D12TextureCache: loaded from the top-left part of the guest data with the regular
+  // (unscaled) shaders - whole blocks only (resolve formats are 1x1 anyway).
+  if (!IsDrawResolutionDownscaled()) {
+    return false;
+  }
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (format_info->block_width != 1 || format_info->block_height != 1) {
+    return false;
+  }
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(key)) {
+    host_format_is_signed = bool(key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  const HostFormat& host_format =
+      host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned;
+  if (host_format.load_shader == kLoadShaderIndexUnknown ||
+      load_pipelines_[host_format.load_shader] == VK_NULL_HANDLE) {
+    return false;
+  }
+  // The float16 fallback converts in a second pass with the same shaders.
+  return true;
+}
