 #include <rex/thread.h>
 #include <rex/vec128.h>
 
+// Zandatsu (0190, 12/11): o mutex global nas zonas mfmsr/mtmsrd do codigo do jogo (resources/templates/codegen/pch_h.inja).
+REXCVAR_DEFINE_BOOL(swordman_ppc_global_lock, true, "SwordMan",
+                    "Zonas mfmsr/mtmsrd do codigo do jogo com o mutex global (como no Xenia). false: so os CAS do "
+                    "lwarx/stwcx (como o disable_global_lock do Xenia Canary), sem disputar um mutex entre todas as threads")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+extern "C" __attribute__((visibility("default"))) bool rex_ppc_global_lock_off_init() {
+  const bool off = !REXCVAR_GET(swordman_ppc_global_lock);
+  REXLOG_INFO("swordman: zonas mfmsr/mtmsrd do jogo {}", off ? "sem o mutex global (swordman_ppc_global_lock = false)"
+                                                             : "com o mutex global");
+  return off;
+}
+
 REXCVAR_DEFINE_BOOL(ignore_thread_priorities, true, "Kernel",
