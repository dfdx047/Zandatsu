+TextureCache::LoadShaderIndex VulkanTextureCache::GetLoadShaderForKey(const TextureKey& key) const {
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(key)) {
+    host_format_is_signed = bool(key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  return host_format_is_signed ? host_format_pair.format_signed.load_shader
+                               : host_format_pair.format_unsigned.load_shader;
+}
+
+bool VulkanTextureCache::IsLoadToImageCandidate(const TextureKey& key) const {
+  // 2D levels and layers (cube faces too) without a resolution scale - the image variants of the
+  // load shaders store into single-level, single-layer 2D views (a packed mip tail still goes
+  // through a buffer, loaded whole to copy regions out of it).
+  if (!load_to_image_storage_ || key.scaled_resolve ||
+      (key.dimension != xenos::DataDimension::k2DOrStacked &&
+       key.dimension != xenos::DataDimension::kCube)) {
+    return false;
+  }
+  LoadShaderIndex load_shader = GetLoadShaderForKey(key);
+  return load_shader != kLoadShaderIndexUnknown &&
+         load_pipelines_image_[load_shader] != VK_NULL_HANDLE;
+}
