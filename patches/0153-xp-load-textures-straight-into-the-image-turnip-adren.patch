+VkDescriptorSet VulkanTextureCache::AllocateLoadImageDescriptor() {
+  const uint64_t submission_completed = command_processor_.GetCompletedSubmission();
+  while (!load_image_descriptors_used_.empty() &&
+         load_image_descriptors_used_.front().first <= submission_completed) {
+    load_image_descriptors_free_.push_back(load_image_descriptors_used_.front().second);
+    load_image_descriptors_used_.pop_front();
+  }
+  if (load_image_descriptors_free_.empty()) {
+    constexpr uint32_t kSetsPerPool = 64;
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    const VkDevice device = vulkan_device->device();
+    VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, kSetsPerPool};
+    VkDescriptorPoolCreateInfo pool_create_info = {};
+    pool_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pool_create_info.maxSets = kSetsPerPool;
+    pool_create_info.poolSizeCount = 1;
+    pool_create_info.pPoolSizes = &pool_size;
+    VkDescriptorPool pool;
+    if (dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr, &pool) != VK_SUCCESS) {
+      return VK_NULL_HANDLE;
+    }
+    load_image_descriptor_pools_.push_back(pool);
+    VkDescriptorSetLayout set_layouts[kSetsPerPool];
+    std::fill(std::begin(set_layouts), std::end(set_layouts),
+              load_descriptor_set_layout_storage_image_);
+    VkDescriptorSet sets[kSetsPerPool];
+    VkDescriptorSetAllocateInfo allocate_info = {};
+    allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    allocate_info.descriptorPool = pool;
+    allocate_info.descriptorSetCount = kSetsPerPool;
+    allocate_info.pSetLayouts = set_layouts;
+    if (dfn.vkAllocateDescriptorSets(device, &allocate_info, sets) != VK_SUCCESS) {
+      return VK_NULL_HANDLE;
+    }
+    load_image_descriptors_free_.insert(load_image_descriptors_free_.end(), std::begin(sets),
+                                        std::end(sets));
+  }
+  VkDescriptorSet set = load_image_descriptors_free_.back();
+  load_image_descriptors_free_.pop_back();
+  load_image_descriptors_used_.emplace_back(command_processor_.GetCurrentSubmission(), set);
+  return set;
+}
