+                                 name_element_count)                       \
+      layout(offset=glsl_offset_bytes) type name_element_count;
+#elif SHADING_LANGUAGE_HLSL_XE
+  #if XE_SLANG_SPIRV
+    // Vulkan shares one push constant block across stages, so honor the
+    // explicit byte offset. The HLSL packoffset is for D3D per-stage constant
+    // buffers, which start each stage at register c0.
+    #define block_offset_member_xe(glsl_offset_bytes, hlsl_packoffset, type, \
+                                   name_element_count)                       \
+        [[vk::offset(glsl_offset_bytes)]] type name_element_count;
+  #else
+    #define block_offset_member_xe(glsl_offset_bytes, hlsl_packoffset, type, \
+                                   name_element_count)                       \
