@@ -0,0 +1,58 @@
+/**
+ * Project SwordMan (patch 0180): contadores do audio para o log (issues #3 e #5: o som some em lutas com varios
+ * inimigos). Uma linha a cada 5 s quando alguma coisa anormal aconteceu na janela (e a cada 60 s de qualquer forma):
+ * por cliente XAudio (o MGR usa dois), frames entregues pelo jogo, frames tocados, underruns, despachos do worker e o
+ * callback mais lento do jogo; e dos contextos XMA, os erros e quantos tinham trabalho.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::audio::stats {
+
+constexpr uint32_t kClients = 8;  // AudioSystem::kMaximumClientCount
+
+struct Client {
+  std::atomic<uint32_t> submitted{0};    // frames que o jogo entregou (XAudioSubmitRenderDriverFrame)
+  std::atomic<uint32_t> played{0};       // frames que o SDL levou
+  std::atomic<uint32_t> underruns{0};    // pedidos do SDL sem frame na fila (silencio)
+  std::atomic<uint32_t> pumped{0};       // callbacks do jogo despachados pelo worker
+  std::atomic<uint32_t> max_callback_us{0};
+  std::atomic<uint32_t> max_queued{0};
+};
+
+struct Counters {
+  Client clients[kClients];
+  std::atomic<uint32_t> xma_split_no_next{0};        // frame partido para o proximo buffer, que ainda nao e valido
+  std::atomic<uint32_t> xma_error4_split_header{0};  // cabecalho partido com tamanho invalido
+  std::atomic<uint32_t> xma_decode_errors{0};        // ffmpeg / pacote invalido / sem bits
+  std::atomic<uint32_t> xma_max_enabled{0};          // contextos XMA com trabalho numa passada do worker
+  std::atomic<uint32_t> xma_passes{0};
+  std::atomic<int32_t> xma_allocated{0};        // contextos XMA alocados agora (de 320)
+  std::atomic<uint32_t> xma_max_allocated{0};
+  std::atomic<uint32_t> xma_alloc_failures{0};  // XMACreateContext sem contexto livre: o som nao toca
+  // Leituras da imagem do disco (mmap; em /sdcard cada falta de pagina passa pelo FUSE): o streaming do Wwise
+  // (musica, vozes) vem dai.
+  std::atomic<uint32_t> disc_reads{0};
+  std::atomic<uint32_t> disc_slow_reads{0};  // > 20 ms
+  std::atomic<uint32_t> disc_max_read_us{0};
+  std::atomic<uint64_t> disc_bytes{0};
+};
+
+inline Counters& Get() {
+  static Counters c;
+  return c;
+}
+
+inline void Max(std::atomic<uint32_t>& a, uint32_t v) {
+  uint32_t cur = a.load(std::memory_order_relaxed);
+  while (v > cur && !a.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {
+  }
+}
+
+inline Client* ClientAt(int index) {
+  return index >= 0 && uint32_t(index) < kClients ? &Get().clients[index] : nullptr;
+}
+
+}  // namespace rex::audio::stats
