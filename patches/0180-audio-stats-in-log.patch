+// SwordMan (0180): uma linha a cada 5 s com algo anormal na janela (underruns, um cliente que entregou ou tocou bem
+// menos que o tempo real, erros XMA), senao a cada 60 s. Corre no callback de qualquer cliente: se um deixar de ser
+// chamado, o outro continua a contar por ele. Um frame = 256 amostras a 48 kHz: 937,5 em 5 s.
+void SDLAudioDriver::LogStats() {
+  static std::mutex mutex;
+  static auto window_start = std::chrono::steady_clock::now();
+  static uint32_t quiet_windows = 0;
+  std::unique_lock<std::mutex> lock(mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  const auto elapsed = now - window_start;
+  if (elapsed < std::chrono::seconds(5)) {
+    return;
+  }
+  window_start = now;
+  const uint32_t expected =
+      uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(elapsed).count() * 48 / 256);
+  auto& c = stats::Get();
+  bool odd = false;
+  std::string clients;
+  for (uint32_t i = 0; i < stats::kClients; ++i) {
+    auto& s = c.clients[i];
+    const uint32_t submitted = s.submitted.exchange(0), played = s.played.exchange(0),
+                   underruns = s.underruns.exchange(0), pumped = s.pumped.exchange(0),
+                   max_cb = s.max_callback_us.exchange(0), max_queued = s.max_queued.exchange(0);
+    if (!submitted && !played && !underruns && !pumped) {
+      continue;
+    }
+    odd = odd || underruns || submitted < expected * 9 / 10 || played < expected * 9 / 10;
+    clients += fmt::format(" | c{}: {} entregues, {} tocados, {} underruns, {} callbacks (max {:.1f} ms), fila {}", i,
+                           submitted, played, underruns, pumped, max_cb / 1000.0f, max_queued);
+  }
+  const uint32_t split = c.xma_split_no_next.exchange(0), header = c.xma_error4_split_header.exchange(0),
+                 errors = c.xma_decode_errors.exchange(0), enabled = c.xma_max_enabled.exchange(0),
+                 passes = c.xma_passes.exchange(0), max_allocated = c.xma_max_allocated.exchange(0),
+                 alloc_failures = c.xma_alloc_failures.exchange(0);
+  const int32_t allocated = c.xma_allocated.load(std::memory_order_relaxed);
+  const uint32_t disc_reads = c.disc_reads.exchange(0), disc_slow = c.disc_slow_reads.exchange(0),
+                 disc_max_us = c.disc_max_read_us.exchange(0);
+  const uint64_t disc_bytes = c.disc_bytes.exchange(0);
+  odd = odd || split || header || errors || alloc_failures || disc_slow;
+  if (odd || ++quiet_windows >= 12) {
+    quiet_windows = 0;
+    REXAPU_INFO("audio {:.1f}s (esperado {} frames){}{} | XMA: {} alocados (max {}, {} falhas de alocacao), {} "
+                "passadas, ate {} contextos com trabalho, {} frames partidos sem o buffer seguinte, {} cabecalhos "
+                "invalidos, {} erros | disco: {} leituras, {:.1f} MB, {} > 20 ms, max {:.1f} ms",
+                std::chrono::duration<float>(elapsed).count(), expected, clients.empty() ? " | sem clientes" : "",
+                clients, allocated, std::max<uint32_t>(max_allocated, uint32_t(std::max(allocated, 0))),
+                alloc_failures, passes, enabled, split, header, errors, disc_reads, disc_bytes / 1048576.0,
+                disc_slow, disc_max_us / 1000.0f);
+  }
 }
 
