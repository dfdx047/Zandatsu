+uint32_t VulkanTextureCache::Dbz3FindResolveTextures(uint32_t base, uint32_t width,
+                                                     uint32_t height, xenos::TextureFormat format,
+                                                     bool any_endian, xenos::Endian endian,
+                                                     void** out, uint32_t out_max) {
+  uint32_t count = 0;
+  if (!height) {
+    return 0;
+  }
+  // O resolve arredonda a altura a multiplos de 8 (720 -> 720, 180 -> 184, 45 -> 48).
+  const uint32_t min_height = height > 7 ? height - 7 : 1;
+  for (uint32_t h = height; h >= min_height && count < out_max; --h) {
+    for (uint32_t e = 0; e < 4 && count < out_max; ++e) {
+      if (!any_endian && xenos::Endian(e) != endian) {
+        continue;
+      }
+      void* texture = Dbz3FindResolveTexture(base, width, h, xenos::Endian(e), format);
+      if (texture) {
+        out[count++] = texture;
+      }
+    }
+  }
+  return count;
+}
