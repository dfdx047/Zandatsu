 }  // namespace
 
+namespace {
+// ---------------------------------------------------------------------------
+// DBZ3-Android: resolve por imageStore direto na imagem da textura (sem buffer).
+// Variantes: 0 cor unorm 1x, 1 cor uint 1x, 2 cor unorm MSAA, 3 cor uint MSAA,
+// 4 profundidade -> R32F (k_24_8), 5 profundidade -> RGBA8 ([stencil, d_lo, d_mid, d_hi]).
+// ---------------------------------------------------------------------------
+constexpr uint32_t kDbz3StoreVariants = 6;
+constexpr uint32_t kDbz3StoreRing = 256;
+
+struct Dbz3StoreState {
+  bool init_tried = false;
+  bool ok = false;
+  VkDescriptorSetLayout dest_layout = VK_NULL_HANDLE;
+  VkDescriptorPool pool = VK_NULL_HANDLE;
+  VkDescriptorSet sets[kDbz3StoreRing] = {};
+  uint32_t next_set = 0;
+  VkPipelineLayout layouts[2] = {};  // 0: cor (1 imagem), 1: profundidade (2 imagens)
+  bool tried[kDbz3StoreVariants] = {};
+  VkPipeline pipelines[kDbz3StoreVariants] = {};
+  uint32_t logged = 0;
+};
+Dbz3StoreState g_dbz3_store;
+
+std::string Dbz3StoreSource(uint32_t variant) {
+  std::string src =
+      "#version 450\n"
+      "#extension GL_EXT_samplerless_texture_functions : require\n"
+      "layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;\n"
+      "layout(push_constant) uniform Constants { uint width; uint height; uint swap_rb;"
+      " uint samples; } pc;\n";
+  if (variant <= 3) {
+    const bool integer = variant == 1 || variant == 3;
+    const bool msaa = variant >= 2;
+    src += "layout(set = 0, binding = 0, rgba8) uniform writeonly image2D dest;\n";
+    src += std::string("layout(set = 1, binding = 0) uniform ") + (integer ? "u" : "") +
+           (msaa ? "texture2DMS" : "texture2D") + " src;\n";
+    src += "void main() {\n"
+           "  ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+           "  if (uint(p.x) >= pc.width || uint(p.y) >= pc.height) return;\n";
+    if (msaa) {
+      src += "  vec4 c = vec4(0.0);\n"
+             "  for (int s = 0; s < int(pc.samples); ++s) {\n";
+      src += integer ? "    c += vec4(texelFetch(src, p, s) & 0xFFu) / 255.0;\n"
+                     : "    c += clamp(texelFetch(src, p, s), 0.0, 1.0);\n";
+      src += "  }\n  c /= float(max(pc.samples, 1u));\n";
+    } else {
+      src += integer ? "  vec4 c = vec4(texelFetch(src, p, 0) & 0xFFu) / 255.0;\n"
+                     : "  vec4 c = clamp(texelFetch(src, p, 0), 0.0, 1.0);\n";
+    }
+    src += "  if (pc.swap_rb != 0u) c.rb = c.br;\n"
+           "  imageStore(dest, p, c);\n"
+           "}\n";
+    return src;
+  }
+  const bool as_float = variant == 4;
+  src += as_float ? "layout(set = 0, binding = 0, r32f) uniform writeonly image2D dest;\n"
+                  : "layout(set = 0, binding = 0, rgba8) uniform writeonly image2D dest;\n";
+  src += "layout(set = 1, binding = 0) uniform texture2D src_depth;\n"
+         "layout(set = 1, binding = 1) uniform utexture2D src_stencil;\n"
+         "void main() {\n"
+         "  ivec2 p = ivec2(gl_GlobalInvocationID.xy);\n"
+         "  if (uint(p.x) >= pc.width || uint(p.y) >= pc.height) return;\n"
+         "  float d = clamp(texelFetch(src_depth, p, 0).r, 0.0, 1.0);\n";
+  if (as_float) {
+    src += "  imageStore(dest, p, vec4(d, 0.0, 0.0, 0.0));\n";
+  } else {
+    src += "  uint d24 = uint(d * 16777215.0 + 0.5);\n"
+           "  uint st = texelFetch(src_stencil, p, 0).r & 0xFFu;\n"
+           "  uint v = (d24 << 8u) | st;\n"
+           "  imageStore(dest, p, vec4(uvec4(v, v >> 8u, v >> 16u, v >> 24u) & 0xFFu) / 255.0);\n";
+  }
+  src += "}\n";
+  return src;
+}
+}  // namespace
+
+bool VulkanRenderTargetCache::Dbz3StoreInit() {
+  Dbz3StoreState& st = g_dbz3_store;
+  if (st.init_tried) {
+    return st.ok;
+  }
+  st.init_tried = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkDescriptorSetLayoutBinding binding = {};
+  binding.binding = 0;
+  binding.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  binding.descriptorCount = 1;
+  binding.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  VkDescriptorSetLayoutCreateInfo set_layout_info = {};
+  set_layout_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  set_layout_info.bindingCount = 1;
+  set_layout_info.pBindings = &binding;
+  if (dfn.vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr, &st.dest_layout) !=
+      VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: resolve direto: vkCreateDescriptorSetLayout falhou");
+    return false;
+  }
+  VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, kDbz3StoreRing};
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = kDbz3StoreRing;
+  pool_info.poolSizeCount = 1;
+  pool_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &st.pool) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: resolve direto: vkCreateDescriptorPool falhou");
+    return false;
+  }
+  VkDescriptorSetLayout set_layouts[kDbz3StoreRing];
+  for (uint32_t i = 0; i < kDbz3StoreRing; ++i) {
+    set_layouts[i] = st.dest_layout;
+  }
+  VkDescriptorSetAllocateInfo alloc_info = {};
+  alloc_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  alloc_info.descriptorPool = st.pool;
+  alloc_info.descriptorSetCount = kDbz3StoreRing;
+  alloc_info.pSetLayouts = set_layouts;
+  if (dfn.vkAllocateDescriptorSets(device, &alloc_info, st.sets) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: resolve direto: vkAllocateDescriptorSets falhou");
+    return false;
+  }
+  VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(uint32_t) * 4};
+  for (uint32_t l = 0; l < 2; ++l) {
+    VkDescriptorSetLayout layouts[2] = {
+        st.dest_layout,
+        l == 0 ? descriptor_set_layout_sampled_image_ : descriptor_set_layout_sampled_image_x2_};
+    VkPipelineLayoutCreateInfo layout_info = {};
+    layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_info.setLayoutCount = 2;
+    layout_info.pSetLayouts = layouts;
+    layout_info.pushConstantRangeCount = 1;
+    layout_info.pPushConstantRanges = &push_range;
+    if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &st.layouts[l]) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: resolve direto: vkCreatePipelineLayout falhou");
+      return false;
+    }
+  }
+  st.ok = true;
+  REXGPU_INFO("dbz3: resolve direto para a textura (imageStore) disponivel");
+  return true;
+}
+
+VkPipeline VulkanRenderTargetCache::Dbz3StorePipeline(uint32_t variant) {
+  Dbz3StoreState& st = g_dbz3_store;
+  if (variant >= kDbz3StoreVariants) {
+    return VK_NULL_HANDLE;
+  }
+  if (st.tried[variant]) {
+    return st.pipelines[variant];
+  }
+  st.tried[variant] = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  std::vector<uint32_t> spirv;
+  std::string error;
+  if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, Dbz3StoreSource(variant),
+                                             spirv, error)) {
+    REXGPU_ERROR("dbz3: resolve direto (variante {}): shader nao compilou: {}", variant, error);
+    return VK_NULL_HANDLE;
+  }
+  VkShaderModuleCreateInfo module_info = {};
+  module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+  module_info.codeSize = spirv.size() * sizeof(uint32_t);
+  module_info.pCode = spirv.data();
+  VkShaderModule module = VK_NULL_HANDLE;
+  if (dfn.vkCreateShaderModule(device, &module_info, nullptr, &module) != VK_SUCCESS) {
+    return VK_NULL_HANDLE;
+  }
+  VkComputePipelineCreateInfo pipeline_info = {};
+  pipeline_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+  pipeline_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+  pipeline_info.stage.module = module;
+  pipeline_info.stage.pName = "main";
+  pipeline_info.layout = st.layouts[variant >= 4 ? 1 : 0];
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  if (dfn.vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &pipeline_info, nullptr,
+                                   &pipeline) != VK_SUCCESS) {
+    pipeline = VK_NULL_HANDLE;
+    REXGPU_ERROR("dbz3: resolve direto (variante {}): vkCreateComputePipelines falhou", variant);
+  }
+  dfn.vkDestroyShaderModule(device, module, nullptr);
+  st.pipelines[variant] = pipeline;
+  return pipeline;
+}
+
+// Escreve o render target (ja em SHADER_READ_ONLY) na textura por imageStore.
+bool VulkanRenderTargetCache::Dbz3StoreToTexture(uint32_t variant, VkDescriptorSet source_set,
+                                                 VulkanTextureCache& texture_cache, void* texture,
+                                                 uint32_t width, uint32_t height, bool swap_rb,
+                                                 uint32_t samples) {
+  if (!Dbz3StoreInit()) {
+    return false;
+  }
+  VkPipeline pipeline = Dbz3StorePipeline(variant);
+  VkImageView view = texture_cache.Dbz3GetStorageView(texture);
+  if (pipeline == VK_NULL_HANDLE || view == VK_NULL_HANDLE) {
+    return false;
+  }
+  Dbz3StoreState& st = g_dbz3_store;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  // Anel de descriptor sets: com no maximo ~25 resolves por frame e 3 frames em voo, um
+  // set so volta a ser escrito ~10 frames depois de ter sido usado.
+  VkDescriptorSet dest_set = st.sets[st.next_set];
+  st.next_set = (st.next_set + 1) % kDbz3StoreRing;
+  VkDescriptorImageInfo image_info = {VK_NULL_HANDLE, view, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = dest_set;
+  write.dstBinding = 0;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &image_info;
+  dfn.vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0, nullptr);
+
+  texture_cache.Dbz3BeginStorageWrite(texture);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  VkPipelineLayout layout = st.layouts[variant >= 4 ? 1 : 0];
+  VkDescriptorSet sets[2] = {dest_set, source_set};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, layout, 0, 2, sets, 0,
+                                         nullptr);
+  const uint32_t constants[4] = {width, height, swap_rb ? 1u : 0u, samples};
+  command_buffer.CmdVkPushConstants(layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                    constants);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  texture_cache.Dbz3EndStorageWrite(texture);
+  if (st.logged < 6) {
+    ++st.logged;
+    REXGPU_INFO("dbz3: resolve direto (imageStore) variante {} {}x{} amostras {}", variant, width,
+                height, samples);
+  }
+  return true;
+}
