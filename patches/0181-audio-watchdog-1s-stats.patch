+// SwordMan (0181): watchdog do stream de saida e eventos do SDL (dispositivo de audio, segundo plano). Issues #3, #5,
+// #8, #11: o som some em lutas. Uma thread verifica a cada 100 ms se cada stream ainda recebe callbacks do SDL; com o
+// app em primeiro plano ha mais de 1 s e 500 ms sem callbacks, reabre o stream (no maximo uma vez a cada 2 s).
+namespace {
+
+int64_t NowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+std::mutex g_drivers_mutex;
+std::vector<SDLAudioDriver*> g_drivers;
+std::atomic<bool> g_foreground{true};
+std::atomic<int64_t> g_foreground_since_ms{0};
+
+bool SDLCALL AudioEventWatch(void*, SDL_Event* event) {
+  // Sem chamadas ao SDL aqui: o watch pode correr com locks do audio do SDL tomados.
+  switch (event->type) {
+    case SDL_EVENT_AUDIO_DEVICE_ADDED:
+    case SDL_EVENT_AUDIO_DEVICE_REMOVED:
+    case SDL_EVENT_AUDIO_DEVICE_FORMAT_CHANGED:
+      if (!event->adevice.recording) {
+        stats::Get().device_events.fetch_add(1, std::memory_order_relaxed);
+        REXAPU_INFO("audio: dispositivo de saida {} {}", event->adevice.which,
+                    event->type == SDL_EVENT_AUDIO_DEVICE_ADDED     ? "adicionado"
+                    : event->type == SDL_EVENT_AUDIO_DEVICE_REMOVED ? "removido"
+                                                                    : "mudou de formato");
+      }
+      break;
+    case SDL_EVENT_WILL_ENTER_BACKGROUND:
+      if (g_foreground.exchange(false)) {
+        REXAPU_INFO("audio: app em segundo plano");
+      }
+      break;
+    case SDL_EVENT_DID_ENTER_FOREGROUND:
+      g_foreground_since_ms.store(NowMs());
+      if (!g_foreground.exchange(true)) {
+        REXAPU_INFO("audio: app de volta ao primeiro plano");
+      }
+      break;
+    default:
+      break;
+  }
+  return true;
+}
+
+void WatchdogMain() {
+  std::unordered_map<SDLAudioDriver*, int64_t> last_reopen;
+  const int64_t start = NowMs();
+  bool test_stall_done = REXCVAR_GET(audio_test_stall_s) <= 0;
+  for (;;) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    const int64_t now = NowMs();
+    if (!test_stall_done && now - start >= int64_t(REXCVAR_GET(audio_test_stall_s)) * 1000) {
+      test_stall_done = true;
+      std::lock_guard<std::mutex> lock(g_drivers_mutex);
+      for (SDLAudioDriver* driver : g_drivers) {
+        if (driver->stats_index_ == 0) {
+          REXAPU_WARN("audio: teste do watchdog (audio_test_stall_s): stream do c0 pausado");
+          driver->PauseStreamForTest();
+        }
+      }
+    }
+    if (!g_foreground.load() || now - g_foreground_since_ms.load() < 1000) {
+      continue;
+    }
+    std::lock_guard<std::mutex> lock(g_drivers_mutex);
+    for (SDLAudioDriver* driver : g_drivers) {
+      const int64_t silent = now - driver->last_callback_ms_.load(std::memory_order_relaxed);
+      int64_t& last = last_reopen[driver];
+      if (silent >= 500 && now - last >= 2000) {
+        last = now;
+        driver->Reopen(silent);
+      }
+    }
+  }
+}
+
+void WatchdogAdd(SDLAudioDriver* driver) {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    g_foreground_since_ms.store(NowMs());
+    SDL_AddEventWatch(AudioEventWatch, nullptr);
+    std::thread(WatchdogMain).detach();
+  });
+  std::lock_guard<std::mutex> lock(g_drivers_mutex);
+  g_drivers.push_back(driver);
+}
+
+void WatchdogRemove(SDLAudioDriver* driver) {
+  std::lock_guard<std::mutex> lock(g_drivers_mutex);
+  g_drivers.erase(std::remove(g_drivers.begin(), g_drivers.end(), driver), g_drivers.end());
+}
