+// audio_dump_s: WAV float estereo 48 kHz com o que o cliente 0 manda ao stream; os tamanhos sao escritos no fim.
+void DumpAudio(const float* data, uint32_t floats) {
+  static std::FILE* file = nullptr;
+  static uint64_t written = 0, limit = 0;
+  static bool done = false;
+  if (done) {
+    return;
+  }
+  if (!file) {
+    limit = uint64_t(std::max(REXCVAR_GET(audio_dump_s), 0)) * 48000 * 2;
+#if REX_PLATFORM_ANDROID
+    const auto path = rex::GetAndroidAppDirectory() / "logs" / "audio_dump.wav";
+#else
+    const auto path = std::filesystem::current_path() / "logs" / "audio_dump.wav";
+#endif
+    file = std::fopen(path.string().c_str(), "wb");
+    if (!file) {
+      done = true;
+      return;
+    }
+    const uint8_t header[44] = {'R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' ', 16, 0, 0, 0,
+                                3, 0, 2, 0, 0x80, 0xBB, 0, 0, 0, 0xDC, 5, 0, 8, 0, 32, 0, 'd', 'a', 't', 'a',
+                                0, 0, 0, 0};
+    std::fwrite(header, 1, sizeof(header), file);
+    REXAPU_INFO("audio: a gravar {} s em {}", REXCVAR_GET(audio_dump_s), path.string());
+  }
+  const uint32_t n = uint32_t(std::min<uint64_t>(floats, limit - written));
+  std::fwrite(data, sizeof(float), n, file);
+  written += n;
+  if (written >= limit) {
+    const uint32_t data_bytes = uint32_t(written * sizeof(float)), riff = data_bytes + 36;
+    std::fseek(file, 4, SEEK_SET);
+    std::fwrite(&riff, 4, 1, file);
+    std::fseek(file, 40, SEEK_SET);
+    std::fwrite(&data_bytes, 4, 1, file);
+    std::fclose(file);
+    file = nullptr;
+    done = true;
+    REXAPU_INFO("audio: audio_dump.wav gravado ({} s)", REXCVAR_GET(audio_dump_s));
+  }
+}
+
+void SDLAudioDriver::PauseStreamForTest() {
+  std::lock_guard<std::mutex> lock(stream_mutex_);
+  if (sdl_stream_) {
+    SDL_PauseAudioStreamDevice(sdl_stream_);
+  }
+}
+
+void SDLAudioDriver::Reopen(int64_t silent_ms) {
+  std::lock_guard<std::mutex> lock(stream_mutex_);
+  if (sdl_stream_) {
+    SDL_DestroyAudioStream(sdl_stream_);
+    sdl_stream_ = nullptr;
+  }
+  const bool ok = OpenStream();
+  stats::Get().reopens.fetch_add(1, std::memory_order_relaxed);
+  last_callback_ms_.store(NowMs(), std::memory_order_relaxed);
+  REXAPU_WARN("audio: c{} sem callbacks do stream de saida ha {} ms: stream reaberto{}", stats_index_, silent_ms,
+              ok ? "" : fmt::format(" (falhou: {})", SDL_GetError()));
+}
