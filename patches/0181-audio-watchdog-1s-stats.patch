+// Um contexto XMA escreveu som (XmaContext::Work).
+inline void VoiceOutput(uint32_t context_id) {
+  if (context_id >= kXmaContexts) {
+    return;
+  }
+  auto& c = Get();
+  const uint32_t w = c.window.load(std::memory_order_relaxed);
+  const uint32_t last = c.voice_last_window[context_id].exchange(w, std::memory_order_relaxed);
+  if (last + 1 < w) {
+    c.voice_start_window[context_id].store(w, std::memory_order_relaxed);
+  }
+}
