+// Profundidade + stencil do render target -> buffer linear. mode 0: float (textura
+// k_24_8, R32_SFLOAT); mode 1: uint (depth24 << 8) | stencil (textura k_8_8_8_8).
+const char* Dbz3DirectResolveDepthSource() {
+  return R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Dest { uint dest[]; };
+layout(set = 1, binding = 0) uniform texture2D src_depth;
+layout(set = 1, binding = 1) uniform utexture2D src_stencil;
+layout(push_constant) uniform Constants { uint width; uint height; uint mode; } pc;
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= pc.width || p.y >= pc.height) return;
+  float d = clamp(texelFetch(src_depth, ivec2(p), 0).r, 0.0, 1.0);
+  uint v;
+  if (pc.mode == 0u) {
+    v = floatBitsToUint(d);
+  } else {
+    uint d24 = uint(d * 16777215.0 + 0.5);
+    uint st = texelFetch(src_stencil, ivec2(p), 0).r & 0xFFu;
+    v = (d24 << 8u) | st;
+  }
+  dest[p.y * pc.width + p.x] = v;
+}
+)";
+}
 
