+// ---------------------------------------------------------------------------
+// Dragon Burst: render nativo, passo 3b (0083+): a cadeia do brilho do contorno.
+// Depois da mascara do contorno (0080, -> 0F0B9000) o Burst Limit faz, em cada cadeia:
+//   reducao 640 (VS 82BB812C66526343, PS B0133EF80147AD50, alvo 640x360): le 0F0B9000
+//     (1280x720, bilinear, borda = aresta) com UV (1..1281, 1..721) / (1280, 720): cada amostra
+//     cai a meio de 2x2 texeis (media exata). oC0 = caixa(0,0) * c0 + max(caixa(0,0),
+//     caixa(1,0), caixa(0,1), caixa(1,1)) * c1, caixa(dx,dy) = media dos texeis
+//     (2x+dx..2x+dx+1, 2y+dy..2y+dy+1). Resolvido para 0FF19000.
+// Cada passe: o quad e saltado e o(s) resolve(s) que o fecham (ate ao draw seguinte) sao um
+// compute que escreve um buffer e o copia para a(s) textura(s) do destino aprendido (as 8888
+// do pos nao tem STORAGE), como no 0080. As texturas intermedias continuam a ser escritas: se
+// a cadeia parar a meio (um passe nao reconhecido ou sem destino), o passe seguinte pelo
+// caminho normal le-as atualizadas. Nas capturas nenhuma delas tem outro leitor.
+// Validado offline com as capturas (tools/ref_glow.py): ver docs/ESTADO.md.
+// ---------------------------------------------------------------------------
+namespace dbz3_native_post {
+bool g_pending = false;      // um quad foi saltado: os resolves ate ao draw seguinte sao nossos
+bool g_learn = false;        // o quad correu normal: os resolves ate ao draw seguinte ensinam
+bool g_learn_draw = false;   // o draw em curso e o que ensina (o fim dele nao acaba o ensino)
+bool g_dirty = false;        // houve um draw feito entre o quad saltado e o 1.o resolve
+uint32_t g_served = 0;       // resolves ja feitos por compute para o quad saltado
+VulkanRenderTargetCache::Dbz3PostParams g_params = {};
+uint64_t g_frames = 0;
+
+constexpr uint32_t kKinds = VulkanRenderTargetCache::kDbz3PostKindCount;
+const char* const kNames[kKinds] = {"reducao 640"};
+
+// Destinos aprendidos por instancia (um passe pode ser resolvido para mais de um destino).
+struct Slot {
+  uint64_t key = 0;
+  uint32_t count = 0;
+  uint32_t dest[4] = {};
+  uint32_t endian[4] = {};
+  bool swap[4] = {};
+};
+std::vector<Slot> g_slots;
+Slot* FindSlot(uint64_t key, bool create) {
+  for (Slot& slot : g_slots) {
+    if (slot.key == key) return &slot;
+  }
+  if (!create) return nullptr;
+  if (g_slots.size() >= 16) g_slots.erase(g_slots.begin());
+  g_slots.push_back(Slot{key});
+  return &g_slots.back();
+}
+
+struct Stats {
+  uint64_t done = 0;
+  uint64_t fail = 0;
+  uint64_t not_yet[8] = {};
+  uint64_t learn_miss = 0;
+  bool active_logged = false;
+};
+Stats g_stats[kKinds];
+
+constexpr uint32_t kSetRing = 256;
+struct State {
+  bool common_tried = false;
+  bool common_ok = false;
+  bool tried[kKinds] = {};
+  VkPipeline pipeline[kKinds] = {};
+  VkPipelineLayout layout = VK_NULL_HANDLE;
+  VkDescriptorPool pool = VK_NULL_HANDLE;
+  VkDescriptorSet sets[kSetRing] = {};
+  uint32_t next_set = 0;
+};
+State g_state;
+
+struct PushConstants {
+  float k[3][4];
+  uint32_t width;
+  uint32_t height;
+  uint32_t src_width;
+  uint32_t src_height;
+  uint32_t src1_width;
+  uint32_t src1_height;
+  uint32_t flags;  // bit 0/1: tf0/tf1 BGRA; bit 2: troca R/B no resolve (copy_dest_swap)
+  uint32_t pad;
+};
+static_assert(sizeof(PushConstants) == 80, "pos nativo: push constants");
+
+// As mesmas contas que os PS do jogo (traduzidos para SPIR-V com mul e add sem contracao:
+// aqui `precise`), na mesma ordem; a referencia em numpy (tools/ref_glow.py) faz estas contas.
+// A amostragem bilinear e feita a mao com texelFetch: os pesos dos passes sao exatos (0,5).
+// A conversao para 8 bits e a do render target: floor(clamp(v) * 255 + 0,5) em fp32.
+const char* kSource = R"(
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Dest { uint dest[]; };
+layout(set = 1, binding = 0) uniform texture2D tex0;
+layout(set = 1, binding = 1) uniform texture2D tex1;
+layout(push_constant) uniform Constants {
+  vec4 k0;
+  vec4 k1;
+  vec4 k2;
+  uint width;
+  uint height;
+  uint src_width;
+  uint src_height;
+  uint src1_width;
+  uint src1_height;
+  uint flags;
+  uint pad;
+} pc;
+vec4 T0(ivec2 p) {
+  p = clamp(p, ivec2(0), ivec2(int(pc.src_width) - 1, int(pc.src_height) - 1));
+  vec4 v = texelFetch(tex0, p, 0);
+  return (pc.flags & 1u) != 0u ? v.bgra : v;
+}
+vec4 T1(ivec2 p) {
+  p = clamp(p, ivec2(0), ivec2(int(pc.src1_width) - 1, int(pc.src1_height) - 1));
+  vec4 v = texelFetch(tex1, p, 0);
+  return (pc.flags & 2u) != 0u ? v.bgra : v;
+}
+uint Pack(vec4 v) {
+  precise vec4 s = clamp(v, 0.0, 1.0) * 255.0 + 0.5;
+  uvec4 u = uvec4(s);
+  if ((pc.flags & 4u) != 0u) u.rb = u.br;
+  return u.r | (u.g << 8u) | (u.b << 16u) | (u.a << 24u);
+}
+#if KIND == 0
+// Amostra bilinear a meio de 2x2 texeis (pesos 0,5): linha de cima, de baixo, media.
+vec4 Box(vec4 a, vec4 b, vec4 c, vec4 d) {
+  precise vec4 top = (a + b) * 0.5;
+  precise vec4 bottom = (c + d) * 0.5;
+  precise vec4 r = (top + bottom) * 0.5;
+  return r;
+}
+#endif
+void main() {
+  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+  if (uint(p.x) >= pc.width || uint(p.y) >= pc.height) return;
+#if KIND == 0
+  // Reducao 640 (B0133E...): oC0 = caixa(0,0) * c0 + max(4 caixas) * c1 (k0 = c0, k1 = c1).
+  ivec2 q = p * 2;
+  vec4 t00 = T0(q), t10 = T0(q + ivec2(1, 0)), t20 = T0(q + ivec2(2, 0));
+  vec4 t01 = T0(q + ivec2(0, 1)), t11 = T0(q + ivec2(1, 1)), t21 = T0(q + ivec2(2, 1));
+  vec4 t02 = T0(q + ivec2(0, 2)), t12 = T0(q + ivec2(1, 2)), t22 = T0(q + ivec2(2, 2));
+  vec4 b00 = Box(t00, t10, t01, t11);
+  vec4 b10 = Box(t10, t20, t11, t21);
+  vec4 b01 = Box(t01, t11, t02, t12);
+  vec4 b11 = Box(t11, t21, t12, t22);
+  vec4 m = max(max(max(b00, b10), b01), b11);
+  precise vec4 v = b00 * pc.k0 + m * pc.k1;
+#endif
+  dest[uint(p.y) * pc.width + uint(p.x)] = Pack(v);
+}
+)";
+
+bool NotYet(uint32_t why) {
+  const uint32_t kind = g_params.kind < kKinds ? g_params.kind : 0;
+  g_pending = false;
+  g_learn = true;
+  g_learn_draw = true;
+  if ((g_stats[kind].not_yet[why & 7]++ % 600) == 0) {
+    REXGPU_INFO("dbz3: render nativo: {} ainda nao ({})", kNames[kind], why);
+  }
+  return false;
+}
+
+// O resolve fecha o passe do quad: cor 0 8888 1x do render target do passe, sem limpeza, do
+// tamanho do alvo, de (0,0) a (0,0) do destino, 8888 sem expoente.
+bool Matches(const draw_util::ResolveInfo& ri, const VulkanRenderTargetCache::Dbz3PostParams& prm) {
+  const draw_util::ResolveEdramInfo& src = ri.color_edram_info;
+  return !ri.IsCopyingDepth() && !ri.IsClearingDepth() && !ri.IsClearingColor() &&
+         ri.copy_dest_extent_length && ri.rb_copy_control.copy_src_select == 0 &&
+         !src.format_is_64bpp &&
+         xenos::ColorRenderTargetFormat(src.format) == xenos::ColorRenderTargetFormat::k_8_8_8_8 &&
+         src.msaa_samples == xenos::MsaaSamples::k1X && prm.width &&
+         src.pitch_tiles == prm.width / 80 &&
+         (src.base_tiles == prm.color_base_tiles || ri.color_original_base == prm.color_base_tiles) &&
+         ri.copy_dest_info.copy_dest_format == xenos::ColorFormat::k_8_8_8_8 &&
+         ri.copy_dest_info.copy_dest_exp_bias == 0 &&
+         uint32_t(ri.copy_dest_info.copy_dest_endian) <= 3 &&
+         ri.coordinate_info.edram_offset_x_div_8 == 0 &&
+         ri.coordinate_info.edram_offset_y_div_8 == 0 &&
+         ri.copy_dest_coordinate_info.offset_x_div_8 == 0 &&
+         ri.copy_dest_coordinate_info.offset_y_div_8 == 0 &&
+         uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32 ==
+             ((prm.width + 31) & ~31u) &&
+         ri.copy_dest_base == ri.copy_dest_extent_start &&
+         uint32_t(ri.coordinate_info.width_div_8) * 8 == prm.width &&
+         ri.height_div_8 * 8 == prm.height;
+}
+
+void LogMiss(const draw_util::ResolveInfo& ri, const VulkanRenderTargetCache::Dbz3PostParams& prm) {
+  const uint32_t kind = prm.kind < kKinds ? prm.kind : 0;
+  if ((g_stats[kind].learn_miss++ % 600) != 0) return;
+  const draw_util::ResolveEdramInfo& src = ri.color_edram_info;
+  REXGPU_INFO(
+      "dbz3: render nativo: {}, resolve nao bate: depth {} clear {}/{} src_sel {} fmt {} 64bpp {} "
+      "msaa {} pitch {} (quer {}) base {}/{} (quer {}) dest_fmt {} bias {} endian {} off {},{} / "
+      "{},{} dest_pitch {} base {:08X} extent {:08X} {}x{} (quer {}x{})",
+      kNames[kind], ri.IsCopyingDepth(), ri.IsClearingDepth(), ri.IsClearingColor(),
+      uint32_t(ri.rb_copy_control.copy_src_select), uint32_t(src.format),
+      uint32_t(src.format_is_64bpp), uint32_t(src.msaa_samples), uint32_t(src.pitch_tiles),
+      prm.width / 80, uint32_t(src.base_tiles), ri.color_original_base, prm.color_base_tiles,
+      uint32_t(ri.copy_dest_info.copy_dest_format), int32_t(ri.copy_dest_info.copy_dest_exp_bias),
+      uint32_t(ri.copy_dest_info.copy_dest_endian),
+      uint32_t(ri.coordinate_info.edram_offset_x_div_8) * 8,
+      uint32_t(ri.coordinate_info.edram_offset_y_div_8) * 8,
+      uint32_t(ri.copy_dest_coordinate_info.offset_x_div_8) * 8,
+      uint32_t(ri.copy_dest_coordinate_info.offset_y_div_8) * 8,
+      uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32, ri.copy_dest_base,
+      ri.copy_dest_extent_start, uint32_t(ri.coordinate_info.width_div_8) * 8,
+      ri.height_div_8 * 8, prm.width, prm.height);
+}
+}  // namespace dbz3_native_post
+
+bool VulkanRenderTargetCache::Dbz3NativePostInit(uint32_t kind) {
+  namespace np = dbz3_native_post;
+  np::State& st = np::g_state;
+  if (kind >= np::kKinds) return false;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (!st.common_tried) {
+    st.common_tried = true;
+    VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, np::kSetRing * 2};
+    VkDescriptorPoolCreateInfo pool_info = {};
+    pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pool_info.maxSets = np::kSetRing;
+    pool_info.poolSizeCount = 1;
+    pool_info.pPoolSizes = &pool_size;
+    if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &st.pool) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: render nativo: pos: vkCreateDescriptorPool falhou");
+      return false;
+    }
+    std::vector<VkDescriptorSetLayout> set_layouts(np::kSetRing,
+                                                   descriptor_set_layout_sampled_image_x2_);
+    VkDescriptorSetAllocateInfo alloc_info = {};
+    alloc_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    alloc_info.descriptorPool = st.pool;
+    alloc_info.descriptorSetCount = np::kSetRing;
+    alloc_info.pSetLayouts = set_layouts.data();
+    if (dfn.vkAllocateDescriptorSets(device, &alloc_info, st.sets) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: render nativo: pos: vkAllocateDescriptorSets falhou");
+      return false;
+    }
+    VkDescriptorSetLayout layouts[2] = {
+        command_processor_.GetSingleTransientDescriptorLayout(
+            VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+        descriptor_set_layout_sampled_image_x2_};
+    VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                      uint32_t(sizeof(np::PushConstants))};
+    VkPipelineLayoutCreateInfo layout_info = {};
+    layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_info.setLayoutCount = 2;
+    layout_info.pSetLayouts = layouts;
+    layout_info.pushConstantRangeCount = 1;
+    layout_info.pPushConstantRanges = &push_range;
+    if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &st.layout) != VK_SUCCESS) {
+      REXGPU_ERROR("dbz3: render nativo: pos: vkCreatePipelineLayout falhou");
+      return false;
+    }
+    st.common_ok = true;
+  }
+  if (!st.common_ok) return false;
+  if (st.tried[kind]) return st.pipeline[kind] != VK_NULL_HANDLE;
+  st.tried[kind] = true;
+  const std::string source =
+      "#version 450\n#define KIND " + std::to_string(kind) + "\n" + np::kSource;
+  std::vector<uint32_t> spirv;
+  std::string error;
+  if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv, error)) {
+    REXGPU_ERROR("dbz3: render nativo: {}: shader nao compilou: {}", np::kNames[kind], error);
+    return false;
+  }
+  VkShaderModuleCreateInfo module_info = {};
+  module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+  module_info.codeSize = spirv.size() * sizeof(uint32_t);
+  module_info.pCode = spirv.data();
+  VkShaderModule module = VK_NULL_HANDLE;
+  if (dfn.vkCreateShaderModule(device, &module_info, nullptr, &module) != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: render nativo: {}: vkCreateShaderModule falhou", np::kNames[kind]);
+    return false;
+  }
+  VkComputePipelineCreateInfo pipeline_info = {};
+  pipeline_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+  pipeline_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+  pipeline_info.stage.module = module;
+  pipeline_info.stage.pName = "main";
+  pipeline_info.layout = st.layout;
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  const VkResult result = dfn.vkCreateComputePipelines(device, Dbz3GetDriverPipelineCache(), 1,
+                                                       &pipeline_info, nullptr, &pipeline);
+  dfn.vkDestroyShaderModule(device, module, nullptr);
+  if (result != VK_SUCCESS) {
+    REXGPU_ERROR("dbz3: render nativo: {}: vkCreateComputePipelines falhou", np::kNames[kind]);
+    return false;
+  }
+  Dbz3MarkDriverPipelineCacheDirty();
+  st.pipeline[kind] = pipeline;
+  return true;
+}
+
+bool VulkanRenderTargetCache::Dbz3NativePostBegin(VulkanTextureCache& texture_cache,
+                                                  const Dbz3PostParams& params) {
+  namespace np = dbz3_native_post;
+  // Como no 0082: guardados ja, para o resolve que ensina comparar com os valores reais.
+  np::g_params = params;
+  if (params.kind >= np::kKinds) {
+    np::g_params.kind = 0;
+    return np::NotYet(7);
+  }
+  if (GetPath() != Path::kHostRenderTargets || IsDrawResolutionScaled()) {
+    return np::NotYet(0);
+  }
+  const np::Slot* slot = np::FindSlot(params.key, false);
+  if (!slot || !slot->count) {
+    return np::NotYet(1);  // o primeiro frame ensina o(s) destino(s)
+  }
+  for (uint32_t i = 0; i < slot->count; ++i) {
+    void* found[4];
+    if (!texture_cache.Dbz3FindResolveTextures(slot->dest[i], params.width, params.height,
+                                               xenos::TextureFormat::k_8_8_8_8, false,
+                                               xenos::Endian(slot->endian[i]), found, 4)) {
+      return np::NotYet(2);
+    }
+  }
+  for (uint32_t i = 0; i < params.src_count && i < 2; ++i) {
+    void* texture = texture_cache.Dbz3FindResolveTexture(
+        params.src_base[i], params.src_width[i], params.src_height[i],
+        xenos::Endian(params.src_endian[i]), xenos::TextureFormat::k_8_8_8_8);
+    if (!texture || !texture_cache.Dbz3TextureUpToDate(texture)) {
+      return np::NotYet(3 + i);
+    }
+    if (texture_cache.Dbz3GetSampledView(texture) == VK_NULL_HANDLE) {
+      return np::NotYet(5);
+    }
+  }
+  if (!Dbz3NativePostInit(params.kind)) {
+    return np::NotYet(6);
+  }
+  np::g_pending = true;
+  np::g_learn = false;
+  np::g_learn_draw = false;
+  np::g_dirty = false;
+  np::g_served = 0;
+  return true;
+}
+
+void VulkanRenderTargetCache::Dbz3NativePostSeeDraw() { dbz3_native_post::g_learn_draw = false; }
+
+void VulkanRenderTargetCache::Dbz3NativePostDrawDone() {
+  namespace np = dbz3_native_post;
+  // Um draw feito acaba o ensino (salvo o proprio quad que ensina) e o passe saltado: depois
+  // dele o render target ja nao e o do passe.
+  if (!np::g_learn_draw) np::g_learn = false;
+  np::g_learn_draw = false;
+  if (np::g_pending) {
+    if (np::g_served) {
+      np::g_pending = false;
+    } else {
+      np::g_dirty = true;  // um draw entre o quad saltado e o resolve (nao devia acontecer)
+    }
+  }
+}
+
+void VulkanRenderTargetCache::Dbz3NativePostFrameEnd() {
+  namespace np = dbz3_native_post;
+  np::g_pending = false;
+  np::g_learn = false;
+  np::g_learn_draw = false;
+  if ((++np::g_frames % 3000) != 0) return;
+  for (uint32_t kind = 0; kind < np::kKinds; ++kind) {
+    const np::Stats& s = np::g_stats[kind];
+    if (!s.done && !s.fail) continue;
+    REXGPU_INFO(
+        "dbz3: render nativo: {} por compute: {} passes, {} falhas, ainda nao "
+        "{}/{}/{}/{}/{}/{}/{} (frame {})",
+        np::kNames[kind], s.done, s.fail, s.not_yet[0], s.not_yet[1], s.not_yet[2],
+        s.not_yet[3], s.not_yet[4], s.not_yet[5], s.not_yet[6], np::g_frames);
+  }
+}
+
+bool VulkanRenderTargetCache::Dbz3NativePostResolve(const draw_util::ResolveInfo& resolve_info,
+                                                    VulkanTextureCache& texture_cache) {
+  namespace np = dbz3_native_post;
+  const Dbz3PostParams& prm = np::g_params;
+  const uint32_t kind = prm.kind < np::kKinds ? prm.kind : 0;
+  const bool matches = np::Matches(resolve_info, prm);
+  const uint32_t dest = resolve_info.copy_dest_base;
+  const uint32_t endian = uint32_t(resolve_info.copy_dest_info.copy_dest_endian);
+  const bool swap = resolve_info.copy_dest_info.copy_dest_swap != 0;
+  if (np::g_learn) {
+    // A aprender: este resolve segue o caminho normal (ou o do passo 4).
+    if (!matches) {
+      np::LogMiss(resolve_info, prm);
+      np::g_learn = false;
+      return false;
+    }
+    np::Slot* slot = np::FindSlot(prm.key, true);
+    bool known = false;
+    for (uint32_t i = 0; i < slot->count; ++i) {
+      known |= slot->dest[i] == dest && slot->endian[i] == endian && slot->swap[i] == swap;
+    }
+    if (!known) {
+      if (slot->count >= 4) slot->count = 0;
+      slot->dest[slot->count] = dest;
+      slot->endian[slot->count] = endian;
+      slot->swap[slot->count] = swap;
+      ++slot->count;
+      REXGPU_INFO("dbz3: render nativo: {} -> {:08X} (endian {}, troca R/B {}, {} destino(s))",
+                  np::kNames[kind], dest, endian, swap ? 1 : 0, slot->count);
+    }
+    return false;
+  }
+  if (!np::g_pending) {
+    return false;
+  }
+  np::Stats& stats = np::g_stats[kind];
+  auto fail = [&](uint32_t why) {
+    if ((stats.fail++ % 600) == 0) {
+      REXGPU_WARN("dbz3: render nativo: {} falhou ({}), volta ao caminho normal", np::kNames[kind],
+                  why);
+    }
+    np::g_pending = false;
+    if (np::Slot* slot = np::FindSlot(prm.key, false)) slot->count = 0;  // aprende de novo
+    return false;
+  };
+  if (!matches) {
+    if (np::g_served) {
+      np::g_pending = false;  // outro resolve depois dos do passe: ja nao e connosco
+      return false;
+    }
+    return fail(1);
+  }
+  const np::Slot* slot = np::FindSlot(prm.key, false);
+  bool known = false;
+  for (uint32_t i = 0; slot && i < slot->count; ++i) {
+    known |= slot->dest[i] == dest && slot->endian[i] == endian && slot->swap[i] == swap;
+  }
+  if (!known) {
+    return fail(8);
+  }
+  if (np::g_dirty) {
+    return fail(7);
+  }
+  const uint32_t width = prm.width;
+  const uint32_t height = prm.height;
+  void* found[4];
+  const uint32_t n = texture_cache.Dbz3FindResolveTextures(
+      dest, width, height, xenos::TextureFormat::k_8_8_8_8, false, xenos::Endian(endian), found, 4);
+  if (!n) {
+    return fail(2);
+  }
+  void* sources[2] = {};
+  VkImageView views[2] = {};
+  for (uint32_t i = 0; i < prm.src_count && i < 2; ++i) {
+    sources[i] = texture_cache.Dbz3FindResolveTexture(
+        prm.src_base[i], prm.src_width[i], prm.src_height[i], xenos::Endian(prm.src_endian[i]),
+        xenos::TextureFormat::k_8_8_8_8);
+    if (!sources[i] || !texture_cache.Dbz3TextureUpToDate(sources[i])) {
+      return fail(3);
+    }
+    views[i] = texture_cache.Dbz3GetSampledView(sources[i]);
+  }
+  if (!prm.src_count || views[0] == VK_NULL_HANDLE ||
+      (prm.src_count > 1 && views[1] == VK_NULL_HANDLE) ||
+      np::g_state.pipeline[kind] == VK_NULL_HANDLE) {
+    return fail(4);
+  }
+  if (prm.src_count < 2) {
+    views[1] = views[0];
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const VkDeviceSize buffer_size = VkDeviceSize(width) * height * 4;
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch =
+      command_processor_.AcquireScratchGpuBuffer(buffer_size, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                                 VK_ACCESS_SHADER_WRITE_BIT);
+  const VkBuffer scratch_buffer = scratch.buffer();
+  if (scratch_buffer == VK_NULL_HANDLE) {
+    return fail(5);
+  }
+  const VkDescriptorSet dest_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (dest_set == VK_NULL_HANDLE) {
+    return fail(6);
+  }
+  // A partir daqui o resolve e nosso: as outras texturas deste intervalo ficam invalidas e as
+  // do destino voltam a ficar carregadas na copia.
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                    resolve_info.copy_dest_extent_length);
+  for (uint32_t i = 0; i < prm.src_count && i < 2; ++i) {
+    texture_cache.Dbz3BeginComputeRead(sources[i]);
+  }
+  // Anel de sets: ~9 passes por frame com a cadeia toda, um set so volta ~28 frames depois.
+  const VkDescriptorSet source_set = np::g_state.sets[np::g_state.next_set];
+  np::g_state.next_set = (np::g_state.next_set + 1) % np::kSetRing;
+  VkDescriptorImageInfo image_infos[2] = {
+      {VK_NULL_HANDLE, views[0], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, views[1], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL}};
+  VkDescriptorBufferInfo buffer_info = {scratch_buffer, 0, buffer_size};
+  VkWriteDescriptorSet writes[3] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = source_set;
+    writes[i].dstBinding = i;
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    writes[i].pImageInfo = &image_infos[i];
+  }
+  writes[2].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  writes[2].dstSet = dest_set;
+  writes[2].dstBinding = 0;
+  writes[2].descriptorCount = 1;
+  writes[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  writes[2].pBufferInfo = &buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+
+  np::PushConstants pc = {};
+  std::memcpy(pc.k, prm.k, sizeof(pc.k));
+  pc.width = width;
+  pc.height = height;
+  pc.src_width = prm.src_width[0];
+  pc.src_height = prm.src_height[0];
+  pc.src1_width = prm.src_count > 1 ? prm.src_width[1] : prm.src_width[0];
+  pc.src1_height = prm.src_count > 1 ? prm.src_height[1] : prm.src_height[0];
+  pc.flags = (prm.flags & ~4u) | (swap ? 4u : 0u);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(np::g_state.pipeline[kind]);
+  VkDescriptorSet sets[2] = {dest_set, source_set};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, np::g_state.layout, 0, 2,
+                                         sets, 0, nullptr);
+  command_buffer.CmdVkPushConstants(np::g_state.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc),
+                                    &pc);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  for (uint32_t i = 0; i < n; ++i) {
+    const uint32_t tex_height = std::min(height, texture_cache.Dbz3TextureHeight(found[i]));
+    texture_cache.Dbz3CopyToResolveTexture(found[i], scratch_buffer, width, tex_height,
+                                           scratch.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT),
+                                           scratch.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT));
+  }
+  dbz3_resolve_dedupe::ForgetHolder(dest);
+  ++stats.done;
+  ++np::g_served;
+  if (!stats.active_logged) {
+    stats.active_logged = true;
+    REXGPU_INFO(
+        "dbz3: render nativo: {} por compute ativo ({:08X} <- {:08X}{}{}; {}x{}, {} textura(s), "
+        "troca R/B {})",
+        np::kNames[kind], dest, prm.src_base[0], prm.src_count > 1 ? " + " : "",
+        prm.src_count > 1 ? fmt::format("{:08X}", prm.src_base[1]) : std::string(), width,
+        height, n, swap ? 1 : 0);
+  }
+  return true;
+}
+
 }  // namespace rex::graphics::vulkan
