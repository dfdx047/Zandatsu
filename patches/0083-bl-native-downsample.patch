+    // Reducao 640: 0F0B9000 (1280x720, bilinear) -> alvo 640x360, UV 1..1281 x 1..721.
+    {VulkanRenderTargetCache::kDbz3PostDownsample, UINT64_C(0xB0133EF80147AD50),
+     UINT64_C(0x82BB812C66526343), 640, 360, 1280.0f, 720.0f, 1.0f, {0x44A00000, 0x44340000}, 1,
+     {1280, 0}, {720, 0}, {true, false}},
+};
+
+bool Dbz3PostEnabled(uint32_t kind) {
+  switch (kind) {
+    case VulkanRenderTargetCache::kDbz3PostDownsample:
+      return REXCVAR_GET(dbz3_bl_native_downsample);
+    default:
+      return false;
+  }
+}
+
+// 0 = o draw e exatamente o quad do passe (params preenchidos), senao o motivo. Tudo o que
+// muda o resultado e verificado: alvo, mistura, mascara, profundidade/stencil, scissor,
+// viewport, constantes do VS, os 4 vertices, as constantes do PS e os fetch constants
+// (formato, tamanho, filtro, bordas, swizzle, sinal, expoente, mips).
+uint32_t Dbz3RecognizePost(const RegisterFile& regs, const memory::Memory& memory,
+                           const VulkanShader& vertex_shader, bool indexed,
+                           const Dbz3PostSpec& spec,
+                           VulkanRenderTargetCache::Dbz3PostParams& out) {
+  const uint32_t kW = spec.width, kH = spec.height;
+  if (indexed) return 1;
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto color = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
+  if (surface.surface_pitch != kW || surface.msaa_samples != xenos::MsaaSamples::k1X ||
+      color.color_format != xenos::ColorRenderTargetFormat::k_8_8_8_8 || color.color_exp_bias != 0) {
+    return 2;
+  }
+  const auto colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  const reg::RB_DEPTHCONTROL depth = draw_util::GetNormalizedDepthControl(regs);
+  if ((regs[XE_GPU_REG_RB_BLENDCONTROL0] & 0x1FFF1FFF) != 0x00010001 ||
+      (regs[XE_GPU_REG_RB_COLOR_MASK] & 0xF) != 0xF || colorcontrol.alpha_test_enable ||
+      colorcontrol.alpha_to_mask_enable || depth.stencil_enable ||
+      (depth.z_enable && (depth.z_write_enable || depth.zfunc != xenos::CompareFunction::kAlways))) {
+    return 3;
+  }
+  const uint32_t tl = regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL];
+  const uint32_t br = regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR];
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto rf = [&](uint32_t reg_index) {
+    float f;
+    std::memcpy(&f, &regs.values[reg_index], sizeof(f));
+    return f;
+  };
+  if ((tl & 0x7FFF7FFF) != 0 || (br & 0x7FFF) < kW || ((br >> 16) & 0x7FFF) < kH ||
+      regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET] != 0 || !vte.vport_x_scale_ena ||
+      !vte.vport_x_offset_ena || !vte.vport_y_scale_ena || !vte.vport_y_offset_ena ||
+      vte.vtx_xy_fmt || rf(XE_GPU_REG_PA_CL_VPORT_XSCALE) != float(kW) * 0.5f ||
+      rf(XE_GPU_REG_PA_CL_VPORT_XOFFSET) != float(kW) * 0.5f ||
+      rf(XE_GPU_REG_PA_CL_VPORT_YSCALE) != float(kH) * -0.5f ||
+      rf(XE_GPU_REG_PA_CL_VPORT_YOFFSET) != float(kH) * 0.5f) {
+    return 4;
+  }
+  // c0 = tamanho da textura lida (os desvios de texel), c1..c4 = a matriz de ecra inteiro
+  // (c3.z = -1.0001, c4.z = 999.0999: o z fica dentro do volume de recorte), bit a bit.
+  const uint32_t vs_consts[5][4] = {{spec.vs_c0[0], spec.vs_c0[1], 0, 0},
+                                    {0x40000000, 0, 0, 0},
+                                    {0, 0x40000000, 0, 0},
+                                    {0, 0, 0xBF800347, 0xBF800000},
+                                    {0, 0, 0x4479C665, 0x447A0000}};
+  for (uint32_t n = 0; n < 5; ++n) {
+    for (uint32_t k = 0; k < 4; ++k) {
+      if (regs.values[XE_GPU_REG_SHADER_CONSTANT_000_X + n * 4 + k] != vs_consts[n][k]) {
+        return 5;
+      }
+    }
+  }
+  // Os 4 vertices: posicao (+-0,5, +-0,5) e UV em pixeis, um por canto.
+  if (vertex_shader.vertex_bindings().empty()) return 6;
+  const auto& vb = vertex_shader.vertex_bindings()[0];
+  const xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(vb.fetch_constant);
+  if (vf.type != xenos::FetchConstantType::kVertex || vb.stride_words != 4 ||
+      (vf.endian != xenos::Endian::k8in32 && vf.endian != xenos::Endian::kNone) ||
+      uint32_t(vf.size) < 16) {
+    return 6;
+  }
+  const uint8_t* data = memory.TranslatePhysical(uint32_t(vf.address) << 2);
+  if (!data) return 6;
+  uint32_t corners = 0;
+  for (uint32_t v = 0; v < 4; ++v) {
+    float f[4];
+    for (uint32_t k = 0; k < 4; ++k) {
+      uint32_t bits;
+      std::memcpy(&bits, data + (v * 4 + k) * 4, 4);
+      if (vf.endian == xenos::Endian::k8in32) bits = rex::byte_swap(bits);
+      std::memcpy(&f[k], &bits, 4);
+    }
+    if ((f[0] != -0.5f && f[0] != 0.5f) || (f[1] != -0.5f && f[1] != 0.5f) ||
+        f[2] != (f[0] + 0.5f) * spec.uv_scale_x + spec.uv_offset ||
+        f[3] != (0.5f - f[1]) * spec.uv_scale_y + spec.uv_offset) {
+      return 6;
+    }
+    corners |= 1u << ((f[0] > 0 ? 1 : 0) | (f[1] > 0 ? 2 : 0));
+  }
+  if (corners != 0xF) return 6;
+  // Constantes do PS (por tipo, ver kSource em render_target_cache.cpp).
+  auto psc = [&](uint32_t n, uint32_t k) { return rf(XE_GPU_REG_SHADER_CONSTANT_256_X + n * 4 + k); };
+  std::memset(out.k, 0, sizeof(out.k));
+  switch (spec.kind) {
+    case VulkanRenderTargetCache::kDbz3PostDownsample:
+      for (uint32_t k = 0; k < 4; ++k) {
+        out.k[0][k] = psc(0, k);  // caixa(0,0) * c0
+        out.k[1][k] = psc(1, k);  // + max(4 caixas) * c1
+      }
+      break;
+    default:
+      return 7;
+  }
+  for (uint32_t n = 0; n < 3; ++n) {
+    for (uint32_t k = 0; k < 4; ++k) {
+      if (!std::isfinite(out.k[n][k])) return 7;
+    }
+  }
+  // As texturas: 8888 2D tiled sem mips, sem sinal, sem expoente, swizzle RGBA ou BGRA, borda =
+  // aresta, o filtro e o tamanho do passe.
+  auto edge_clamp = [](xenos::ClampMode m) {
+    return m == xenos::ClampMode::kClampToEdge || m == xenos::ClampMode::kClampToHalfway;
+  };
+  out.src_count = spec.src_count;
+  out.flags = 0;
+  for (uint32_t i = 0; i < spec.src_count; ++i) {
+    const xenos::xe_gpu_texture_fetch_t t = regs.GetTextureFetch(i);
+    const xenos::TextureFilter filter =
+        spec.src_linear[i] ? xenos::TextureFilter::kLinear : xenos::TextureFilter::kPoint;
+    const uint32_t swizzle = t.swizzle & 0xFFF;
+    if (t.type != xenos::FetchConstantType::kTexture ||
+        t.dimension != xenos::DataDimension::k2DOrStacked ||
+        t.format != xenos::TextureFormat::k_8_8_8_8 || !t.tiled ||
+        uint32_t(t.size_2d.width) + 1 != spec.src_width[i] ||
+        uint32_t(t.size_2d.height) + 1 != spec.src_height[i] ||
+        t.sign_x != xenos::TextureSign::kUnsigned || t.sign_y != xenos::TextureSign::kUnsigned ||
+        t.sign_z != xenos::TextureSign::kUnsigned || t.sign_w != xenos::TextureSign::kUnsigned ||
+        t.num_format || t.exp_adjust != 0 || t.mag_filter != filter || t.min_filter != filter ||
+        t.aniso_filter != xenos::AnisoFilter::kDisabled || !edge_clamp(t.clamp_x) ||
+        !edge_clamp(t.clamp_y) || t.mip_max_level != 0 ||
+        (swizzle != 0x688 && swizzle != 0x60A)) {  // RGBA (0o3210) ou BGRA (0o3012)
+      return 8 + i;
+    }
+    out.src_base[i] = (uint32_t(t.base_address) << 12) & 0x1FFFFFFF;
+    out.src_endian[i] = uint32_t(t.endianness);
+    out.src_width[i] = spec.src_width[i];
+    out.src_height[i] = spec.src_height[i];
+    if (swizzle == 0x60A) out.flags |= 1u << i;
+  }
+  out.kind = spec.kind;
+  out.width = kW;
+  out.height = kH;
+  out.color_base_tiles = color.color_base;
+  out.key = spec.vs ^ (uint64_t(spec.kind) << 56) ^ (uint64_t(out.src_base[0]) << 3) ^
+            (spec.src_count > 1 ? uint64_t(out.src_base[1]) << 31 : 0);
+  return 0;
+}
+uint64_t g_dbz3_post_unrecognized[VulkanRenderTargetCache::kDbz3PostKindCount][10] = {};
+const char* const kDbz3PostNames[VulkanRenderTargetCache::kDbz3PostKindCount] = {"reducao 640"};
+}  // namespace
