+  uint64_t ps;
+  uint64_t vs;
+  uint32_t width;        // alvo do passe
+  uint32_t height;
+  float uv_scale_x;      // UV dos vertices: (x + 0,5) * escala + desvio, (0,5 - y) * escala + desvio
+  float uv_scale_y;
+  float uv_offset;
