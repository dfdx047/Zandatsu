+// DBZ3 (v1.4.1): la misma telemetria que en D3D12 para Vulkan (y por tanto Linux): fps
+// del guest cada 5 s con `dbz3_perf_logging`, y lineas `tiron` (frames de mas de 50 ms,
+// siempre, maximo 30 por sesion) con la espera del command processor al guest.
+static void Dbz3LogGuestPerformanceVulkan() {
+  static std::chrono::steady_clock::time_point window_start;
+  static std::chrono::steady_clock::time_point last_frame;
+  static uint32_t frames_in_window = 0;
+  static double max_frame_ms = 0.0;
+  static uint64_t cp_last_window = 0, cp_last_frame = 0;
+  static uint32_t hitches_logged = 0;
+  const auto now = std::chrono::steady_clock::now();
+  const uint64_t cp_now = rex::graphics::g_dbz3_regmem_wait_us.load(std::memory_order_relaxed);
+  if (last_frame.time_since_epoch().count() != 0) {
+    const double frame_ms = std::chrono::duration<double, std::milli>(now - last_frame).count();
+    max_frame_ms = std::max(max_frame_ms, frame_ms);
+    if (frame_ms > 50.0 && hitches_logged < 30) {
+      ++hitches_logged;
+      REXGPU_INFO("dbz3: tiron {:.0f} ms (vulkan cp_wait {:.1f} ms)", frame_ms,
+                  double(cp_now - cp_last_frame) / 1000.0);
+    }
+  }
+  cp_last_frame = cp_now;
+  last_frame = now;
+  if (window_start.time_since_epoch().count() == 0) {
+    window_start = now;
+    cp_last_window = cp_now;
+    return;
+  }
+  ++frames_in_window;
+  const double elapsed_s = std::chrono::duration<double>(now - window_start).count();
+  if (elapsed_s < 5.0) return;
+  if (rex::cvar::GetFlagByName("dbz3_perf_logging") == "true") {
+    REXGPU_INFO(
+        "dbz3: perf fps={:.1f} frames={} window={:.2f}s max_frame_ms={:.1f} backend=vulkan "
+        "cfg=scale:{}x{} msaa:{} cp_wait={:.1f}ms/f",
+        double(frames_in_window) / elapsed_s, frames_in_window, elapsed_s, max_frame_ms,
+        rex::cvar::GetFlagByName("draw_resolution_scale_x"),
+        rex::cvar::GetFlagByName("draw_resolution_scale_y"),
+        rex::cvar::GetFlagByName("native_2x_msaa"),
+        double(cp_now - cp_last_window) / 1000.0 / double(frames_in_window ? frames_in_window : 1));
+  }
+  cp_last_window = cp_now;
+  window_start = now;
+  frames_in_window = 0;
+  max_frame_ms = 0.0;
+}
