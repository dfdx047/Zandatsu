+                                            xenos::TextureFormat::k_8_8_8_8, false,
+                                            xenos::Endian(g_stale_endian), source, 4) != 1 ||
+      !texture_cache.Dbz3TextureUpToDate(source[0])) {
+    return fail(3);
+  }
