 namespace {
 
+// DBZ3-Android: cache de pipelines do proprio driver (VkPipelineCache) guardada
+// em disco. Sem ela, cada pipeline era compilado do zero pelo driver em cada
+// arranque (10-30 ms no Adreno), o que dava os travoes nas transformacoes e nos
+// poderes. O driver valida o cabecalho dos dados (fabricante, GPU, versao do
+// driver), por isso um ficheiro de outro aparelho ou driver e simplesmente
+// ignorado. E guardado periodicamente numa thread a parte, porque no Android a
+// app pode ser terminada sem passar pelo Shutdown.
+struct Dbz3DriverPipelineCache {
+  VkPipelineCache cache = VK_NULL_HANDLE;
+  std::filesystem::path path;
+  std::atomic<uint32_t> dirty{0};
+  std::atomic<bool> saving{false};
+  std::chrono::steady_clock::time_point last_save{};
+};
+Dbz3DriverPipelineCache g_dbz3_driver_cache;
+
+void Dbz3SaveDriverPipelineCache(const ui::vulkan::VulkanDevice::Functions& dfn,
+                                 VkDevice device) {
+  VkPipelineCache cache = g_dbz3_driver_cache.cache;
+  if (cache == VK_NULL_HANDLE || g_dbz3_driver_cache.path.empty()) {
+    return;
+  }
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(device, cache, &size, nullptr) != VK_SUCCESS || !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  VkResult result = dfn.vkGetPipelineCacheData(device, cache, &size, data.data());
+  if (result != VK_SUCCESS && result != VK_INCOMPLETE) {
+    return;
+  }
+  data.resize(size);
+  std::filesystem::path temp_path = g_dbz3_driver_cache.path;
+  temp_path += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temp_path, "wb");
+  if (!file) {
+    return;
+  }
+  const bool written = fwrite(data.data(), 1, data.size(), file) == data.size();
+  fclose(file);
+  std::error_code ec;
+  if (written) {
+    std::filesystem::rename(temp_path, g_dbz3_driver_cache.path, ec);
+  }
+  if (!written || ec) {
+    std::filesystem::remove(temp_path, ec);
+    return;
+  }
+  REXGPU_INFO("dbz3: cache de pipelines do driver guardada ({} KB)", data.size() >> 10);
+}
+
+void Dbz3InitDriverPipelineCache(const ui::vulkan::VulkanDevice::Functions& dfn,
+                                 VkDevice device, const std::filesystem::path& path) {
+  if (g_dbz3_driver_cache.cache != VK_NULL_HANDLE) {
+    return;
+  }
+  g_dbz3_driver_cache.path = path;
+  std::vector<uint8_t> data;
+  if (FILE* file = rex::filesystem::OpenFile(path, "rb")) {
+    fseek(file, 0, SEEK_END);
+    const long length = ftell(file);
+    fseek(file, 0, SEEK_SET);
+    if (length > 0) {
+      data.resize(size_t(length));
+      if (fread(data.data(), 1, data.size(), file) != data.size()) {
+        data.clear();
+      }
+    }
+    fclose(file);
+  }
+  VkPipelineCacheCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  if (dfn.vkCreatePipelineCache(device, &create_info, nullptr, &g_dbz3_driver_cache.cache) !=
+      VK_SUCCESS) {
+    // Dados invalidos ou de outro driver: comeca vazia.
+    create_info.initialDataSize = 0;
+    create_info.pInitialData = nullptr;
+    data.clear();
+    if (dfn.vkCreatePipelineCache(device, &create_info, nullptr, &g_dbz3_driver_cache.cache) !=
+        VK_SUCCESS) {
+      g_dbz3_driver_cache.cache = VK_NULL_HANDLE;
+      REXGPU_WARN("dbz3: nao foi possivel criar a cache de pipelines do driver");
+      return;
+    }
+  }
+  g_dbz3_driver_cache.last_save = std::chrono::steady_clock::now();
+  REXGPU_INFO("dbz3: cache de pipelines do driver carregada ({} KB de {})", data.size() >> 10,
+              rex::path_to_utf8(path));
+}
+
+}  // namespace
+
+// DBZ3-Android: tambem usada pelos pipelines de transferencia de render targets
+// (render_target_cache.cpp), criados a meio do jogo nos efeitos.
+VkPipelineCache Dbz3GetDriverPipelineCache() { return g_dbz3_driver_cache.cache; }
+void Dbz3MarkDriverPipelineCacheDirty() {
+  g_dbz3_driver_cache.dirty.fetch_add(1, std::memory_order_relaxed);
+}
