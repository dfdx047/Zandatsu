+#elif KIND == 2
+  // Composicao do brilho (F59256...): oC0 = tf1 * c0.x + tf0 * c0.w (k0 = (c0.x, c0.w)). tf0 no
+  // texel do pixel; tf1 (metade do tamanho) bilinear em ((p + 0,5) / 2 - 0,5): o texel q =
+  // (p - 1) >> 1 e o seguinte, pesos 0,75 (p par) ou 0,25 (p impar) para o seguinte.
+  vec4 t0 = T0(p);
+  ivec2 q = (p - 1) >> 1;
+  vec2 f = vec2((p.x & 1) != 0 ? 0.25 : 0.75, (p.y & 1) != 0 ? 0.25 : 0.75);
+  vec4 a = T1(q), b = T1(q + ivec2(1, 0)), c = T1(q + ivec2(0, 1)), e = T1(q + ivec2(1, 1));
+  precise vec4 t1 = a * ((1.0 - f.x) * (1.0 - f.y)) + b * (f.x * (1.0 - f.y)) +
+                    c * ((1.0 - f.x) * f.y) + e * (f.x * f.y);
+  precise vec4 v = t1 * pc.k0.x + t0 * pc.k0.y;
 #endif
   dest[uint(p.y) * pc.width + uint(p.x)] = Pack(v);
