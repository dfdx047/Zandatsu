+// ---------------------------------------------------------------- Dragon Burst
+// (0056) Registo das esperas em curso, so para diagnostico.
+namespace {
+struct Dbz3Wait {
+  std::string thread;
+  uint32_t thread_id = 0;
+  const char* kind = "";
+  std::vector<XObject*> objects;
+  std::chrono::steady_clock::time_point start;
+};
+std::mutex& Dbz3WaitsMutex() {
+  static std::mutex m;
+  return m;
+}
+std::map<const void*, Dbz3Wait>& Dbz3Waits() {
+  static std::map<const void*, Dbz3Wait> w;
+  return w;
+}
+const char* Dbz3TypeName(XObject::Type t) {
+  switch (t) {
+    case XObject::Type::Event: return "evento";
+    case XObject::Type::Mutant: return "mutex";
+    case XObject::Type::Semaphore: return "semaforo";
+    case XObject::Type::Timer: return "timer";
+    case XObject::Type::Thread: return "thread";
+    case XObject::Type::File: return "ficheiro";
+    case XObject::Type::IOCompletion: return "iocompletion";
+    case XObject::Type::NotifyListener: return "notify";
+    default: return "outro";
+  }
+}
+struct Dbz3WaitScope {
+  const void* key;
+  Dbz3WaitScope(const char* kind, std::initializer_list<XObject*> objects) {
+    XThread* thread = XThread::GetCurrentThread();
+    key = thread ? static_cast<const void*>(thread) : nullptr;
+    if (!key) return;
+    Dbz3Wait w;
+    w.thread = thread->name();
+    w.thread_id = thread->thread_id();
+    w.kind = kind;
+    w.objects.assign(objects.begin(), objects.end());
+    w.start = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(Dbz3WaitsMutex());
+    Dbz3Waits()[key] = std::move(w);
+  }
+  Dbz3WaitScope(const char* kind, XObject** objects, uint32_t count) : Dbz3WaitScope(kind, {}) {
+    if (!key) return;
+    std::lock_guard<std::mutex> lock(Dbz3WaitsMutex());
+    auto it = Dbz3Waits().find(key);
+    if (it != Dbz3Waits().end()) it->second.objects.assign(objects, objects + count);
+  }
+  ~Dbz3WaitScope() {
+    if (!key) return;
+    std::lock_guard<std::mutex> lock(Dbz3WaitsMutex());
+    Dbz3Waits().erase(key);
+  }
+};
+}  // namespace
+
+void Dbz3LogKernelWaits(double min_seconds) {
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(Dbz3WaitsMutex());
+  size_t shown = 0;
+  for (const auto& [key, w] : Dbz3Waits()) {
+    const double secs = std::chrono::duration<double>(now - w.start).count();
+    if (secs < min_seconds) continue;
+    std::string objs;
+    for (XObject* o : w.objects) {
+      if (!o) continue;
+      objs += fmt::format(" [{} {:08X} guest={:08X} handle={:08X} sinais={}]", Dbz3TypeName(o->type()),
+                          uint32_t(reinterpret_cast<uintptr_t>(o)), o->guest_object(),
+                          o->handles().empty() ? 0u : uint32_t(o->handles()[0]), o->dbz3_signals());
+    }
+    REXSYS_INFO("dbz3: espera {:.1f}s {} \"{}\" (id {:X}) em{}", secs, w.kind, w.thread, w.thread_id,
+                objs);
+    ++shown;
+  }
+  REXSYS_INFO("dbz3: esperas longas (>= {:.0f}s): {} de {} threads em espera", min_seconds, shown,
+              Dbz3Waits().size());
+}
