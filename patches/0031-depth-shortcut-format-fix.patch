+// Diagnostico: porque e que o atalho de profundidade nao se aplicou (uma vez por motivo).
+bool Dbz3DepthFail(int reason) {
+  static uint32_t logged_mask = 0;
+  if (!(logged_mask & (1u << reason))) {
+    logged_mask |= 1u << reason;
+    REXGPU_INFO("dbz3: atalho profundidade->textura nao aplicado (motivo {})", reason);
+  }
+  return false;
+}
