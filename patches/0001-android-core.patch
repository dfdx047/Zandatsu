+    stp x27, x28, [x0, #64]
+    stp x29, x30, [x0, #80]
+    mov x9, sp
+    str x9, [x0, #96]
+    stp d8, d9, [x0, #104]
+    stp d10, d11, [x0, #120]
+    stp d12, d13, [x0, #136]
+    stp d14, d15, [x0, #152]
+
+    ldp x19, x20, [x1, #0]
+    ldp x21, x22, [x1, #16]
+    ldp x23, x24, [x1, #32]
+    ldp x25, x26, [x1, #48]
+    ldp x27, x28, [x1, #64]
+    ldp x29, x30, [x1, #80]
+    ldr x9, [x1, #96]
+    mov sp, x9
+    ldp d8, d9, [x1, #104]
+    ldp d10, d11, [x1, #120]
+    ldp d12, d13, [x1, #136]
+    ldp d14, d15, [x1, #152]
+    ret
+    .size rex_android_fiber_switch, .-rex_android_fiber_switch
+)");
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  // O contexto desta thread e gravado no primeiro SwitchTo que sair dela.
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  static_assert(offsetof(Context, fp) == 80, "layout usado pelo assembly");
+  static_assert(offsetof(Context, sp) == 96, "layout usado pelo assembly");
+  static_assert(offsetof(Context, d8_d15) == 104, "layout usado pelo assembly");
+
+  // Primeiro codigo executado num fiber novo: o primeiro SwitchTo para ele faz
+  // "ret" para aqui, ja com o sp no topo da pilha propria do fiber. Um fiber
+  // nunca deve voltar da funcao de entrada (como no Windows).
+  void (*entry_thunk)() = []() {
+    Fiber::Trampoline();
+    std::abort();
+  };
+
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size());
+  top &= ~uintptr_t(15);  // A ABI AArch64 exige sp alinhado a 16 bytes.
+  f->context_.sp = top;
+  f->context_.fp = 0;
+  f->context_.lr = reinterpret_cast<uint64_t>(entry_thunk);
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ foi atualizado pelo SwitchTo antes de chegarmos aqui.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_android_fiber_switch(&from->context_, &target->context_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
