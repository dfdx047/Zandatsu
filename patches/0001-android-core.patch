+#pragma once
+/**
+ * DBZ3-Android: utilitarios de arranque do runtime no Android.
+ *
+ * O codigo herdado do Xenia (threading_posix, memory_posix) chama
+ * rex::GetAndroidApiLevel() e os AndroidInitialize() de cada subsistema.
+ * InitializeAndroidRuntime() faz essas chamadas pela ordem certa e e chamado
+ * pelo SDL_main (windowed_app_main_sdl.cpp) antes de tudo o resto.
+ */
+
+#include <cstdint>
+#include <filesystem>
+
+namespace rex {
+
+// Nivel de API do Android em que o processo esta a correr (ex.: 34).
+int32_t GetAndroidApiLevel();
+
+// Pasta de dados da app (definida pelo lado Java na variavel REX_APP_DIR).
+// E aqui que ficam o jogo (DBZ3/), as configuracoes, os logs e a cache.
+std::filesystem::path GetAndroidAppDirectory();
+
+// Pasta das bibliotecas nativas extraidas (variavel REX_NATIVE_LIB_DIR).
+std::filesystem::path GetAndroidNativeLibraryDirectory();
+
+// Inicializa os subsistemas Android do runtime (memoria, threads).
+void InitializeAndroidRuntime();
+void ShutdownAndroidRuntime();
+
+}  // namespace rex
