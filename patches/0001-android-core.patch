+// DBZ3-Android: o SDLActivity (Java) carrega libmain.so e chama SDL_main numa
+// thread propria, depois de inicializar o JNI do SDL. Antes de arrancar a app
+// inicializam-se os subsistemas Android do runtime (memoria partilhada,
+// threads) e muda-se a pasta atual para a pasta de dados da app.
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char* argv[]) {
+  SDL_SetMainReady();
+  rex::InitializeAndroidRuntime();
+  const auto app_dir = rex::GetAndroidAppDirectory();
+  if (!app_dir.empty()) {
+    std::error_code ec;
+    std::filesystem::create_directories(app_dir, ec);
+    std::filesystem::current_path(app_dir, ec);
+  }
+  const int result = RunWindowedApp(argc, argv);
+  rex::ShutdownAndroidRuntime();
+  return result;
+}
