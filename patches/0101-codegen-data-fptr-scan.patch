 #include <unordered_set>
 
@@ -402,6 +404,63 @@ void functionPointerScan(CodegenContext& ctx) {
   REXCODEGEN_TRACE("functionPointerScan: found {} new function pointer targets", foundCount);
 }
 
+//=============================================================================
+// Project SwordMan: data pointer scan. Words in non-executable sections that point
+// into code and look like a function start (the word before is blr/bctr/b or zero
+// padding, and the address is not inside a .pdata function). These are the
+// targets of indirect calls (bctrl) that the call graph never reaches.
+//=============================================================================
+size_t dataPointerScan(CodegenContext& ctx) {
+  auto& graph = ctx.graph;
+  auto& binary = ctx.binary();
+  std::vector<uint32_t> found;
+  std::unordered_set<uint32_t> seen;
+
+  auto word_at = [&](uint32_t addr, uint32_t& out) -> bool {
+    const uint8_t* p = binary.translate(addr);
+    if (!p)
+      return false;
+    out = load_and_swap<uint32_t>(p);
+    return true;
+  };
+
+  for (const auto& sec : binary.sections()) {
+    if (sec.executable || !sec.data)
+      continue;
+    for (uint32_t off = 0; off + 4 <= sec.size; off += 4) {
+      uint32_t t = load_and_swap<uint32_t>(sec.data + off);
+      if ((t & 3) != 0 || !binary.isExecutable(t))
+        continue;
+      if (binary.isInImportExportRange(t) || graph.isEntryPoint(t) || !seen.insert(t).second)
+        continue;
+      if (const auto* owner = graph.getFunctionContaining(t)) {
+        if (owner->authority() == FunctionAuthority::PDATA && t > owner->base() && t < owner->end())
+          continue;
+      }
+      uint32_t first = 0, prev = 0;
+      if (!word_at(t, first) || first == 0 || !word_at(t - 4, prev))
+        continue;
+      const bool prev_blr = prev == 0x4E800020u || prev == 0x4E800420u;  // blr, bctr
+      const bool prev_b = (prev >> 26) == 18 && (prev & 1) == 0;         // b (sem link)
+      const bool prev_pad = prev == 0;
+      if (!prev_blr && !prev_b && !prev_pad)
+        continue;
+      graph.addFunction(t, 4, FunctionAuthority::DISCOVERED, true);
+      found.push_back(t);
+    }
+  }
+
+  std::sort(found.begin(), found.end());
+  if (FILE* out = std::fopen("fptr_scan.txt", "w")) {
+    for (uint32_t a : found)
+      std::fprintf(out, "0x%08X\n", a);
+    std::fclose(out);
+  }
+  REXCODEGEN_INFO("dataPointerScan: {} new functions from data pointers (fptr_scan.txt)",
+                  found.size());
+  return found.size();
+}
+
 }  // anonymous namespace
 
