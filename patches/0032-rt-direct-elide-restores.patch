+bool RenderTargetCache::Dbz3ShouldElideResolve(uint32_t dest_base, RenderTargetKey source) {
+  if (!REXCVAR_GET(dbz3_rt_direct) || !REXCVAR_GET(dbz3_rt_elide_restores)) {
+    return false;
+  }
+  const uint32_t ordinal = dbz3_frame_resolve_counts_[dest_base]++;
+  for (Dbz3ResolveRecord& r : dbz3_frame_resolves_) {
+    if (r.dest == dest_base) r.overwritten = true;
+  }
+  Dbz3ResolveRecord rec;
+  rec.dest = dest_base;
+  rec.ordinal = ordinal;
+  rec.source = source;
+  rec.source_gen = dbz3_write_gen_[source];
+  rec.real_use = false;
+  rec.overwritten = false;
+  const uint64_t id = (uint64_t(dest_base) << 8) | (ordinal & 0xFF);
+  rec.skipped = dbz3_elidable_.count(id) && !dbz3_forbidden_.count(id);
+  dbz3_frame_resolves_.push_back(rec);
+  if (rec.skipped) ++dbz3_elided_;
+  return rec.skipped;
+}
+
+bool RenderTargetCache::Dbz3IsRedundantRestore(const uint32_t* sampled_bases,
+                                               uint32_t sampled_count, uint32_t index_count) {
+  if (!REXCVAR_GET(dbz3_rt_direct) || !REXCVAR_GET(dbz3_rt_elide_restores) ||
+      dbz3_frame_resolves_.empty() || !sampled_count) {
+    return false;
+  }
+  const RegisterFile& regs = register_file();
+  // Render target 0 de cor do draw (como em Update).
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  const uint32_t msaa_samples_x_log2 = uint32_t(rb_surface_info.msaa_samples >= xenos::MsaaSamples::k4X);
+  RenderTargetKey color0;
+  color0.base_tiles = regs.Get<reg::RB_COLOR_INFO>().color_base;
+  color0.pitch_tiles_at_32bpp =
+      ((uint32_t(rb_surface_info.surface_pitch) << msaa_samples_x_log2) +
+       (xenos::kEdramTileWidthSamples - 1)) /
+      xenos::kEdramTileWidthSamples;
+  color0.msaa_samples = rb_surface_info.msaa_samples;
+  color0.is_depth = 0;
+  color0.resource_format = uint32_t(GetColorResourceFormat(
+      xenos::GetStorageColorFormat(regs.Get<reg::RB_COLOR_INFO>().color_format)));
+  // Opaco (1*src + 0*dst) e poucos vertices (triangulo/retangulo de ecra inteiro).
+  const bool opaque = (regs[XE_GPU_REG_RB_BLENDCONTROL0] & 0x1FFF1FFF) == 0x00010001;
+  bool restore_found = false;
+  bool other_resolved = false;
+  for (uint32_t i = 0; i < sampled_count; ++i) {
+    Dbz3ResolveRecord* rec = nullptr;
+    for (auto it = dbz3_frame_resolves_.rbegin(); it != dbz3_frame_resolves_.rend(); ++it) {
+      if (it->dest == sampled_bases[i] && !it->overwritten) {
+        rec = &*it;
+        break;
+      }
+    }
+    if (!rec) continue;
+    const bool same_target =
+        rec->source.is_depth
+            ? (color0.base_tiles == rec->source.base_tiles &&
+               color0.pitch_tiles_at_32bpp == rec->source.pitch_tiles_at_32bpp &&
+               color0.msaa_samples == rec->source.msaa_samples)
+            : color0 == rec->source;
+    if (opaque && index_count <= 6 && same_target &&
+        dbz3_write_gen_[rec->source] == rec->source_gen) {
+      restore_found = true;
+    } else {
+      other_resolved = true;
+      if (!rec->real_use) {
+        rec->real_use = true;
+        if (rec->skipped) {
+          const uint64_t id = (uint64_t(rec->dest) << 8) | (rec->ordinal & 0xFF);
+          dbz3_forbidden_.insert(id);
+          REXGPU_WARN("dbz3: resolve {:08X} #{} eliminado mas lido a serio; volta a ser feito",
+                      rec->dest, rec->ordinal);
+        }
+      }
+    }
+  }
+  if (restore_found && !other_resolved) {
+    ++dbz3_restores_skipped_;
+    return true;
+  }
+  return false;
+}
+
+void RenderTargetCache::Dbz3ElisionFrameEnd() {
+  dbz3_elidable_.clear();
+  for (const Dbz3ResolveRecord& r : dbz3_frame_resolves_) {
+    if (r.overwritten && !r.real_use) {
+      dbz3_elidable_.insert((uint64_t(r.dest) << 8) | (r.ordinal & 0xFF));
+    }
+  }
+  static uint32_t frames = 0;
+  if (++frames % 600 == 0 && (dbz3_elided_ || dbz3_restores_skipped_)) {
+    REXGPU_INFO("dbz3: rt_direct: {} resolves eliminados, {} restauros ignorados (600 frames)",
+                dbz3_elided_, dbz3_restores_skipped_);
+    dbz3_elided_ = 0;
+    dbz3_restores_skipped_ = 0;
+  }
+  dbz3_frame_resolves_.clear();
+  dbz3_frame_resolve_counts_.clear();
+}
+
 }  // namespace rex::graphics
