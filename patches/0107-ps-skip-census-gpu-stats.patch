+// Project SwordMan (0107): saltar draws por pixel shader, censo de pixel shaders e o tempo de
+// GPU acumulado (o autoteste mede quanto custa cada passe com a imagem congelada).
+namespace swordman_ps {
+struct Skip {
+  uint64_t hash;
+  uint32_t pitch;  // 0 = qualquer
+};
+std::string g_skip_text;
+std::vector<Skip> g_skip;
+struct CensusEntry {
+  uint64_t draws = 0;
+  uint32_t max_pitch = 0;
+  uint32_t prim = 0;
+};
+std::mutex g_census_mutex;
+std::unordered_map<uint64_t, CensusEntry> g_census;
+std::atomic<uint64_t> g_gpu_frames{0};
+std::atomic<uint64_t> g_gpu_us{0};
+
+const std::vector<Skip>& SkipList() {
+  const std::string& text = REXCVAR_GET(swordman_skip_ps);
+  if (text != g_skip_text) {
+    g_skip_text = text;
+    g_skip.clear();
+    size_t pos = 0;
+    while (pos < text.size()) {
+      size_t end = text.find(',', pos);
+      if (end == std::string::npos) end = text.size();
+      std::string item = text.substr(pos, end - pos);
+      pos = end + 1;
+      Skip sk{0, 0};
+      const size_t at = item.find('@');
+      if (at != std::string::npos) {
+        sk.pitch = uint32_t(std::strtoul(item.c_str() + at + 1, nullptr, 10));
+        item.resize(at);
+      }
+      while (!item.empty() && item.front() == ' ') item.erase(item.begin());
+      if (item.empty()) continue;
+      sk.hash = std::strtoull(item.c_str(), nullptr, 16);
+      if (sk.hash) g_skip.push_back(sk);
+    }
+    REXGPU_INFO("swordman: {} pixel shaders saltados ({})", g_skip.size(), text);
+  }
+  return g_skip;
+}
+}  // namespace swordman_ps
+
+// Tempo de GPU acumulado: out[0] = frames medidos, out[1] = microssegundos (dbz3_perf_logging).
+extern "C" void rex_swordman_gpu_stats(uint64_t* out) {
+  out[0] = swordman_ps::g_gpu_frames.load(std::memory_order_relaxed);
+  out[1] = swordman_ps::g_gpu_us.load(std::memory_order_relaxed);
+}
+
+// Censo: "HASH:draws:pitch:prim" separados por virgula, por ordem de draws; reset = recomeca.
+extern "C" size_t rex_swordman_ps_census(char* buf, size_t size, int reset) {
+  std::vector<std::pair<uint64_t, swordman_ps::CensusEntry>> v;
+  {
+    std::lock_guard<std::mutex> lock(swordman_ps::g_census_mutex);
+    v.assign(swordman_ps::g_census.begin(), swordman_ps::g_census.end());
+    if (reset) swordman_ps::g_census.clear();
+  }
+  std::sort(v.begin(), v.end(),
+            [](const auto& a, const auto& b) { return a.second.draws > b.second.draws; });
+  std::string text;
+  for (const auto& e : v) {
+    if (!text.empty()) text += ',';
+    text += fmt::format("{:016X}:{}:{}:{}", e.first, e.second.draws, e.second.max_pitch,
+                        e.second.prim);
+  }
+  if (buf && size) {
+    const size_t n = std::min(size - 1, text.size());
+    std::memcpy(buf, text.data(), n);
+    buf[n] = 0;
+  }
+  return text.size();
+}
