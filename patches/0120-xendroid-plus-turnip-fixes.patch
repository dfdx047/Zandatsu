+// SwordMan 0120 (XenDroid Plus keys the VkPipelineCache file by the ir3 flags): TU_DEBUG,
+// IR3_DEBUG, IR3_SHADER_DEBUG e FD_DEV_FEATURES mudam o que o Turnip compila mas nao o
+// driverVersion; com o mesmo ficheiro o driver pode devolver binarios feitos com outras flags
+// (resultados de A/B que nao se repetem). Sufixo = hash dessas variaveis ("" se nenhuma).
+std::string SwordManDriverEnvSuffix() {
+  const char* names[] = {"TU_DEBUG", "IR3_DEBUG", "IR3_SHADER_DEBUG", "FD_DEV_FEATURES"};
+  std::string all;
+  for (const char* name : names) {
+    if (const char* value = std::getenv(name)) {
+      all += name;
+      all += '=';
+      all += value;
+      all += ';';
+    }
+  }
+  if (all.empty()) {
+    return std::string();
+  }
+  uint32_t hash = 2166136261u;
+  for (char c : all) {
+    hash = (hash ^ uint8_t(c)) * 16777619u;
+  }
+  REXGPU_INFO("swordman: variaveis do driver {} -> cache de pipelines _{:08X}", all, hash);
+  return fmt::format("_{:08X}", hash);
+}
