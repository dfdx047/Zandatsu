 REXCVAR_DECLARE(double, dbz3_rim_light_scale);  // src/graphics/command_processor.cpp
 
+REXCVAR_DEFINE_BOOL(dbz3_skip_depth_restore, false, "GPU",
+                    "DBZ3-Android: com render targets diretos, salta o restauro da profundidade "
+                    "desenhado como cor na base da profundidade (PS ADCA7FBBCBF53B57)");
 REXCVAR_DEFINE_BOOL(dbz3_clear_to_1x, false, "GPU",
                     "DBZ3-Android: Clear do D3D (retangulo 4x MSAA) desenhado direto na imagem 1x");
 REXCVAR_DEFINE_BOOL(dbz3_skip_msaa_prepass, false, "GPU",
@@ -4321,6 +4324,29 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       return true;
     }
   }
+  // DBZ3-Android (dbz3_skip_depth_restore): depois de cada passe de 512x512 (silhueta do
+  // lutador, pitch 560, que no EDRAM real escreve por cima da zona da profundidade) o jogo
+  // repoe a profundidade desenhando a copia dela como COR na base da profundidade
+  // (color@1328 = depth@1328, PS ADCA7FBBCBF53B57, um draw de cor + um so de profundidade).
+  // Com render targets diretos cada configuracao tem a sua imagem: o passe de 512x512 nunca
+  // tocou na profundidade de 1280x720, e esta cor em color@1328 nao e lida por ninguem.
+  // Saltar os dois draws evita duas mudancas de render target (2 fins de passe) por lutador.
+  if (REXCVAR_GET(dbz3_skip_depth_restore) && REXCVAR_GET(dbz3_rt_direct)) {
+    Shader* restore_ps = active_pixel_shader();
+    if (restore_ps && restore_ps->ucode_data_hash() == UINT64_C(0xADCA7FBBCBF53B57)) {
+      const auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
+      const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+      if (color_info.color_base == depth_info.depth_base) {
+        static uint32_t dbz3_restore_logged = 0;
+        if (dbz3_restore_logged < 4) {
+          ++dbz3_restore_logged;
+          REXGPU_INFO("dbz3: restauro da profundidade via cor (base {}) saltado",
+                      uint32_t(depth_info.depth_base));
+        }
+        return true;
+      }
+    }
+  }
