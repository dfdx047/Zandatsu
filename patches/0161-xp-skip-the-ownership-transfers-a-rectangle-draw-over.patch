+          const uint32_t y1 = rectangle.y_pixels + rectangle.height_pixels;
+          if (rectangle.x_pixels < cutout.x_pixels + cutout.width_pixels &&
+              x1 > cutout.x_pixels && rectangle.y_pixels < cutout.y_pixels + cutout.height_pixels &&
+              y1 > cutout.y_pixels) {
+            any_covered = true;
+          }
+          if (rectangle.x_pixels < cutout.x_pixels || rectangle.y_pixels < cutout.y_pixels ||
+              x1 > cutout.x_pixels + cutout.width_pixels ||
