+                                                    key.msaa_samples, key.Is64bpp(), rectangles);
+                         if (!rectangle_count) {
+                           return false;
+                         }
+                         for (uint32_t j = 0; j < rectangle_count; ++j) {
+                           const Transfer::Rectangle& rectangle = rectangles[j];
