+    if (dbz3_discard::g_sig && REXCVAR_GET(swordman_rit_sig_sampled)) {
+      uint64_t h = dbz3_discard::g_sig;
+      for (uint32_t i = 0; i < dbz3_discard::g_sampled_count; ++i) {
+        h ^= uint64_t(dbz3_discard::g_sampled[i]) * UINT64_C(0x9E3779B97F4A7C15) + (h << 6) + (h >> 2);
+      }
+      dbz3_discard::g_sig = h ? h : 1;
+    }
   }
