@@ -868,6 +868,10 @@ REXCVAR_DEFINE_STRING(swordman_strip_quad_ps, "", "GPU/Vulkan",
                       "Project SwordMan: pixel shaders (hash em hex, separados por virgula) cujos "
                       "triangle strips de 4 vertices sao quads a cobrir o scissor (pos-processamento)")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(swordman_rit_sig_sampled, false, "GPU/Vulkan",
+                    "Project SwordMan (0170): a assinatura do passo 4 inclui as texturas que o quad "
+                    "le (cadeias com o mesmo quad para destinos diferentes, como o brilho do MGR)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
 namespace swordman_strip_quad {
 std::string g_text;
 std::vector<uint64_t> g_hashes;
@@ -6511,6 +6515,16 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       if (dbz3_discard::g_sampled_count < 32) dbz3_discard::g_sampled[dbz3_discard::g_sampled_count++] = a;
       render_target_cache_->Dbz3RitOnSample(*texture_cache_, a);
     });
+    // 0170: a cadeia do brilho do MGR usa o mesmo quad (shaders, alvo, scissor) para destinos
+    // diferentes no mesmo frame; o passo 4 nunca aprendia ("resolve diferente"). As texturas que
