+// DBZ3-Android: driver Vulkan alternativo (por exemplo Turnip/Mesa) carregado
+// com o libadrenotools. A app (MainActivity) copia o .so para a pasta interna e
+// define REX_VULKAN_DRIVER_DIR e REX_VULKAN_DRIVER_NAME; sem essas variaveis usa-se
+// o driver do sistema. Devolve nullptr se nao houver driver alternativo ou se
+// ele falhar a carregar (e entao tambem se usa o do sistema).
+static void* Dbz3OpenCustomVulkanDriver() {
+  const char* driver_dir = std::getenv("REX_VULKAN_DRIVER_DIR");
+  const char* driver_name = std::getenv("REX_VULKAN_DRIVER_NAME");
+  const char* hook_dir = std::getenv("REX_NATIVE_LIB_DIR");
+  if (!driver_dir || !*driver_dir || !driver_name || !*driver_name || !hook_dir || !*hook_dir) {
+    return nullptr;
+  }
+  std::string driver_dir_slash(driver_dir);
+  if (driver_dir_slash.back() != '/') {
+    driver_dir_slash += '/';
+  }
+  std::string hook_dir_slash(hook_dir);
+  if (hook_dir_slash.back() != '/') {
+    hook_dir_slash += '/';
+  }
+  void* handle = adrenotools_open_libvulkan(RTLD_NOW, ADRENOTOOLS_DRIVER_CUSTOM, nullptr,
+                                            hook_dir_slash.c_str(), driver_dir_slash.c_str(),
+                                            driver_name, nullptr, nullptr);
+  const char* error = handle ? nullptr : dlerror();
+  if (handle) {
+    REXLOG_INFO("Vulkan: a usar o driver alternativo {}{}", driver_dir_slash, driver_name);
+  } else {
+    REXLOG_ERROR("Vulkan: o driver alternativo {}{} falhou a carregar ({}); a usar o do sistema",
+                 driver_dir_slash, driver_name, error ? error : "sem detalhe");
+  }
+  return handle;
+}
+#endif
