diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 48d90f6..434ab59 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -7945,6 +7945,26 @@ void VulkanCommandProcessor::UpdateDynamicState(const draw_util::ViewportInfo& v
     scissor_rect.extent.width = right - left;
     scissor_rect.extent.height = bottom - top;
   }
+  // Keep the scissor inside the framebuffer (the render area): rendering
+  // outside it is undefined - a draw rectangle beyond the framebuffer extent
+  // was seen to cause VK_ERROR_DEVICE_LOST on Adreno (XenDroid Plus).
+  if (const VulkanRenderTargetCache::Framebuffer* framebuffer =
+          render_target_cache_->last_update_framebuffer()) {
+    const int64_t fb_width = int64_t(framebuffer->host_extent.width);
+    const int64_t fb_height = int64_t(framebuffer->host_extent.height);
+    const int64_t left = std::clamp(int64_t(scissor_rect.offset.x), int64_t(0), fb_width);
+    const int64_t top = std::clamp(int64_t(scissor_rect.offset.y), int64_t(0), fb_height);
+    const int64_t right =
+        std::clamp(int64_t(scissor_rect.offset.x) + int64_t(scissor_rect.extent.width), left,
+                   fb_width);
+    const int64_t bottom =
+        std::clamp(int64_t(scissor_rect.offset.y) + int64_t(scissor_rect.extent.height), top,
+                   fb_height);
+    scissor_rect.offset.x = int32_t(left);
+    scissor_rect.offset.y = int32_t(top);
+    scissor_rect.extent.width = uint32_t(right - left);
+    scissor_rect.extent.height = uint32_t(bottom - top);
+  }
   SetViewport(viewport);
   SetScissor(scissor_rect);
 
